+	// Keep the element index and format its path only when the string grammar fails.
+	template<class Plain, class Owned, class Append> void read_strings(Plain plain, Owned owned, Append append) {
+		begin_array();
+		auto& scope = frames_.back();
+		std::size_t checkpoint;
+		for (;;) {
+			checkpoint = pos_;
+			skip_whitespace();
+			if (peek() == ']') {
+				++pos_;
+				path_ = scope.path;
+				frames_.pop_back();
+				return;
+			}
+			if (!scope.first) {
+				if (peek() != ',') break;
+				++pos_;
+				skip_whitespace();
+			}
+			if (peek() != '"') break;
+			const auto start = pos_;
+			const auto prefix = parse_string_prefix();
+			if (peek() == '"') {
+				++pos_;
+				append(plain(prefix));
+			} else {
+				try {
+					append(owned(parse_string_tail(start, prefix)));
+				} catch (const reader_detail::json_parse_failure& failure) {
+					failed_ = true;
+					throw read_error(failure, file_, scope.path + "[" + std::to_string(scope.index) + "]");
+				}
+			}
+			scope.first = false;
+			++scope.index;
+		}
+		// Replay unexpected delimiters and value types through the ordinary diagnostic path.
+		pos_ = checkpoint;
+		while (next_element()) append(read_string(plain, owned));
+	}
