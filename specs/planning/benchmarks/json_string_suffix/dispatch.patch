+#ifdef SCPP_JSON_TRY_AVX2
+[[nodiscard]] __attribute__((target("avx2"))) inline std::size_t avx2_string_prefix(std::string_view bytes) noexcept {
+	std::size_t size = 0;
+	while (bytes.size() - size >= 32) {
+		const auto block = _mm256_loadu_si256(reinterpret_cast<const __m256i*>(bytes.data() + size));
+		const auto quote = _mm256_cmpeq_epi8(block, _mm256_set1_epi8(0x22));
+		const auto slash = _mm256_cmpeq_epi8(block, _mm256_set1_epi8(0x5c));
+		const auto controls = _mm256_cmpeq_epi8(_mm256_min_epu8(block, _mm256_set1_epi8(31)), block);
+		const auto mask = static_cast<unsigned>(_mm256_movemask_epi8(_mm256_or_si256(controls, _mm256_or_si256(quote, slash))));
+		if (mask) return size + std::countr_zero(mask);
+		size += 32;
+	}
+	return size + portable_string_prefix(bytes.substr(size));
+}
+#endif
+
+[[nodiscard]] inline std::size_t plain_string_prefix(std::string_view bytes) noexcept {
+#ifdef SCPP_JSON_TRY_AVX2
+	if (bytes.size() >= 32 && __builtin_cpu_supports("avx2")) return avx2_string_prefix(bytes);
+#endif
+	return portable_string_prefix(bytes);
+}
