+[[nodiscard]] inline std::size_t first_block_string_prefix(std::string_view bytes) noexcept {
+#ifdef SCPP_JSON_TRY_AVX2
+	if (bytes.size() >= 16) {
+		const auto block = _mm_loadu_si128(reinterpret_cast<const __m128i*>(bytes.data()));
+		const auto quote = _mm_cmpeq_epi8(block, _mm_set1_epi8('"'));
+		const auto slash = _mm_cmpeq_epi8(block, _mm_set1_epi8('\\'));
+		const auto controls = _mm_cmpeq_epi8(_mm_min_epu8(block, _mm_set1_epi8(31)), block);
+		const auto markers = _mm_or_si128(controls, _mm_or_si128(quote, slash));
+		const auto mask = static_cast<unsigned>(_mm_movemask_epi8(markers));
+		if (mask) return std::countr_zero(mask);
+		return 16 + plain_string_prefix(bytes.substr(16));
+	}
+#endif
+	return portable_string_prefix(bytes);
+}
 #undef SCPP_JSON_TRY_AVX2
 
