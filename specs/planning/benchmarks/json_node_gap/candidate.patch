+// Consume complete groups of valid two- or four-byte encodings.
+inline std::size_t unicode_run(std::string_view text, unsigned width) noexcept {
+	if (width != 2 && width != 4) return 0;
+	const auto low = width == 2 ? _mm_set1_epi16(static_cast<short>(0x80c2)) : _mm_set1_epi32(0x808080f0u);
+	const auto high = width == 2 ? _mm_set1_epi16(static_cast<short>(0xbfdf)) : _mm_set1_epi32(0xbfbfbff4u);
+	std::size_t i = 0;
+	while (text.size() - i >= 16) {
+		const auto b = _mm_loadu_si128(reinterpret_cast<const __m128i*>(text.data() + i));
+		const auto clipped = _mm_min_epu8(high, _mm_max_epu8(low, b));
+		if (_mm_movemask_epi8(_mm_cmpeq_epi8(b, clipped)) != 0xffff) break;
+		if (width == 4) {
+			const auto second = _mm_srli_epi32(b, 8);
+			const auto below90 = _mm_cmpgt_epi8(_mm_set1_epi8(static_cast<char>(0x90)), second);
+			const auto f0 = _mm_cmpeq_epi8(b, _mm_set1_epi8(static_cast<char>(0xf0)));
+			const auto f4 = _mm_cmpeq_epi8(b, _mm_set1_epi8(static_cast<char>(0xf4)));
+			if (_mm_movemask_epi8(_mm_or_si128(_mm_and_si128(f0, below90), _mm_andnot_si128(below90, f4)))) break;
+		}
+		i += 16;
+	}
+	return i;
+}
+#endif
 
