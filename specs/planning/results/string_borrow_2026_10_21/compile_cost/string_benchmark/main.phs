// Compiled by compiler/my-try. The driver substitutes the corpus path only.
function batch(string &$op, string &$s, string &$t, string &$needle, string &$repl, int $count): int {
    $sum int = 0;
    if ($op === "replace") {
        for ($i int = 0; $i < $count; $i++) {
            $sum += strlen(str_replace($needle, $repl, $s));
        }
    } elseif ($op === "compare") {
        for ($i int = 0; $i < $count; $i++) {
            $v int = substr_compare($s, $t, 0);
            if ($v < 0) { $sum += 0; }
            elseif ($v > 0) { $sum += 2; }
            else { $sum += 1; }
        }
    } else {
        for ($i int = 0; $i < $count; $i++) { $sum += strlen($s); }
    }
    return $sum;
}

function read_fixture(string $path): string {
    $value string = "";
    $err error;
    if (!take($value, $err, fs_get($path))) { echo "ERROR: corpus read\n"; }
    return $value;
}
function run_case(string $id, string $op, string $base): void {
    $s string = read_fixture($base . "/s");
    $t string = read_fixture($base . "/t");
    $needle string = read_fixture($base . "/n");
    $repl string = read_fixture($base . "/r");
    $expected string = read_fixture($base . "/expected");
    if ($op === "replace") {
        if (str_replace($needle, $repl, $s) !== $expected) { echo "ERROR: replacement mismatch\n"; }
    } elseif ($op === "compare") {
        $v int = substr_compare($s, $t, 0);
        $sign int = 0;
        if ($v < 0) { $sign = -1; }
        elseif ($v > 0) { $sign = 1; }
        if ($sign !== (int)$expected) { echo "ERROR: comparison mismatch\n"; }
    }
    $count int = 1;
    while (true) {
        $start uint64 = dt_monotonic_ns();
        $warm int = batch($op, $s, $t, $needle, $repl, $count);
        $elapsed int = (int)(dt_monotonic_ns() - $start);
        if ($warm < 0) { echo "ERROR: checksum\n"; }
        if ($elapsed >= 20000000 || $count >= 67108864) { break; }
        $count *= 2;
    }
    for ($trial int = 0; $trial < 7; $trial++) {
        $start uint64 = dt_monotonic_ns();
        $sum int = batch($op, $s, $t, $needle, $repl, $count);
        $elapsed int = (int)(dt_monotonic_ns() - $start);
        echo $id, ",mytry,", $trial, ",", $count, ",", $elapsed, ",", $sum, "\n";
    }
}

run_case("case0","compare","unused");
run_case("case1","compare","unused");
