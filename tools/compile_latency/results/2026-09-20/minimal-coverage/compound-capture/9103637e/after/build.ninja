
rule compile_callable_part
  command = $cxx $cxxflags $app_pchflags -MMD -MF $out.d -MT $out -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CALLABLE_PART $out
cxx = clang++
cxxflags = -std=c++23 -fPIC -O0 -g1 -pipe -I../../../vendor/runtime/include -I../minimal/generated -DSCPP_LANGUAGE_TARGET_PHP=1 -DSCPP_HAS_MYSQLI=0 -DSCPP_HAS_REGEX=0 -DSCPP_HAS_CURL=0 -DSCPP_HAS_TASKS=1 -DSCPP_TASKS_DEFAULT_WORKER_POOL_SIZE=0 -DSCPP_HAS_UI=0 -DSCPP_HAS_WEBVIEW=0 -DSCPP_ENABLE_CALL_DEPTH_GUARD=1 -DSCPP_MAX_CALL_DEPTH=4096
runtime_cxxflags = -std=c++23 -fPIC -O0 -g1 -pipe -I../../../vendor/runtime/include
base_ldflags = -fuse-ld=mold
ldflags = -fuse-ld=mold -Wl,-rpath,/tmp/scpp-edit-latency-20260919/app/.prism/runtime/project/php-strict/69b4808897311cd5
app_pch_header = expanded_runtime_pch.hpp
app_pchflags = -Winvalid-pch -include $app_pch_header

rule compile_pch_app
  command =  $cxx $cxxflags -MD -MF $out.d -MT $out -x c++-header $in -o $out
  depfile = $out.d
  deps = gcc
  description = PCH $out

rule compile
  command =  $cxx $cxxflags $app_pchflags $more_cxxflags -MMD -MF $out.d -MT $out -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CXX $out

rule link
  command =  $cxx $in $ldflags -o $out
  description = LINK $out

build expanded_runtime_pch.hpp.gch: compile_pch_app expanded_runtime_pch.hpp
