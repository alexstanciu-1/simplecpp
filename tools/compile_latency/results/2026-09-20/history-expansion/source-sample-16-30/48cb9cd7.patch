+	public static function local_by_id(FrontendBodySummaryArtifact $artifact, uint32 $localId): FrontendLocalBindingSummaryRow {
+		if ((int)$localId > 0 && (int)$localId <= count($artifact->locals)) {
+			$row FrontendLocalBindingSummaryRow = $artifact->locals[(int)$localId - 1];
+			if ((int)$row->local_id === (int)$localId) {
+				return $row;
+			}
+		}
+		foreach ($artifact->locals as $row) {
+			if ((int)$row->local_id === (int)$localId) {
+				return $row;
+			}
+		}
+		$empty FrontendLocalBindingSummaryRow = [];
+		return $empty;
+	}
