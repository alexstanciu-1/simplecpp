+	assert_output_contains '^fixture_runner_llvm_text_bytes=[1-9][0-9]*$' "v2 focused int64 provider proof should materialize LLVM text"
+	assert_file_contains "$INT64_LL" 'alloca i64, align 8' "v2 focused int64 provider proof missing i64 local storage"
+	assert_file_contains "$INT64_LL" 'store i64 40' "v2 focused int64 provider proof missing i64 initializer store"
+	assert_file_contains "$INT64_LL" 'add i64' "v2 focused int64 provider proof missing i64 binary plus"
+	assert_file_contains "$INT64_LL" 'ret i64' "v2 focused int64 provider proof missing i64 return"
