+
 grep -E '^(fixture_runner_rows|fixture_runner_completed|fixture_runner_blocked|fixture_runner_elapsed_ms|fixture_runner_source_bytes|fixture_runner_tokens|fixture_runner_frontend_nodes|fixture_runner_backend_requests|fixture_runner_lowering_steps|fixture_runner_llvm_text_bytes|fixture_runner_artifact_writes|fixture_runner_reused_writes|fixture_runner_profile_stage=)' "$RUN_OUT"
