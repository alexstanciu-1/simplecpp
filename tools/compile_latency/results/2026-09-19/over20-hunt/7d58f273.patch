+	public static function numeric_operator_mask_has_bit(uint16 $mask, uint16 $bit): bool {
+		$maskValue int = (int)$mask;
+		$bitValue int = (int)$bit;
+		if ($bitValue <= 0) {
+			return false;
+		}
+		$period int = $bitValue * 2;
+		$remainder int = $maskValue % $period;
+		return $remainder >= $bitValue;
+	}
+
+	public static function supports_integer_operator(TypeTraitRow $row, uint16 $operatorBit): bool {
