diff --git a/compiler/src/compile/capabilities/control_flow_cleanup_preflight.phs b/compiler/src/compile/capabilities/control_flow_cleanup_preflight.phs
new file mode 100644
index 00000000..071ad67b
--- /dev/null
+++ b/compiler/src/compile/capabilities/control_flow_cleanup_preflight.phs
@@ -0,0 +1,82 @@
+// Role: Fixture-source preflight rows for cleanup-sensitive control-flow gaps.
+final class control_flow_cleanup_preflight {
+
+	public static function blocked_reason_none_id(): uint16 {
+		return structure_row_ids::none_kind_id();
+	}
+
+	public static function blocked_reason_missing_cleanup_obligation_id(): uint16 {
+		return structure_row_ids::uint16_from_int(1);
+	}
+
+	public static function blocked_reason_path_coverage_blocked_id(): uint16 {
+		return structure_row_ids::uint16_from_int(2);
+	}
+
+	public static function blocked_layer_cleanup_preflight_id(): uint16 {
+		return structure_row_ids::uint16_from_int(2);
+	}
+
+	public static function has_branch(string $source): bool {
+		return str_contains($source, "if (")
+			|| str_contains($source, "if\t")
+			|| str_contains($source, "else");
+	}
+
+	public static function has_loop(string $source): bool {
+		return str_contains($source, "while (")
+			|| str_contains($source, "for (")
+			|| str_contains($source, "do {");
+	}
+
+	public static function source_contains_type_spelling(string $source, string $spelling): bool {
+		return str_contains($source, " " . $spelling)
+			|| str_contains($source, "\t" . $spelling)
+			|| str_contains($source, "<" . $spelling)
+			|| str_contains($source, "," . $spelling)
+			|| str_contains($source, ":" . $spelling);
+	}
+
+	public static function type_ref_requires_cleanup(uint32 $typeRefId): bool {
+		$trait ProviderTraitDescriptorRow = semantic_type_ref_providers::provider_trait_descriptor_by_type_ref_id($typeRefId);
+		return (int)$trait->cleanup_policy_id === (int)type_traits::cleanup_policy_runtime_release_required_id();
+	}
+
+	public static function has_cleanup_bearing_source_value(string $source): bool {
+		foreach (semantic_type_ref_providers::provider_spelling_descriptors() as $spelling) {
+			if (!control_flow_cleanup_preflight::source_contains_type_spelling($source, $spelling->source_name)) {
+				continue;
+			}
+			if (control_flow_cleanup_preflight::type_ref_requires_cleanup($spelling->type_ref_id)) {
+				return true;
+			}
+		}
+		return false;
+	}
+
+	public static function blocked_reason_for_source(string $source): uint16 {
+		if (!control_flow_cleanup_preflight::has_cleanup_bearing_source_value($source)) {
+			return control_flow_cleanup_preflight::blocked_reason_none_id();
+		}
+		if (!control_flow_cleanup_preflight::has_branch($source) && !control_flow_cleanup_preflight::has_loop($source)) {
+			return control_flow_cleanup_preflight::blocked_reason_none_id();
+		}
+		if (control_flow_cleanup_preflight::has_branch($source) && control_flow_cleanup_preflight::has_loop($source)) {
+			return control_flow_cleanup_preflight::blocked_reason_path_coverage_blocked_id();
+		}
+		return control_flow_cleanup_preflight::blocked_reason_missing_cleanup_obligation_id();
+	}
+
+	public static function blocked_reason_for_fixture(PipelineConfig $config): uint16 {
+		$manifest ProjectManifest = project_manifest::from_fixture_dir($config->fixture_dir);
+		foreach ($manifest->source_relative_paths as $relativePath) {
+			$sourcePath string = $config->fixture_dir . "/" . $relativePath;
+			$source string = source_files::content_or_empty($sourcePath);
+			$blockedReasonId uint16 = control_flow_cleanup_preflight::blocked_reason_for_source($source);
+			if ((int)$blockedReasonId !== (int)control_flow_cleanup_preflight::blocked_reason_none_id()) {
+				return $blockedReasonId;
+			}
+		}
+		return control_flow_cleanup_preflight::blocked_reason_none_id();
+	}
+}
