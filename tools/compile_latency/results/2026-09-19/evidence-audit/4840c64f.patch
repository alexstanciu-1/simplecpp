@@ -0,0 +1,56 @@
+// Role: Centralizes shared MT publication-readiness proof counters.
+final class mt_publication_metrics {
+
+	public static function key(string $stageKey, string $metricField): string {
+		return $stageKey . "_" . $metricField;
+	}
+
+	public static function int_counter(int $value): uint32 {
+		return structure_row_ids::uint32_from_int($value);
+	}
+
+	public static function bool_counter(bool $value): uint32 {
+		if ($value) {
+			return structure_row_ids::uint32_from_int(1);
+		}
+		return structure_row_ids::uint32_from_int(0);
+	}
+
+	public static function add_int(FixtureRunReport &$report, string $metricKey, int $value): void {
+		proof_metrics::add_report_counter($report, $metricKey, mt_publication_metrics::int_counter($value));
+	}
+
+	public static function add_bool(FixtureRunReport &$report, string $metricKey, bool $value): void {
+		proof_metrics::add_report_counter($report, $metricKey, mt_publication_metrics::bool_counter($value));
+	}
+
+	public static function record_coordinator_selection(FixtureRunReport &$report, string $stageKey): void {
+		mt_publication_metrics::add_int($report, mt_publication_metrics::key($stageKey, "coordinator_selected"), 1);
+		mt_publication_metrics::add_int($report, mt_publication_metrics::key($stageKey, "worker_selected"), 0);
+	}
+
+	public static function record_worker_gate(
+		FixtureRunReport &$report,
+		string $stageKey,
+		string $blockedField,
+		string $upstreamWorkerReadyField,
+		string $upstreamCoordinatorBlockedField,
+		string $workerCandidateReadyField,
+		string $o3MeasurementRequiredField,
+		string $speedupClaimBlockedField,
+		string $payloadCopyBytesField,
+		bool $hasWorkerCandidate,
+		bool $upstreamWorkerReady,
+		bool $workerCandidateReady
+	): void {
+		$workerBlocked bool = $hasWorkerCandidate && !$upstreamWorkerReady;
+		$upstreamCoordinatorBlocked bool = $hasWorkerCandidate && !$upstreamWorkerReady;
+		mt_publication_metrics::add_bool($report, mt_publication_metrics::key($stageKey, $blockedField), $workerBlocked);
+		mt_publication_metrics::add_bool($report, mt_publication_metrics::key($stageKey, $upstreamWorkerReadyField), $hasWorkerCandidate && $upstreamWorkerReady);
+		mt_publication_metrics::add_bool($report, mt_publication_metrics::key($stageKey, $upstreamCoordinatorBlockedField), $upstreamCoordinatorBlocked);
+		mt_publication_metrics::add_bool($report, mt_publication_metrics::key($stageKey, $workerCandidateReadyField), $workerCandidateReady);
+		mt_publication_metrics::add_bool($report, mt_publication_metrics::key($stageKey, $o3MeasurementRequiredField), $workerCandidateReady);
+		mt_publication_metrics::add_bool($report, mt_publication_metrics::key($stageKey, $speedupClaimBlockedField), $workerCandidateReady);
+		mt_publication_metrics::add_int($report, mt_publication_metrics::key($stageKey, $payloadCopyBytesField), 0);
+	}
+}
