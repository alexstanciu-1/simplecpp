+++ b/compiler/v2/src/compile/backend/llvm_text_from_plan.phs
@@ -442,6 +442,9 @@ final class llvm_text_from_plan {
 		if ((int)$typeRefId === (int)type_refs::bool_id()) {
 			return 1;
 		}
+		if ((int)$typeRefId === (int)type_refs::int16_id()) {
+			return 2;
+		}
 		if ((int)$typeRefId === (int)type_refs::int32_id()) {
 			return 4;
 		}
@@ -453,6 +456,10 @@ final class llvm_text_from_plan {
 			return "  %exit_value = zext i1 %run_value to i32\n"
 				. "  ret i32 %exit_value\n";
 		}
+		if ($returnType === "i16") {
+			return "  %exit_value = sext i16 %run_value to i32\n"
+				. "  ret i32 %exit_value\n";
+		}
 		if ($returnType === "i32") {
 			return "  ret i32 %run_value\n";
 		}
@@ -975,6 +982,9 @@ final class llvm_text_from_plan {
 		if ((int)$typeRefId === (int)type_refs::bool_id()) {
 			return "i1";
 		}
+		if ((int)$typeRefId === (int)type_refs::int16_id()) {
+			return "i16";
+		}
 		if ((int)$typeRefId === (int)type_refs::int32_id()) {
 			return "i32";
 		}
