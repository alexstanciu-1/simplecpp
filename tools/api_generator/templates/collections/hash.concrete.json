{
  "hash_key": "k",
  "writable_iteration": "live_key_cursor",
  "checked_slot": {"method": "checked_slot", "key": "k", "value": "v", "missing": "hash_missing_key"},
  "parameters": {
    "k": {"alias": "key_type", "requires": ["copy_constructible", "nothrow_move_constructible", "nothrow_move_assignable", "nothrow_destructible"]},
    "v": {"alias": "value_type", "requires": ["copy_constructible", "nothrow_move_constructible", "nothrow_move_assignable", "nothrow_destructible"]}
  },
  "fragments": {
    "input_declaration": [
      {"template": "collections/hash_input_entry", "when": "enable_keyed_input"},
      {"template": "collections/initialization_input_guard", "when": "enable_keyed_input"},
      {"template": "collections/hash_factory_declaration", "when": "enable_keyed_input"}
    ],
    "input_definition": [
      {"template": "collections/initialization_input_definition", "when": "enable_keyed_input"},
      {"template": "collections/hash_input_factory", "when": "enable_keyed_input"}
    ],
    "private_declaration": [{"template": "collections/hash_mt_declaration", "when": "mt_segments"}],
    "storage": ["collections/hash_table"],
    "lifecycle": ["core/concrete_owner_lifecycle"],
    "declaration": ["core/lifecycle_declaration", "collections/hash_value_methods_declaration", "collections/hash_key_iteration_declaration", {"template": "collections/hash_shared_lookup_declaration", "when": "enable_shared_lookup"}, {"template": "collections/hash_present_owner_declaration", "when": "enable_owner_presence"}],
    "definition": ["collections/hash_methods_definition", {"template": "collections/hash_mt_definition", "when": "mt_segments"}, "collections/hash_key_iteration", {"template": "collections/hash_shared_lookup_definition", "when": "enable_shared_lookup"}, {"template": "collections/hash_present_owner_definition", "when": "enable_owner_presence"}],
    "output_declaration": ["collections/hash_iteration_output", "core/iteration_output", "collections/hash_output_declaration"],
    "output_definition": ["collections/hash_output_iteration"],
    "append_declaration": [{"template": "collections/hash_append_declaration", "when": "enable_append"}],
    "append_definition": [{"template": "collections/hash_append_definition", "when": "enable_append"}]
  },
  "application": "collections/hash_application",
  "support": ["hash/concrete_index.hpp"],
  "includes": ["new", "stdexcept", "cstring"]
}
