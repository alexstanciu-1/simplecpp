{
  "name": "simple-cpp-vscode",
  "displayName": "Simple C++",
  "description": "VS Code support for PHP++ / PHS and JSS authoring with STAN-powered language features.",
  "version": "0.1.71",
  "publisher": "simple-cpp",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:prism.json",
    "onLanguage:phs",
    "onLanguage:jss",
    "onCommand:simpleCpp.createProject",
    "onCommand:simpleCpp.createJssProject",
    "onCommand:simpleCpp.buildProject",
    "onCommand:simpleCpp.runProject",
    "onCommand:simpleCpp.doctor",
    "onCommand:simpleCpp.docsStrict",
    "onCommand:simpleCpp.docsJss",
    "onCommand:simpleCpp.stan.restartServer",
    "onCommand:simpleCpp.stan.openSmokeFile",
    "onCommand:simpleCpp.debug.inspectLatestSession",
    "onCommand:simpleCpp.debug.inspectAllSlots",
    "onCommand:simpleCpp.debug.openLatestEvents",
    "onCommand:simpleCpp.debug.openLatestPlan",
    "onCommand:simpleCpp.debug.openLatestRewrittenSource",
    "onDebug:simplecpp-debug"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "phs",
        "aliases": [
          "PHP++ (PHS)",
          "phs"
        ],
        "extensions": [
          ".phs"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "jss",
        "aliases": [
          "Simple C++ JSS",
          "JSS",
          "jss"
        ],
        "extensions": [
          ".jss"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "phs",
        "scopeName": "source.phs",
        "path": "./syntaxes/phs.tmLanguage.json"
      },
      {
        "language": "jss",
        "scopeName": "source.jss",
        "path": "./syntaxes/jss.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "phs",
        "path": "./snippets/phs.json"
      },
      {
        "language": "jss",
        "path": "./snippets/jss.json"
      }
    ],
    "breakpoints": [
      {
        "language": "phs"
      },
      {
        "language": "jss"
      }
    ],
    "commands": [
      {
        "command": "simpleCpp.createProject",
        "title": "Simple C++: Create Project"
      },
      {
        "command": "simpleCpp.createJssProject",
        "title": "Simple C++: Create JSS Project"
      },
      {
        "command": "simpleCpp.buildProject",
        "title": "Simple C++: Build Project"
      },
      {
        "command": "simpleCpp.runProject",
        "title": "Simple C++: Run Project"
      },
      {
        "command": "simpleCpp.doctor",
        "title": "Simple C++: Doctor"
      },
      {
        "command": "simpleCpp.docsStrict",
        "title": "Simple C++: Show Strict Docs"
      },
      {
        "command": "simpleCpp.docsJss",
        "title": "Simple C++: Show JSS Docs"
      },
      {
        "command": "simpleCpp.stan.restartServer",
        "title": "Simple C++: Restart STAN Server"
      },
      {
        "command": "simpleCpp.stan.openSmokeFile",
        "title": "Simple C++: Open Smoke File"
      },
      {
        "command": "simpleCpp.debug.inspectLatestSession",
        "title": "Simple C++: Inspect Latest Debug Session"
      },
      {
        "command": "simpleCpp.debug.inspectAllSlots",
        "title": "Simple C++: Inspect Debug Slots"
      }
    ],
    "debuggers": [
      {
        "type": "simplecpp-debug",
        "label": "Simple C++ Debug",
        "languages": [
          "phs",
          "jss"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "projectRoot": {
                "type": "string",
                "description": "Optional explicit project root containing prism.json."
              },
              "buildRuntime": {
                "type": "boolean",
                "default": false
              },
              "buildDependencies": {
                "type": "boolean",
                "default": false
              },
              "call": {
                "type": "string",
                "description": "Optional callable for debug call mode."
              },
              "callArgsJson": {
                "type": "string",
                "default": "[]"
              },
              "callThisJson": {
                "type": "string"
              },
              "exec": {
                "type": "string",
                "description": "Optional expression for debug exec mode."
              },
              "env": {
                "type": "object",
                "default": {}
              },
              "args": {
                "type": "array",
                "default": []
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "simplecpp-debug",
            "request": "launch",
            "name": "Simple C++ Debug"
          }
        ]
      }
    ],
    "configuration": {
      "title": "Simple C++ STAN",
      "properties": {
        "simplecpp.stan.phpBinary": {
          "type": "string",
          "default": "php",
          "description": "PHP binary used to launch the STAN language server."
        },
        "simplecpp.stan.serverScript": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path override for bin/stan_lsp_server.php."
        },
        "simplecpp.stan.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace level for the STAN language client."
        }
      }
    }
  },
  "scripts": {
    "lint:json": "node -e \"for (const file of ['package.json','language-configuration.json','syntaxes/phs.tmLanguage.json','syntaxes/jss.tmLanguage.json','snippets/phs.json','snippets/jss.json']) JSON.parse(require('fs').readFileSync(file,'utf8')); console.log('json ok');\"",
    "test:completion": "node test/static_completion.test.js",
    "check": "npm run lint:json && node -c src/extension.js && node -c src/static_completion.js && node -c src/debug/project_debug_store.js && node -c src/debug/scpp_debug_runner.js && node -c src/debug/debug_commands.js && node -c src/debug/debug_dap.js && npm run test:completion",
    "package:check": "npx @vscode/vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
