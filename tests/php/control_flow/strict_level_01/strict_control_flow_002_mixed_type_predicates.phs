$value mixed = "abc";

echo is_bool($value) ? "bool\n" : "not-bool\n";
echo is_int($value) ? "int\n" : "not-int\n";
echo is_float($value) ? "float\n" : "not-float\n";

$value = true;
echo is_bool($value) ? "bool\n" : "not-bool\n";

$value = 7;
echo is_int($value) ? "int\n" : "not-int\n";

$value = 3.5;
echo is_float($value) ? "float\n" : "not-float\n";
