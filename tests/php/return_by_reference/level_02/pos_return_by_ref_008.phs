// POS-RETREF-008

function &get_inner(array &$root): array
{
	return $root["inner"];
}

function &forward_inner(array &$root): array
{
	return get_inner($root);
}

$x = [];
$x["inner"] = [];
$x["inner"]["id"] = 8;

$inner =& forward_inner($x);
$inner["status"] = "ok-8";

var_dump($x);
var_dump($inner);
