// POS-ARR-019
// Safe positive array case within the documented reduced PHP-array subset.

function bump_slot(int &$slot): void
{
	$slot += 19;
}

$x = [];
$x["id"] = 19;
$x["name"] = "row-19";
$x["inner"] = [];
$x["inner"]["count"] = 38;
$x["inner"]["items"] = [];
$x["inner"]["items"][] = 19;
$x["inner"]["items"][] = 20;

$copy = $x;
$copy["name"] = "copy-19";
$copy["inner"]["count"] = 57;

bump_slot($x["inner"]["count"]);

var_dump($x);
var_dump($copy);
