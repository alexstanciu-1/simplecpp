// POS-ARR-017
// Safe positive array case within the documented reduced PHP-array subset.

function bump_slot(int &$slot): void
{
	$slot += 17;
}

$x = [];
$x["id"] = 17;
$x["name"] = "row-17";
$x["inner"] = [];
$x["inner"]["count"] = 34;
$x["inner"]["items"] = [];
$x["inner"]["items"][] = 17;
$x["inner"]["items"][] = 18;

$copy = $x;
$copy["name"] = "copy-17";
$copy["inner"]["count"] = 51;

bump_slot($x["inner"]["count"]);

var_dump($x);
var_dump($copy);
