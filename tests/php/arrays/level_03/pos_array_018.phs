// POS-ARR-018
// Safe positive array case within the documented reduced PHP-array subset.

function bump_slot(int &$slot): void
{
	$slot += 18;
}

$x = [];
$x["id"] = 18;
$x["name"] = "row-18";
$x["inner"] = [];
$x["inner"]["count"] = 36;
$x["inner"]["items"] = [];
$x["inner"]["items"][] = 18;
$x["inner"]["items"][] = 19;

$copy = $x;
$copy["name"] = "copy-18";
$copy["inner"]["count"] = 54;

bump_slot($x["inner"]["count"]);

var_dump($x);
var_dump($copy);
