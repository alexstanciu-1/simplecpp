// POS-ARR-006
// Safe positive array case within the documented reduced PHP-array subset.

function bump_slot(int &$slot): void
{
	$slot += 6;
}

$x = [];
$x["id"] = 6;
$x["name"] = "row-6";
$x["inner"] = [];
$x["inner"]["count"] = 12;
$x["inner"]["items"] = [];
$x["inner"]["items"][] = 6;
$x["inner"]["items"][] = 7;

$copy = $x;
$copy["name"] = "copy-6";
$copy["inner"]["count"] = 18;

bump_slot($x["inner"]["count"]);

var_dump($x);
var_dump($copy);
