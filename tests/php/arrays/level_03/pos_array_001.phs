// POS-ARR-001
// Safe positive array case within the documented reduced PHP-array subset.

function bump_slot(int &$slot): void
{
	$slot += 1;
}

$x = [];
$x["id"] = 1;
$x["name"] = "row-1";
$x["inner"] = [];
$x["inner"]["count"] = 2;
$x["inner"]["items"] = [];
$x["inner"]["items"][] = 1;
$x["inner"]["items"][] = 2;

$copy = $x;
$copy["name"] = "copy-1";
$copy["inner"]["count"] = 3;

bump_slot($x["inner"]["count"]);

var_dump($x);
var_dump($copy);
