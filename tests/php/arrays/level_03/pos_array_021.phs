// POS-ARR-021
// Safe positive array case within the documented reduced PHP-array subset.

function bump_slot(int &$slot): void
{
	$slot += 21;
}

$x = [];
$x["id"] = 21;
$x["name"] = "row-21";
$x["inner"] = [];
$x["inner"]["count"] = 42;
$x["inner"]["items"] = [];
$x["inner"]["items"][] = 21;
$x["inner"]["items"][] = 22;

$copy = $x;
$copy["name"] = "copy-21";
$copy["inner"]["count"] = 63;

bump_slot($x["inner"]["count"]);

var_dump($x);
var_dump($copy);
