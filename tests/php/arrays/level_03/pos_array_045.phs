// POS-ARR-045
// Safe positive array case within the documented reduced PHP-array subset.

function bump_slot(int &$slot): void
{
	$slot += 45;
}

$x = [];
$x["id"] = 45;
$x["name"] = "row-45";
$x["inner"] = [];
$x["inner"]["count"] = 90;
$x["inner"]["items"] = [];
$x["inner"]["items"][] = 45;
$x["inner"]["items"][] = 46;

$copy = $x;
$copy["name"] = "copy-45";
$copy["inner"]["count"] = 135;

bump_slot($x["inner"]["count"]);

var_dump($x);
var_dump($copy);
