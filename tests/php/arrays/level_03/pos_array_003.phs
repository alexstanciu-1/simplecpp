// POS-ARR-003
// Safe positive array case within the documented reduced PHP-array subset.

function bump_slot(int &$slot): void
{
	$slot += 3;
}

$x = [];
$x["id"] = 3;
$x["name"] = "row-3";
$x["inner"] = [];
$x["inner"]["count"] = 6;
$x["inner"]["items"] = [];
$x["inner"]["items"][] = 3;
$x["inner"]["items"][] = 4;

$copy = $x;
$copy["name"] = "copy-3";
$copy["inner"]["count"] = 9;

bump_slot($x["inner"]["count"]);

var_dump($x);
var_dump($copy);
