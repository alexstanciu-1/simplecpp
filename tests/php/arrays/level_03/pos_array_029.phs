// POS-ARR-029
// Safe positive array case within the documented reduced PHP-array subset.

function bump_slot(int &$slot): void
{
	$slot += 29;
}

$x = [];
$x["id"] = 29;
$x["name"] = "row-29";
$x["inner"] = [];
$x["inner"]["count"] = 58;
$x["inner"]["items"] = [];
$x["inner"]["items"][] = 29;
$x["inner"]["items"][] = 30;

$copy = $x;
$copy["name"] = "copy-29";
$copy["inner"]["count"] = 87;

bump_slot($x["inner"]["count"]);

var_dump($x);
var_dump($copy);
