// POS-ARR-026
// Safe positive array case within the documented reduced PHP-array subset.

function bump_slot(int &$slot): void
{
	$slot += 26;
}

$x = [];
$x["id"] = 26;
$x["name"] = "row-26";
$x["inner"] = [];
$x["inner"]["count"] = 52;
$x["inner"]["items"] = [];
$x["inner"]["items"][] = 26;
$x["inner"]["items"][] = 27;

$copy = $x;
$copy["name"] = "copy-26";
$copy["inner"]["count"] = 78;

bump_slot($x["inner"]["count"]);

var_dump($x);
var_dump($copy);
