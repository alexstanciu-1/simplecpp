// POS-ARR-031
// Safe positive array case within the documented reduced PHP-array subset.

function bump_slot(int &$slot): void
{
	$slot += 31;
}

$x = [];
$x["id"] = 31;
$x["name"] = "row-31";
$x["inner"] = [];
$x["inner"]["count"] = 62;
$x["inner"]["items"] = [];
$x["inner"]["items"][] = 31;
$x["inner"]["items"][] = 32;

$copy = $x;
$copy["name"] = "copy-31";
$copy["inner"]["count"] = 93;

bump_slot($x["inner"]["count"]);

var_dump($x);
var_dump($copy);
