<?php
declare(strict_types=1);

namespace demo\schema;

class storage_property {
	public string $name = "";
}

class model_property {
	public string $name = "";
	public bool $disabled = false;
	public $attached_storage /** storage_property */ = null;
}

namespace demo\app;

use demo\schema\model_property;
use demo\schema\storage_property;

function accepts_nullable(?string $name): string {
	if ($name === null) {
		return "missing";
	}

	return $name;
}

$properties /** hash<model_property> */ = [];

$id = new model_property();
$id->name = "Id";
$properties["id"] = $id;

$title = new model_property();
$title->name = "Title";
$properties["title"] = $title;

$storage = new storage_property();
$storage->name = "Storage";

foreach ($properties as $property_name => $typed_property) {
	echo accepts_nullable($property_name), "\n";
	echo $typed_property->name, "\n";
	$typed_property->disabled = true;
	$typed_property->attached_storage = $storage;
	echo $typed_property->attached_storage->name, "\n";
}

echo $properties["id"]->attached_storage->name, "\n";
echo $properties["title"]->attached_storage->name, "\n";
