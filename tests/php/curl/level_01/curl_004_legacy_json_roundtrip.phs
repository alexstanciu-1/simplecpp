$url = $argv[1];
$ch = curl_init($url . "/echo-json");
$body = "{\"name\":\"alex\",\"count\":2}";

if ($ch === false) {
	echo "INIT_FAIL\n";
} else {
	$headers = [];
	$headers[] = "Content-Type: application/json";
	$headers[] = "Accept: application/json";
	$headers[] = "X-Test: curl-legacy-json";

	echo curl_setopt($ch, CURLOPT_RETURNTRANSFER, true) ? "T\n" : "F\n";
	echo curl_setopt($ch, CURLOPT_POST, true) ? "T\n" : "F\n";
	echo curl_setopt($ch, CURLOPT_POSTFIELDS, $body) ? "T\n" : "F\n";
	echo curl_setopt($ch, CURLOPT_HTTPHEADER, $headers) ? "T\n" : "F\n";

	$out = curl_exec($ch);
	$reply = "";
	if (!take($reply, $out)) {
		echo "EXEC_FAIL\n";
	} else {
		$decoded = json_decode($reply);
		echo curl_getinfo($ch, CURLINFO_RESPONSE_CODE), "\n";
		echo $decoded["ok"], "\n";
		echo $decoded["kind"], "\n";
		echo $decoded["payload"]["name"], "\n";
		echo $decoded["payload"]["count"], "\n";
		echo json_encode($decoded), "\n";
	}

	echo curl_close($ch) ? "T\n" : "F\n";
}
