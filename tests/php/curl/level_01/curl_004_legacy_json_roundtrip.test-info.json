            "stdout": "T\nT\nT\nT\n200\n1\njson\nalex\n2\n{\"ok\":true,\"kind\":\"json\",\"payload\":{\"name\":\"alex\",\"count\":2}}\nT\n",
            "stderr": ""
        }
