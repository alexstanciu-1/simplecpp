$root = "strict_curl_test_root";
$path = $root . "/payload.bin";
$payload /** string */ = "";
$bytes /** int */ = 0;
$real /** string */ = "";
$err /** error */;
$ok /** bool */ = false;
$ch /** curl_handle */;
$resp /** curl_response */;

fs_mkdir($root);

if (!take($payload, $err, str_hex2bin("4100420A"))) {
	echo "HEX_FAIL\n";
} else if (!take($bytes, $err, fs_put($path, $payload))) {
	echo "WRITE_FAIL\n";
} else if (!take($real, $err, fs_realpath($path))) {
	echo "REAL_FAIL\n";
} else if (!take($ch, $err, curl_init("file://" . $real))) {
	echo "INIT_FAIL\n";
} else {
	$headers vector<string> = [];
	$headers[] = "X-Test: curl-surface";

	echo take($ok, $err, curl_setopt($ch, CURLOPT_TIMEOUT, 5)) ? "T\n" : "F\n";
	echo take($ok, $err, curl_setopt($ch, CURLOPT_HTTPHEADER, $headers)) ? "T\n" : "F\n";

	if (!take($resp, $err, curl_exec($ch))) {
		echo "EXEC_FAIL\n";
	} else {
		echo $resp->status_code, "\n";
		echo str_bin2hex($resp->body), "\n";
		echo str_strlen($resp->body), "\n";
	}

	echo take($ok, $err, curl_close($ch)) ? "T\n" : "F\n";
}

fs_remove($path);
fs_rmdir($root);
