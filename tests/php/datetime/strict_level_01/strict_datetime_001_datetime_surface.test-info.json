        "normalize_stderr_newlines": true,
        "trim_final_stdout_newline": false,
        "trim_final_stderr_newline": false,
        "case_sensitive_errors": true
    },
    "expect": {
        "php": {
            "run": false,
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
        },
        "generate": {
            "success": true,
            "error_contains": []
        },
        "compile": {
            "success": true,
            "error_contains": []
        },
        "run": {
            "success": true,
            "exit_code": 0,
            "stdout": "0\n1970-01-01T00:00:00Z\n2024-02-29T12:34:56Z\nbad-date\n",
            "stderr": ""
        }
    },
    "tags": [
        "strict",
        "datetime"
    ],
    "notes": "Strict datetime profile surface maps directly to scpp::dt::* runtime functions.",
    "build": {
        "sanitizers": null
    }
