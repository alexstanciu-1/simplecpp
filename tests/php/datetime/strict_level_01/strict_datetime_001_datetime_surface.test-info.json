{
    "id": "strict_datetime_001_datetime_surface",
    "feature": "datetime",
    "level": "strict_level_01",
    "outcome": "positive",
    "enabled": true,
    "status": "active",
    "php_as_oracle": false,
    "compare": {
        "stdout": "exact",
        "stderr": "exact",
        "generator_error": "substring_all",
        "compile_error": "substring_all",
