{
    "id": "strict_datetime_002_common_format",
    "feature": "datetime",
    "level": "strict_level_01",
    "outcome": "positive",
    "enabled": true,
    "status": "active",
    "php_as_oracle": false,
    "compare": {
        "stdout": "exact",
        "stderr": "exact",
        "generator_error": "substring_all",
        "compile_error": "substring_all",
        "normalize_stdout_newlines": true,
        "normalize_stderr_newlines": true,
        "trim_final_stdout_newline": false,
        "trim_final_stderr_newline": false,
        "case_sensitive_errors": true
    },
    "expect": {
        "php": {
            "run": false,
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
        },
        "generate": {
            "success": true,
            "error_contains": []
        },
        "compile": {
            "success": true,
            "error_contains": []
        },
        "run": {
            "success": true,
            "exit_code": 0,
            "stdout": "2024-02-29 12:34:56\n2024/2/29 12:34:56\nbad-date\n",
            "stderr": ""
        }
    },
    "tags": [
        "strict",
        "datetime"
    ],
    "notes": "Strict datetime common-format helpers support the common Y-m-d H:i:s shape without PHP DateTime object semantics.",
    "build": {
        "sanitizers": null
    }
}
