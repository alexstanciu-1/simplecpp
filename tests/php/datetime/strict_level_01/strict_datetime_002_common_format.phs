$parsed /** int */ = 0;
$err /** error */;
if (!take($parsed, $err, dt_parse("2024-02-29 12:34:56"))) {
	echo "parse-error\n";
}

echo dt_format("Y-m-d H:i:s", $parsed), "\n";
echo dt_format("Y/n/j G:i:s", $parsed), "\n";

if (!take($parsed, $err, dt_parse("2024-02-30 12:34:56"))) {
	echo "bad-date\n";
}
