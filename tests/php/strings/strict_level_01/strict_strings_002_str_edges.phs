echo substr("abcdef", -2), "\n";
echo substr("abcdef", 1, -2), "\n";
echo substr_compare("abcdef", "BC", 1, 2, true), "\n";
echo trim("--hi--", "-"), "\n";
echo ltrim("--hi--", "-"), "\n";
echo rtrim("--hi--", "-"), "\n";
echo implode("|", explode(",", "a,b,c", 2)), "\n";
echo implode("|", explode(",", "a,b,c", -1)), "\n";
echo (strpos("banana", "na", 3) ?? -1), "\n";
echo (strrpos("banana", "na", -3) ?? -1), "\n";
