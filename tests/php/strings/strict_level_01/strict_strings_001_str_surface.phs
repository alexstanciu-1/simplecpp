echo substr("abcdef", 2), "\n";
echo substr("abcdef", 1, 3), "\n";
echo substr_compare("abcdef", "cde", 2), "\n";
echo substr_replace("abcdef", "ZZ", 2, 2), "\n";
echo str_pad("x", 3, "."), "\n";
echo str_replace("bc", "XX", "abcdbc"), "\n";

$parts = explode(",", "a,b,c");
echo implode("-", $parts), "\n";

$decoded /** string */ = "";
take($decoded, hex2bin("4142"));
echo $decoded, "\n";
echo bin2hex("AB"), "\n";
echo number_format(12345), "\n";
echo strlen("hello"), "\n";
echo (strpos("banana", "na") ?? -1), "\n";
echo (strrpos("banana", "na") ?? -1), "\n";
echo (strpos("banana", "zz") ?? -1), "\n";
echo strtolower("AbC"), "\n";
echo strtoupper("AbC"), "\n";
echo lcfirst("Hello"), "\n";
echo ucfirst("hello"), "\n";
echo str_starts_with("hello", "he") ? "Y\n" : "N\n";
echo str_ends_with("hello", "lo") ? "Y\n" : "N\n";
echo str_contains("alpha(beta)", "(") ? "Y\n" : "N\n";
echo str_contains("hello", "") ? "Y\n" : "N\n";
echo str_contains("hello", "zz") ? "Y\n" : "N\n";
echo "[", trim("  hi  "), "]\n";
echo "[", ltrim("  hi  "), "]\n";
echo "[", rtrim("  hi  "), "]\n";
