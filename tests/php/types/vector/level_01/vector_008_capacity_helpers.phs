$items /** vector<int> */ = [];

vector_reserve($items, 8);
echo vector_capacity($items) >= 8 ? "reserved\n" : "not_reserved\n";

$items[] = 1;
$items[] = 2;
vector_clear($items);
echo count($items), "\n";
echo vector_capacity($items) >= 8 ? "kept\n" : "lost\n";

$items[] = 3;
vector_compact($items, 4);
echo count($items), "\n";
echo $items[0], "\n";
echo vector_capacity($items) >= 4 ? "target\n" : "small\n";

$bytes /** vector<byte> */ = [];
vector_reserve($bytes, 2);
$seven /** byte */ = 7;
$eight /** byte */ = 8;
$bytes[] = $seven;
$bytes[] = $eight;
echo vector_capacity($bytes) >= 2 ? "byte_reserved\n" : "byte_lost\n";
echo $bytes[1], "\n";
