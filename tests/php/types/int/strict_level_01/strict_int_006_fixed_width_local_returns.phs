// Strict fixed-width integer local declarations and returns.
function s16(): int16
{
	$value int16 = 12;
	return $value;
}

function s32(): int32
{
	$value int32 = 30;
	return $value;
}

function s64_minus(): int64
{
	$value int64 = 50;
	return $value - 8;
}

echo s16(), "\n";
echo s32(), "\n";
echo s64_minus(), "\n";
