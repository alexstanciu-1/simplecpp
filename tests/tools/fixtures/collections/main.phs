$input vector<int> = [1, 2, 3];
$suffix string = "!";
$mapped = collection_map($input, function (int $value) use ($suffix): string {
	return "x" . $suffix;
});
echo $mapped[0], "\n";
$keep = function (int $value): bool {
	return $value > 1;
};
$filtered = collection_filter($input, $keep);
echo $filtered[0], ":", $filtered[1], "\n";
$fixed fixed_array<int, 2> = [3, 7];
$dense = collection_filter($fixed, $keep);
echo $dense[0], ":", $dense[1], "\n";
$keyed hash<int, int> = [8 => 2, 3 => 1];
$names = collection_map($keyed, function (int $value): string { return "name"; });
foreach ($names as $key => $name) {
	echo $key, ":", $name, "\n";
}
$table mixed = [4 => 1, "04" => 2];
$copy = collection_map($table, function (mixed $value): string { return "boxed"; });
foreach ($copy as $key => $value) {
	echo $key, ":", $value, "\n";
}
$dynamic dynamic = [4 => 1, "04" => 2];
$fresh dynamic = collection_filter($dynamic, function (mixed $value): bool { return true; });
$fresh[4] = 99;
echo $dynamic[4], ":", $fresh[4], "\n";
foreach ($fresh as $key => $value) {
	echo $key, ":", $value, "\n";
}
$hash hash<int> = ["first" => 2, "last" => 1];
$hash_names = collection_map($hash, function (int $value): string { return "hash"; });
echo $hash_names["first"], "\n";
$boxed_hash hash<mixed> = [4 => 1, "04" => 2];
$boxed_names = collection_map($boxed_hash, function (mixed $value): string { return "hash-box"; });
echo $boxed_names["04"], "\n";
// Explicit portable policy names retain distinct carrier constraints.
$sequence vector<int> = [10, 20, 30];
$fixed_policy fixed_array<int, 3> = [10, 20, 30];
$dense_hash hash<int, int> = [0 => 10, 1 => 20, 2 => 30];
$keep_policy = function (int $x): bool { return $x > 10; };
$seq = sequence_filter($sequence, $keep_policy);
foreach ($seq as $k => $v) { echo $k, ":", $v, "\n"; }
$keyed = keyed_filter($dense_hash, $keep_policy);
foreach ($keyed as $k => $v) { echo $k, ":", $v, "\n"; }
$seq_names vector<string> = sequence_map($fixed_policy, function (int $x): string { return "seq"; });
$key_names hash<string, int> = keyed_map($dense_hash, function (int $x): string { return "key"; });
echo $seq_names[0], ":", $key_names[0], "\n";
$all_sequence = sequence_filter($sequence, function (int $x): bool { return true; });
$none_sequence = sequence_filter($fixed_policy, function (int $x): bool { return false; });
$empty_sequence = sequence_map($none_sequence, function (int $x): string { return "never"; });
$all_keyed = keyed_filter($dense_hash, function (int $x): bool { return true; });
$none_keyed = keyed_filter($dense_hash, function (int $x): bool { return false; });
$empty_keyed = keyed_map($none_keyed, function (int $x): string { return "never"; });
echo count($all_sequence), ":", count($empty_sequence), ":", count($all_keyed), ":", count($empty_keyed), "\n";
$policy_table mixed = [4 => 10, "04" => 20];
$policy_box hash<mixed> = [4 => 10, "04" => 20];
$table_keys = keyed_map($policy_table, function (mixed $x): string { return "table"; });
$box_keys = keyed_filter($policy_box, function (mixed $x): bool { return true; });
foreach ($table_keys as $k => $v) { echo $k, ":", $v, "\n"; }
echo count($box_keys), "\n";
$policy_nested vector<string> = sequence_filter(sequence_map($sequence, function (int $x): string { return "nested"; }), function (string $x): bool { return true; });
echo $policy_nested[0], "\n";
