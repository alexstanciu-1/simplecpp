class Root_Base {
	public int $value = 7;
	public function read(): int { return $this->value; }
}
class Root_Error extends Exception {
	public string $message = "";
	public function __construct(string $message) { $this->message = $message; }
	public function getMessage(): string { return $this->message; }
}
interface Root_Contract { public function number(): int; }
