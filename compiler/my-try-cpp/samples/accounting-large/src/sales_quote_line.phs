// A priced sales proposal, before stock or ledger commitment.
// Draft values are mutable. Services retain validated copies, never caller handles.
class SalesQuoteLine {
    public string $id = "";
    public string $quote_id = "";
    public string $customer_id = "";
    public string $item_code = "";
    public string $description = "";
    public string $revenue_account = "";
    public int $quantity = 0;
    public int $unit_price = 0;
    public int $discount_amount = 0;
    public int $tax_amount = 0;
    public int $valid_until_period = 0;
    public int $revision = 0;
    public bool $accepted = false;
    public bool $cancelled = false;

    public function validate(): AccountingCheck {
        if (!DocumentRules::text($this->id, 1, 40)) {
            return accounting_failure("sales_quote_line.id", "id must contain 1..40 printable bytes");
        }
        if (!DocumentRules::text($this->quote_id, 1, 80)) {
            return accounting_failure("sales_quote_line.quote_id", "quote_id must contain 1..80 printable bytes");
        }
        if (!DocumentRules::text($this->customer_id, 1, 80)) {
            return accounting_failure("sales_quote_line.customer_id", "customer_id must contain 1..80 printable bytes");
        }
        if (!DocumentRules::text($this->item_code, 1, 80)) {
            return accounting_failure("sales_quote_line.item_code", "item_code must contain 1..80 printable bytes");
        }
        if (!DocumentRules::text($this->description, 1, 80)) {
            return accounting_failure("sales_quote_line.description", "description must contain 1..80 printable bytes");
        }
        if (!DocumentRules::text($this->revenue_account, 1, 80)) {
            return accounting_failure("sales_quote_line.revenue_account", "revenue_account must contain 1..80 printable bytes");
        }
        if (!DocumentRules::integer($this->quantity, 1, 1000000)) {
            return accounting_failure("sales_quote_line.quantity", "quantity must be in [1, 1000000]");
        }
        if (!DocumentRules::integer($this->unit_price, 0, 1000000)) {
            return accounting_failure("sales_quote_line.unit_price", "unit_price must be in [0, 1000000]");
        }
        if (!DocumentRules::integer($this->discount_amount, 0, 1000000000)) {
            return accounting_failure("sales_quote_line.discount_amount", "discount_amount must be in [0, 1000000000]");
        }
        if (!DocumentRules::integer($this->tax_amount, 0, 1000000000)) {
            return accounting_failure("sales_quote_line.tax_amount", "tax_amount must be in [0, 1000000000]");
        }
        if (!DocumentRules::integer($this->valid_until_period, 1, 1200)) {
            return accounting_failure("sales_quote_line.valid_until_period", "valid_until_period must be in [1, 1200]");
        }
        if (!DocumentRules::integer($this->revision, 1, 1000000)) {
            return accounting_failure("sales_quote_line.revision", "revision must be in [1, 1000000]");
        }
        if ($this->discount_amount > $this->quantity * $this->unit_price) {
            return accounting_failure("sales_quote_line.discount", "Discount exceeds line extension");
        }
        return accounting_success();
    }

    public function gross_amount(): int {
        return $this->quantity * $this->unit_price - $this->discount_amount + $this->tax_amount;
    }

    public function copy(): SalesQuoteLine {
        $snapshot SalesQuoteLine = new SalesQuoteLine();
        $snapshot->id = $this->id;
        $snapshot->quote_id = $this->quote_id;
        $snapshot->customer_id = $this->customer_id;
        $snapshot->item_code = $this->item_code;
        $snapshot->description = $this->description;
        $snapshot->revenue_account = $this->revenue_account;
        $snapshot->quantity = $this->quantity;
        $snapshot->unit_price = $this->unit_price;
        $snapshot->discount_amount = $this->discount_amount;
        $snapshot->tax_amount = $this->tax_amount;
        $snapshot->valid_until_period = $this->valid_until_period;
        $snapshot->revision = $this->revision;
        $snapshot->accepted = $this->accepted;
        $snapshot->cancelled = $this->cancelled;
        return $snapshot;
    }

    public function differences(SalesQuoteLine $other): vector<string> {
        $fields vector<string> = [];
        if ($this->id !== $other->id) { $fields[] = "id"; }
        if ($this->quote_id !== $other->quote_id) { $fields[] = "quote_id"; }
        if ($this->customer_id !== $other->customer_id) { $fields[] = "customer_id"; }
        if ($this->item_code !== $other->item_code) { $fields[] = "item_code"; }
        if ($this->description !== $other->description) { $fields[] = "description"; }
        if ($this->revenue_account !== $other->revenue_account) { $fields[] = "revenue_account"; }
        if ($this->quantity !== $other->quantity) { $fields[] = "quantity"; }
        if ($this->unit_price !== $other->unit_price) { $fields[] = "unit_price"; }
        if ($this->discount_amount !== $other->discount_amount) { $fields[] = "discount_amount"; }
        if ($this->tax_amount !== $other->tax_amount) { $fields[] = "tax_amount"; }
        if ($this->valid_until_period !== $other->valid_until_period) { $fields[] = "valid_until_period"; }
        if ($this->revision !== $other->revision) { $fields[] = "revision"; }
        if ($this->accepted !== $other->accepted) { $fields[] = "accepted"; }
        if ($this->cancelled !== $other->cancelled) { $fields[] = "cancelled"; }
        return $fields;
    }

    public function describe(): string {
        $text string = "SalesQuoteLine\n";
        $text .= "id=" . $this->id . "\n";
        $text .= "quote_id=" . $this->quote_id . "\n";
        $text .= "customer_id=" . $this->customer_id . "\n";
        $text .= "item_code=" . $this->item_code . "\n";
        $text .= "description=" . $this->description . "\n";
        $text .= "revenue_account=" . $this->revenue_account . "\n";
        $text .= "quantity=" . (string)$this->quantity . "\n";
        $text .= "unit_price=" . (string)$this->unit_price . "\n";
        $text .= "discount_amount=" . (string)$this->discount_amount . "\n";
        $text .= "tax_amount=" . (string)$this->tax_amount . "\n";
        $text .= "valid_until_period=" . (string)$this->valid_until_period . "\n";
        $text .= "revision=" . (string)$this->revision . "\n";
        $text .= "accepted=" . DocumentRules::flag($this->accepted) . "\n";
        $text .= "cancelled=" . DocumentRules::flag($this->cancelled) . "\n";
        return $text;
    }
}
