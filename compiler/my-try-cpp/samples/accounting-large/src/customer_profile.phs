// Credit admission and settlement preferences for one customer.
// Draft values are mutable. Services retain validated copies, never caller handles.
class CustomerProfile {
    public string $id = "";
    public string $legal_name = "";
    public string $control_account = "";
    public string $currency = "";
    public string $collector = "";
    public string $payment_reference = "";
    public int $credit_limit = 0;
    public int $exposure = 0;
    public int $term_days = 0;
    public int $grace_days = 0;
    public int $discount_basis_points = 0;
    public int $statement_day = 0;
    public bool $active = false;
    public bool $on_hold = false;

    public function validate(): AccountingCheck {
        if (!DocumentRules::text($this->id, 1, 40)) {
            return accounting_failure("customer_profile.id", "id must contain 1..40 printable bytes");
        }
        if (!DocumentRules::text($this->legal_name, 1, 80)) {
            return accounting_failure("customer_profile.legal_name", "legal_name must contain 1..80 printable bytes");
        }
        if (!DocumentRules::text($this->control_account, 1, 80)) {
            return accounting_failure("customer_profile.control_account", "control_account must contain 1..80 printable bytes");
        }
        if (!DocumentRules::text($this->currency, 1, 3)) {
            return accounting_failure("customer_profile.currency", "currency must contain 1..3 printable bytes");
        }
        if (!DocumentRules::text($this->collector, 1, 80)) {
            return accounting_failure("customer_profile.collector", "collector must contain 1..80 printable bytes");
        }
        if (!DocumentRules::text($this->payment_reference, 1, 80)) {
            return accounting_failure("customer_profile.payment_reference", "payment_reference must contain 1..80 printable bytes");
        }
        if (!DocumentRules::integer($this->credit_limit, 0, 1000000000)) {
            return accounting_failure("customer_profile.credit_limit", "credit_limit must be in [0, 1000000000]");
        }
        if (!DocumentRules::integer($this->exposure, 0, 1000000000)) {
            return accounting_failure("customer_profile.exposure", "exposure must be in [0, 1000000000]");
        }
        if (!DocumentRules::integer($this->term_days, 0, 365)) {
            return accounting_failure("customer_profile.term_days", "term_days must be in [0, 365]");
        }
        if (!DocumentRules::integer($this->grace_days, 0, 90)) {
            return accounting_failure("customer_profile.grace_days", "grace_days must be in [0, 90]");
        }
        if (!DocumentRules::integer($this->discount_basis_points, 0, 10000)) {
            return accounting_failure("customer_profile.discount_basis_points", "discount_basis_points must be in [0, 10000]");
        }
        if (!DocumentRules::integer($this->statement_day, 1, 28)) {
            return accounting_failure("customer_profile.statement_day", "statement_day must be in [1, 28]");
        }
        if ($this->exposure > $this->credit_limit) {
            return accounting_failure("customer_profile.credit", "Exposure exceeds the admitted credit line");
        }
        return accounting_success();
    }

    public function available_credit(): int {
        return $this->credit_limit - $this->exposure;
    }

    public function copy(): CustomerProfile {
        $snapshot CustomerProfile = new CustomerProfile();
        $snapshot->id = $this->id;
        $snapshot->legal_name = $this->legal_name;
        $snapshot->control_account = $this->control_account;
        $snapshot->currency = $this->currency;
        $snapshot->collector = $this->collector;
        $snapshot->payment_reference = $this->payment_reference;
        $snapshot->credit_limit = $this->credit_limit;
        $snapshot->exposure = $this->exposure;
        $snapshot->term_days = $this->term_days;
        $snapshot->grace_days = $this->grace_days;
        $snapshot->discount_basis_points = $this->discount_basis_points;
        $snapshot->statement_day = $this->statement_day;
        $snapshot->active = $this->active;
        $snapshot->on_hold = $this->on_hold;
        return $snapshot;
    }

    public function differences(CustomerProfile $other): vector<string> {
        $fields vector<string> = [];
        if ($this->id !== $other->id) { $fields[] = "id"; }
        if ($this->legal_name !== $other->legal_name) { $fields[] = "legal_name"; }
        if ($this->control_account !== $other->control_account) { $fields[] = "control_account"; }
        if ($this->currency !== $other->currency) { $fields[] = "currency"; }
        if ($this->collector !== $other->collector) { $fields[] = "collector"; }
        if ($this->payment_reference !== $other->payment_reference) { $fields[] = "payment_reference"; }
        if ($this->credit_limit !== $other->credit_limit) { $fields[] = "credit_limit"; }
        if ($this->exposure !== $other->exposure) { $fields[] = "exposure"; }
        if ($this->term_days !== $other->term_days) { $fields[] = "term_days"; }
        if ($this->grace_days !== $other->grace_days) { $fields[] = "grace_days"; }
        if ($this->discount_basis_points !== $other->discount_basis_points) { $fields[] = "discount_basis_points"; }
        if ($this->statement_day !== $other->statement_day) { $fields[] = "statement_day"; }
        if ($this->active !== $other->active) { $fields[] = "active"; }
        if ($this->on_hold !== $other->on_hold) { $fields[] = "on_hold"; }
        return $fields;
    }

    public function describe(): string {
        $text string = "CustomerProfile\n";
        $text .= "id=" . $this->id . "\n";
        $text .= "legal_name=" . $this->legal_name . "\n";
        $text .= "control_account=" . $this->control_account . "\n";
        $text .= "currency=" . $this->currency . "\n";
        $text .= "collector=" . $this->collector . "\n";
        $text .= "payment_reference=" . $this->payment_reference . "\n";
        $text .= "credit_limit=" . (string)$this->credit_limit . "\n";
        $text .= "exposure=" . (string)$this->exposure . "\n";
        $text .= "term_days=" . (string)$this->term_days . "\n";
        $text .= "grace_days=" . (string)$this->grace_days . "\n";
        $text .= "discount_basis_points=" . (string)$this->discount_basis_points . "\n";
        $text .= "statement_day=" . (string)$this->statement_day . "\n";
        $text .= "active=" . DocumentRules::flag($this->active) . "\n";
        $text .= "on_hold=" . DocumentRules::flag($this->on_hold) . "\n";
        return $text;
    }
}
