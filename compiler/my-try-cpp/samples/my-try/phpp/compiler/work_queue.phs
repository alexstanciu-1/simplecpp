namespace scpp\compiler;

/** Compiler-owned work membership; the task executor owns bounded dispatch and joining. */
final class Source_Work_Queue {
	private $pending vector<source_work> = [];
	private bool $sealed = false;
	private $sources hash<bool, source_record>;

	public function __construct() {
		$sources hash<bool, source_record> = new hash<bool, source_record>();
		$this->sources = $sources;
	}

	/** Add an input snapshot before dispatch seals queue membership. */
	public function enqueue(source_record $record, file $source, nullable<token_list> $tokens = null): void {
		if ($this->sealed) {
			throw new \scpp_portability_logic_exception('Work membership is sealed');
		}
		if (isset($this->sources[$record])) {
			throw new \scpp_portability_logic_exception('A source record cannot have concurrent work orders');
		}
		if ($tokens !== null) {
			$snapshot token_list = $tokens;
			if ($snapshot->file !== $source) {
				throw new \scpp_portability_logic_exception('Token snapshot belongs to another source');
			}
		}
		$this->sources[$record] = true;
		$work = new source_work($source, $record, count($this->pending));
		$work->previous = $record->parsed;
		$work->tokens = $tokens;
		$this->pending[] = $work;
	}

	public function items(): vector<source_work> {
		$this->sealed = true;
		return $this->pending;
	}

	/** Each dispatched item has a single worker; membership stays frozen during execution. */
	public function start(source_work $work): void {
		if (!$this->sealed) {
			throw new \scpp_portability_logic_exception('Seal work membership before dispatch');
		}
		$this->require_state($work, work_state::queued);
		$work->state = work_state::running;
	}

	public function complete(source_work $work): void {
		$this->require_state($work, work_state::running);
		$work->state = work_state::published;
	}

	public function fail(source_work $work): void {
		$this->require_state($work, work_state::running);
		$work->state = work_state::failed;
	}

	/** Reject foreign or repeated completion without changing queue state. */
	private function require_state(source_work $work, work_state $expected): void {
		if (($work->position < 0) || ($work->position >= count($this->pending))) {
			throw new \scpp_portability_logic_exception('Foreign work order');
		}
		if (($this->pending[$work->position] !== $work) || ($work->state !== $expected)) {
			throw new \scpp_portability_logic_exception('Unexpected work order state or ownership');
		}
	}

	/** Called only after the executor has joined all workers. */
	public function finished(): bool {
		foreach ($this->pending  as $work) {
			if ($work->state !== work_state::published) {
				return false;
			}
		}
		return true;
	}
}
