
/* Select explicit conversions whose requested result is canonical floating point. */
namespace scpp\compiler;

final class Floating_Point_Conversions {
	public static function decide(canonical_type_use $source, canonical_type_use $target, conversion_context $context): conversion_decision {
		if (($context === conversion_context::operator_operand)
			&& $source->matches(Language_Types::integer(Model::$language_scope))
			&& $target->matches(Language_Types::floating(Model::$language_scope))) {
			return Conversion_Preparation::operation(
				$source, $target, $context, conversion_operation::integer_to_floating);
		}
		if (($context === conversion_context::explicit_cast)
			&& Conversion_Preparation::is_scalar($source)) {
			return Conversion_Preparation::operation(
				$source, $target, $context, conversion_operation::explicit_runtime_cast);
		}

		if ($context !== conversion_context::explicit_cast) {
			throw new \scpp_portability_runtime_exception('S2S value boundary requires matching types or an integer conversion');
		}
		throw new \scpp_portability_runtime_exception('S2S explicit floating-point cast is not supported for this source type');
	}
}
