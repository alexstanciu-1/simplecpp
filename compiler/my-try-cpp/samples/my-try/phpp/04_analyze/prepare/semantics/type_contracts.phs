
/* Post-layout contracts: signatures never depend back on these obligations. */
namespace scpp\compiler;

final class Type_Contract_Preparation {
	public static function prepare(collected_member_owner $record, preparation_context $context): prepared_type_contract {
		$is_interface = $record instanceof collected_interface;
		if (!$is_interface) { $context->worker->require_declaration($context->owner, $record); }
		else { self::interface_shape($record->syntax()); }
		$relations = $context->worker->require_relationships($record, $context);
		$facts = new prepared_type_contract();
		$facts->abstract_type = $is_interface || $relations->abstract_type;
		$facts->polymorphic = $is_interface || $relations->exception_type || $relations->typed_iterator || (count($relations->interfaces) !== 0);
		$base = lock($relations->base);
		$base_contract nullable<prepared_type_contract> = null;
		$pending vector<collected_method> = [];
		if ($base !== null) {
			$base_contract = $context->worker->require_type_contract($base, $context);
			$facts->polymorphic = $facts->polymorphic || $base_contract->polymorphic;
			$pending = $base_contract->obligations;
			$facts->interface_requirements = $base_contract->interface_requirements;
			$facts->trait_requirements = $base_contract->trait_requirements;
		}
		foreach ($relations->interfaces  as $interface) {
			$interface_contract = $context->worker->require_type_contract($interface, $context);
			foreach ($interface_contract->interface_requirements  as $requirement) {
				self::add_requirement($facts, $requirement, $context);
			}
		}
		// Direct signature dependencies matter even when the original requirement identities stay unchanged.
		foreach ($facts->interface_requirements  as $requirement) { Call_Preparation::require_signature($requirement, $context); }
		$methods Storage<method_node> = Member_Inventory::methods($record);
		$decisions Keyed_Storage<prepared_method_contract> = $facts->methods;
		foreach ($methods  as $syntax) {
			if (isset($decisions[$syntax->name])) { throw new \scpp_portability_runtime_exception('Duplicate method: ' . $syntax->name); }
			$method = object_cast($syntax->occurrence(), collected_method::class);
			Call_Preparation::require_signature($method, $context);
			$signature = $syntax->require_preparation();
			$decision = new prepared_method_contract();
			$decision->dispatch_owner = weak($record);
			$decision->method = weak($method);
			$decision->abstract_method = $signature->abstract_method;
			$decision->final_method = $signature->final_method;
			$decision->virtual_method = $signature->abstract_method || $signature->explicit_virtual
				|| ($relations->typed_iterator && Iterator_Preparation::method_name($syntax->name));
			if ($signature->abstract_method && !$facts->abstract_type) {
				throw new \scpp_portability_runtime_exception('Abstract method requires an abstract declaring type');
			}
			$matches vector<inherited_member_candidate> = [];
			if (($base !== null) && ($syntax->name !== '__construct') && ($syntax->name !== '__destruct')) {
				$matches = Inherited_Lookup::members($base, $syntax->name, preparation_lookup_kind::method_name, $context);
			}
			if ($signature->explicit_virtual) {
				if (count($matches) !== 0) { throw new \scpp_portability_runtime_exception('Virtual starts a new slot; use Override for inherited methods'); }
				foreach ($facts->interface_requirements  as $requirement) {
					if ($requirement->name === $syntax->name) { throw new \scpp_portability_runtime_exception('Virtual starts a new slot; interface methods already establish a contract'); }
				}
			}
			if (count($matches) !== 0) {
				if (count($matches) !== 1) { throw new \scpp_portability_runtime_exception('Ambiguous inherited method contract'); }
				$parent = object_cast($matches[0]->member, collected_method::class);
				Call_Preparation::require_signature($parent, $context);
				$inherited = self::effective_method($base, $parent->name, $context);
				if ($inherited->final_method) { throw new \scpp_portability_runtime_exception('Cannot override a final method'); }
				$parent_signature = $parent->callable_syntax()->require_preparation();
				$static_redeclaration = $signature->static_member && $parent_signature->static_member;
				if (!$static_redeclaration && !$inherited->virtual_method) {
					throw new \scpp_portability_runtime_exception('Nonvirtual inherited member redeclaration is deferred');
				}
				$relationship_query nullable<conversion_relationship_query> = null;
				if (!$static_redeclaration) { $relationship_query = new Conversion_Relationships($context); }
				$adaptation = Callable_Adaptation::between($parent_signature->signature, $signature->signature, $relationship_query);
				if (($signature->static_member !== $parent_signature->static_member) || ($adaptation === null)) {
					if ($static_redeclaration) {
						throw new \scpp_portability_runtime_exception('Static redeclaration requires an exact compatible signature');
					}
					throw new \scpp_portability_runtime_exception('Override requires a compatible instance signature');
				}
				if ((($signature->visibility === member_visibility::private_access) && ($parent_signature->visibility !== member_visibility::private_access))
					|| (($parent_signature->visibility === member_visibility::public_access) && ($signature->visibility !== member_visibility::public_access))) {
					throw new \scpp_portability_runtime_exception('Override cannot narrow visibility');
				}
				if (!$static_redeclaration) {
					$decision->overridden = weak($parent);
					$decision->virtual_method = true;
					self::bind($facts, $parent, lock($inherited->dispatch_owner), $method, $record, $adaptation);
				}
			}
			if ($is_interface) {
				foreach ($facts->interface_requirements  as $ancestor_requirement) {
					if ($ancestor_requirement->name !== $method->name) { continue; }
					if (Callable_Adaptation::between($ancestor_requirement->signature(), $method->signature(), new Conversion_Relationships($context)) === null) {
						throw new \scpp_portability_runtime_exception('Incompatible same-named interface contracts: redeclaration must satisfy inherited signatures');
					}
				}
				self::add_requirement($facts, $method, $context);
			}
			if ($decision->virtual_method) { $facts->polymorphic = true; }
			$decisions->add($syntax->name, $decision);
		}
		$forwarders Keyed_Storage<prepared_method_contract> = $facts->forwarders;
		foreach (Member_Inventory::requirements($record)  as $requirement) { $facts->trait_requirements[] = $requirement; }
		foreach ($facts->trait_requirements  as $requirement) {
			Call_Preparation::require_signature($requirement, $context);
			$required = $requirement->callable_syntax()->require_preparation();
			$matches = Inherited_Lookup::members($record, $requirement->name, preparation_lookup_kind::method_name, $context);
			if (count($matches) !== 1) { throw new \scpp_portability_runtime_exception('Trait requirement needs one instance method'); }
			$implementation = object_cast($matches[0]->member, collected_method::class);
			Call_Preparation::require_signature($implementation, $context);
			$provided = $implementation->callable_syntax()->require_preparation();
			$adaptation = Callable_Adaptation::between($required->signature, $provided->signature, new Conversion_Relationships($context));
			if ($provided->static_member || ($adaptation === null)
				|| ($provided->visibility === member_visibility::private_access)
				|| (($required->visibility === member_visibility::public_access) && ($provided->visibility !== member_visibility::public_access))) {
				throw new \scpp_portability_runtime_exception('Trait requirement needs a compatible instance signature and visibility');
			}
			self::bind($facts, $requirement, $requirement->declaring_type(), $implementation, $implementation->declaring_type(), $adaptation, false);
			if ($provided->abstract_method && !isset($decisions[$requirement->name])) {
				if ($implementation->declaring_type() === $record) {
					$slot = new prepared_method_contract();
					$slot->dispatch_owner = weak($record);
					$slot->method = weak($implementation);
					$slot->abstract_method = true;
					$slot->virtual_method = true;
					$decisions->add($requirement->name, $slot);
					$facts->polymorphic = true;
				}
			}
		}
		if (!$is_interface) {
			foreach ($facts->interface_requirements  as $requirement) {
				$matches = Inherited_Lookup::members($record, $requirement->name, preparation_lookup_kind::method_name, $context);
				if (count($matches) === 0) { $facts->obligations[] = $requirement; continue; }
				if (count($matches) !== 1) { throw new \scpp_portability_runtime_exception('Ambiguous interface implementation'); }
				$implementation = object_cast($matches[0]->member, collected_method::class);
				Call_Preparation::require_signature($implementation, $context);
				$signature = $implementation->callable_syntax()->require_preparation();
				$adaptation = Callable_Adaptation::between($requirement->signature(), $signature->signature, new Conversion_Relationships($context));
				if ($signature->static_member || ($signature->visibility !== member_visibility::public_access) || ($adaptation === null)) {
					throw new \scpp_portability_runtime_exception('Interface implementation requires a compatible public instance signature');
				}
				if (isset($decisions[$requirement->name])) {
					$decisions[$requirement->name]->virtual_method = true;
					self::bind($facts, $requirement, $requirement->declaring_type(), $implementation, $record, $adaptation);
				}
				elseif (!$signature->abstract_method) {
					$needs_forwarder = true;
					if ($base !== null) {
						foreach ($base_contract->interface_requirements  as $previous) {
							if ($previous === $requirement) { $needs_forwarder = false; }
						}
					}
					if (!$needs_forwarder) { continue; }
					$inherited = self::effective_method($base, $implementation->name, $context);
					if (!isset($forwarders[$requirement->name])) {
						$bridge = new prepared_method_contract();
						$bridge->dispatch_owner = weak($record);
						$bridge->method = weak($implementation);
						$bridge->virtual_method = true;
						$bridge->final_method = $signature->final_method;
						$forwarders->add($implementation->name, $bridge);
						// Final slots keep their inherited implementation. The descendant entry
						// has its own final slot; it must not override the ancestor's final slot.
						if ($inherited->virtual_method && !$inherited->final_method) {
							$identity = Callable_Adaptation::between($implementation->signature(), $implementation->signature());
							self::bind($facts, $implementation, lock($inherited->dispatch_owner), $implementation, $record, $identity);
						}
					}
					$dispatch_owner = $record;
					if ($inherited->virtual_method && $inherited->final_method) { $dispatch_owner = lock($inherited->dispatch_owner); }
					self::bind($facts, $requirement, $requirement->declaring_type(), $implementation, $dispatch_owner, $adaptation);
				}
			}
		}
		foreach ($pending  as $obligation) {
			if (!isset($decisions[$obligation->name])) { $facts->obligations[] = $obligation; }
		}
		foreach ($decisions  as $decision) {
			if ($decision->abstract_method) { $facts->obligations[] = lock($decision->method); }
			$method = lock($decision->method);
			if ($method->callable_syntax()->require_preparation()->override_assertion) {
				$has_target = lock($decision->overridden) !== null;
				foreach ($facts->interface_requirements  as $requirement) {
					if (($requirement !== $method) && ($requirement->name === $method->name)) { $has_target = true; }
				}
				if (!$has_target) { throw new \scpp_portability_runtime_exception('Override assertion requires an inherited virtual method'); }
			}
		}
		if (!$facts->abstract_type && (count($facts->obligations) !== 0)) {
			throw new \scpp_portability_runtime_exception('Concrete type has unimplemented abstract methods');
		}
		if ($relations->typed_iterator) { $facts->iterator_protocol = Iterator_Preparation::protocol($record, $context); }
		return $facts;
	}

	private static function interface_shape(type_declaration_node $syntax): void {
		$properties Storage<property_node> = $syntax->properties;
		$constants Storage<member_constant_node> = $syntax->constants;
		$traits Storage<trait_use_node> = $syntax->use_traits;
		if (!$properties->is_empty() || !$constants->is_empty() || !$traits->is_empty()
			|| (count($syntax->modifiers) !== 0)) {
			throw new \scpp_portability_runtime_exception('Interface slice supports public method contracts only');
		}
	}

	private static function bind(prepared_type_contract $facts, collected_method $required, collected_member_owner $required_owner, collected_method $implementation, collected_member_owner $implementation_owner, prepared_callable_adaptation $adaptation, bool $virtual_dispatch = true): void {
		$bindings Storage<prepared_dispatch_binding> = $facts->bindings;
		foreach ($bindings  as $existing) {
			if ((lock($existing->required) === $required) && (lock($existing->required_owner) === $required_owner)) { return; }
		}
		$binding = new prepared_dispatch_binding();
		$binding->required = weak($required);
		$binding->required_owner = weak($required_owner);
		$binding->implementation = weak($implementation);
		$binding->implementation_owner = weak($implementation_owner);
		$binding->adaptation = $adaptation;
		$binding->virtual_dispatch = $virtual_dispatch;
		$bindings->append($binding);
	}

	/** Requirements observe original identities, deduplicating diamonds without copying signatures. */
	private static function add_requirement(prepared_type_contract $facts, collected_method $method, preparation_context $context): void {
		Call_Preparation::require_signature($method, $context);
		foreach ($facts->interface_requirements  as $previous) {
			if ($previous === $method) { return; }
			if ($previous->name === $method->name) {
				Call_Preparation::require_signature($previous, $context);
				$query = new Conversion_Relationships($context);
				if (Callable_Adaptation::between($previous->signature(), $method->signature(), $query) === null) {
					if (Callable_Adaptation::between($method->signature(), $previous->signature(), $query) === null) {
						throw new \scpp_portability_runtime_exception('Incompatible same-named interface contracts');
					}
				}
			}
		}
		$facts->interface_requirements[] = $method;
	}

	/** An inherited bridge is virtual in its owning descendant, without changing the original method. */
	private static function effective_method(collected_member_owner $owner, string $name, preparation_context $context): prepared_method_contract {
		$contracts = $context->worker->require_type_contract($owner, $context);
		$methods Keyed_Storage<prepared_method_contract> = $contracts->methods;
		$bridges Keyed_Storage<prepared_method_contract> = $contracts->forwarders;
		if (isset($methods[$name])) { return $methods[$name]; }
		if (isset($bridges[$name])) { return $bridges[$name]; }
		$base = lock($context->worker->require_relationships($owner, $context)->base);
		if ($base === null) { throw new \scpp_portability_logic_exception('Missing inherited method contract'); }
		return self::effective_method($base, $name, $context);
	}

	public static function same(nullable<prepared_type_contract> $old, prepared_type_contract $current): bool {
		if ($old !== null) {
			if (!Iterator_Preparation::same($old->iterator_protocol, $current->iterator_protocol)) { return false; }
		}
		if ($old === null) { return false; }
		if (($old->abstract_type !== $current->abstract_type) || ($old->polymorphic !== $current->polymorphic)) { return false; }
		$old_bindings Storage<prepared_dispatch_binding> = $old->bindings;
		$new_bindings Storage<prepared_dispatch_binding> = $current->bindings;
		if ($old_bindings->count() !== $new_bindings->count()) { return false; }
		foreach ($new_bindings  as $index => $binding) {
			$previous_binding = $old_bindings[$index];
			if ((lock($previous_binding->required) !== lock($binding->required))
				|| (lock($previous_binding->required_owner) !== lock($binding->required_owner))
				|| (lock($previous_binding->implementation) !== lock($binding->implementation))
				|| (lock($previous_binding->implementation_owner) !== lock($binding->implementation_owner))
				|| ($previous_binding->virtual_dispatch !== $binding->virtual_dispatch)
				|| !Callable_Adaptation::same($previous_binding->adaptation, $binding->adaptation)) { return false; }
		}
		if (count($old->interface_requirements) !== count($current->interface_requirements)) { return false; }
		if (count($old->trait_requirements) !== count($current->trait_requirements)) { return false; }
		foreach ($old->trait_requirements  as $index => $method) {
			if ($method !== $current->trait_requirements[$index]) { return false; }
		}
		foreach ($old->interface_requirements  as $index => $method) {
			if ($method !== $current->interface_requirements[$index]) { return false; }
		}
		$old_bridges Keyed_Storage<prepared_method_contract> = $old->forwarders;
		$new_bridges Keyed_Storage<prepared_method_contract> = $current->forwarders;
		if ($old_bridges->count() !== $new_bridges->count()) { return false; }
		foreach ($new_bridges  as $name => $bridge) {
			if (!isset($old_bridges[$name])) { return false; }
			$previous = $old_bridges[$name];
			if ((lock($previous->method) !== lock($bridge->method))
				|| (lock($previous->dispatch_owner) !== lock($bridge->dispatch_owner))
				|| ($previous->final_method !== $bridge->final_method)) { return false; }
		}
		$before Keyed_Storage<prepared_method_contract> = $old->methods;
		$after Keyed_Storage<prepared_method_contract> = $current->methods;
		if (($before->count() !== $after->count()) || (count($old->obligations) !== count($current->obligations))) { return false; }
		foreach ($after  as $name => $method) {
			if (!isset($before[$name])) { return false; }
			$previous = $before[$name];
			if ((lock($previous->method) !== lock($method->method))
				|| (lock($previous->dispatch_owner) !== lock($method->dispatch_owner))
				|| (lock($previous->overridden) !== lock($method->overridden))
				|| ($previous->virtual_method !== $method->virtual_method)
				|| ($previous->abstract_method !== $method->abstract_method)
				|| ($previous->final_method !== $method->final_method)) { return false; }
		}
		foreach ($old->obligations  as $index => $method) { if ($method !== $current->obligations[$index]) { return false; } }
		return true;
	}
}
