namespace scpp\compiler;

/** Read the first Make dependency rule emitted by Clang/GNU ld, not arbitrary Make code. */
final class Native_Depfiles {
	public static function paths(string $text, string $directory): vector<string> {
		$result vector<string> = [];
		$seen hash<bool> = [];
		$word = '';
		$dependencies = false;
		// Clang wraps its Make rule into physical lines. Scan those bounded strings
		// so value-argument transport never copies the complete rule per byte.
		$lines vector<string> = explode("\n", $text);
		$line_count = count($lines);
		$line_index = 0;
		$finished = false;
		foreach ($lines  as $line) {
			$line_index++;
			if ($line_index < $line_count) { $line .= "\n"; }
			$length = string_byte_len($line);
			for ($index = 0; $index < $length; $index++)
			{
				$byte = string_byte_at($line, $index);
				if ($byte === 92) {
					$index++;
					if ($index >= $length) { throw new \scpp_portability_runtime_exception('Incomplete dependency escape'); }
					$escaped = string_byte_at($line, $index);
					if ($escaped === 10) { continue; }
					$word .= \scpp_portability_byte_from_int($escaped);
					continue;
				}
				if ($byte === 36) {
					$index++;
					if ($index >= $length) { throw new \scpp_portability_runtime_exception('Incomplete dependency dollar'); }
					if (string_byte_at($line, $index) !== 36) { throw new \scpp_portability_runtime_exception('Make expansion in dependency input'); }
					$word .= '$';
					continue;
				}
				if (!$dependencies) {
					if ($byte === 58) { $dependencies = true; $word = ''; }
					continue;
				}
				if (($byte === 32) || ($byte === 9) || ($byte === 10) || ($byte === 13)) {
					if ($word !== '') {
						$path = $word;
						if (!str_starts_with($path, '/')) { $path = $directory . '/' . $path; }
						if (!isset($seen[$path])) { $result[] = $path; $seen[$path] = true; }
						$word = '';
					}
					if ($byte === 10) { $finished = true; break; }
				}
				else { $word .= \scpp_portability_byte_from_int($byte); }
			}
			if ($finished) { break; }
		}
		if (!$dependencies) { throw new \scpp_portability_runtime_exception('Missing dependency rule'); }
		if ($word !== '') {
			$path = $word;
			if (!str_starts_with($path, '/')) { $path = $directory . '/' . $path; }
			if (!isset($seen[$path])) { $result[] = $path; }
		}
		return $result;
	}
}
