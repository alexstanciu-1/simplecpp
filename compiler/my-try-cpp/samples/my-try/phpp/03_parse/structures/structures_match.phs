
/* Match is a value selection, with no statement body or break target. */
namespace scpp\compiler;

final class match_expression_node extends expression_node {
	
	/** Common access preserves the property-free base while spans remain concrete data. */
	public function set_span(int $first, int $end): void {
		if (($first < 0) || ($end < $first) || ($end > 4294967295)) {
			throw new \scpp_portability_logic_exception('AST token span exceeds uint32 bounds');
		}
		$this->first_token_index = $first;
		$this->end_token_index = $end;
	}

	public function start_token(): int {
		return (int)$this->first_token_index;
	}

	public function end_token(): int {
		return (int)$this->end_token_index;
	}

	/** Inclusive start in the owning token snapshot. */
	public $first_token_index uint32;
	/** Exclusive end: token count is end - first, including zero for an empty span. */
	public $end_token_index uint32;

	
	public function preparation(): nullable<prepared_match_expression> {
		return $this->prepared_facts;
	}

	public function set_preparation(prepared_match_expression $facts): void {
		$this->prepared_facts = $facts;
	}

	public function clear_preparation(): void {
		$this->prepared_facts = null;
	}


	public expression_node $selector;
	public $arms Storage<match_arm_node>;
	private $prepared_facts nullable<prepared_match_expression> = null;

	public function __construct() {
		$this->arms = new Storage<match_arm_node>();
	}

	public function kind(): node_kind {
		return node_kind::match_expression;
	}

	public function require_preparation(): prepared_expression {
		return $this->prepared_facts;
	}

	public function children(): child_iterator_i {
		return new match_children_iterator($this);
	}

	/** Each arm is owned once; no fallback index duplicates the syntax ownership. */
	public function maintain(node_maintenance_worker_i $worker): void {
		$worker->enter($this);
		$worker->edge($this, $this->selector);
		$arms Storage<match_arm_node> = $this->arms;
		foreach ($arms  as $arm) {
			$worker->edge($this, $arm);
		}
	}
}

/** Empty labels mean default; otherwise every label selects the same result. */
final class match_arm_node extends ast_node {
	
	/** Common access preserves the property-free base while spans remain concrete data. */
	public function set_span(int $first, int $end): void {
		if (($first < 0) || ($end < $first) || ($end > 4294967295)) {
			throw new \scpp_portability_logic_exception('AST token span exceeds uint32 bounds');
		}
		$this->first_token_index = $first;
		$this->end_token_index = $end;
	}

	public function start_token(): int {
		return (int)$this->first_token_index;
	}

	public function end_token(): int {
		return (int)$this->end_token_index;
	}

	/** Inclusive start in the owning token snapshot. */
	public $first_token_index uint32;
	/** Exclusive end: token count is end - first, including zero for an empty span. */
	public $end_token_index uint32;

	
	public function preparation(): nullable<prepared_match_arm> {
		return $this->prepared_facts;
	}

	public function set_preparation(prepared_match_arm $facts): void {
		$this->prepared_facts = $facts;
	}

	public function clear_preparation(): void {
		$this->prepared_facts = null;
	}


	public $labels Storage<expression_node>;
	public expression_node $result;
	private $prepared_facts nullable<prepared_match_arm> = null;

	public function __construct() {
		$this->labels = new Storage<expression_node>();
	}

	public function kind(): node_kind {
		return node_kind::match_arm;
	}

	public function require_preparation(): prepared_match_arm {
		return $this->prepared_facts;
	}

	public function children(): child_iterator_i {
		return new match_arm_children_iterator($this);
	}

	/** Labels precede the result in inspection and maintenance, not duplicated branches. */
	public function maintain(node_maintenance_worker_i $worker): void {
		$worker->enter($this);
		$labels Storage<expression_node> = $this->labels;
		foreach ($labels  as $label) {
			$worker->edge($this, $label);
		}
		$worker->edge($this, $this->result);
	}
}
