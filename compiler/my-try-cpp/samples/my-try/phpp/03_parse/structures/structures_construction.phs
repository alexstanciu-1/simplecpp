
/* One new-expression syntax, independent of selected ownership and constructor admission. */
namespace scpp\compiler;

final class object_construction_node extends expression_node {
	
	/** Common access preserves the property-free base while spans remain concrete data. */
	public function set_span(int $first, int $end): void {
		if (($first < 0) || ($end < $first) || ($end > 4294967295)) {
			throw new \scpp_portability_logic_exception('AST token span exceeds uint32 bounds');
		}
		$this->first_token_index = $first;
		$this->end_token_index = $end;
	}

	public function start_token(): int {
		return (int)$this->first_token_index;
	}

	public function end_token(): int {
		return (int)$this->end_token_index;
	}

	/** Inclusive start in the owning token snapshot. */
	public $first_token_index uint32;
	/** Exclusive end: token count is end - first, including zero for an empty span. */
	public $end_token_index uint32;

	
	public function preparation(): nullable<prepared_object_construction> {
		return $this->prepared_facts;
	}

	public function set_preparation(prepared_object_construction $facts): void {
		$this->prepared_facts = $facts;
	}

	public function clear_preparation(): void {
		$this->prepared_facts = null;
	}


	public type_node $target_type;
	public $arguments Storage<expression_node>;
	private $prepared_facts nullable<prepared_object_construction> = null;

	public function __construct() {
		$this->arguments = new Storage<expression_node>();
	}

	public function kind(): node_kind {
		return node_kind::object_construction;
	}

	public function require_preparation(): prepared_expression {
		return $this->prepared_facts;
	}

	public function require_construction_preparation(): prepared_object_construction {
		return $this->prepared_facts;
	}

	public function children(): child_iterator_i {
		return new object_construction_children_iterator($this);
	}

	/** Named owning edges participate in ordinary cleanup and token relocation. */
	public function maintain(node_maintenance_worker_i $worker): void {
		$worker->enter($this);
		$worker->edge($this, $this->target_type);
		$arguments Storage<expression_node> = $this->arguments;
		foreach ($arguments  as $argument) {
			$worker->edge($this, $argument);
		}
	}
}

final class object_construction_children_iterator extends children_iterator {
	private int $next_argument;

	private object_construction_node $source;public function __construct(set:$source) {
		$this->next_argument = -1;
	}

	/** Inspect the type and then arguments without materializing another child list. */
	protected function read_next(): nullable<ast_node> {
		if ($this->next_argument === -1) {
			$this->next_argument = 0;
			return $this->source->target_type;
		}
		$arguments Storage<expression_node> = $this->source->arguments;
		if ($this->next_argument >= $arguments->count()) {
			return null;
		}
		$argument = $arguments[$this->next_argument];
		$this->next_argument++;
		return $argument;
	}
}
