<?php
namespace scpp\compiler;

// Dedicated disk-publication/build proofs use the same converted compiler owners.
$request = fs_read_text(__REQUEST_FILE__);
if ($request === 'reference-advisories') {
	$advisory_modules /** vector<string> */ = ['core', 'json', 'strings', 'datetime', 'filesystem'];
	Compiler_Lifecycle::configure_runtime(Runtime_Catalog_Loader::load(__RUNTIME_CATALOG_DIR__, $advisory_modules));
	echo Reference_Advisory_Proof::run();
}
elseif (string_byte_starts_with($request, 'chapter14:')) {
	echo S2S_Proof::chapter14(string_byte_slice($request, 10, string_byte_len($request) - 10));
}
else
{
$runtime_modules /** vector<string> */ = ['core', 'json', 'strings', 'datetime', 'filesystem'];
Compiler_Lifecycle::configure_runtime(Runtime_Catalog_Loader::load(__RUNTIME_CATALOG_DIR__, $runtime_modules));

// The same portable S2S proof runs in PHP and in this native executable.
$cpp_proof = S2S_Proof::run();

// Each invocation reads its own request in its isolated working directory.
$path = fs_read_text(__REQUEST_FILE__);
if ($path === 's2s-proof') {
	echo $cpp_proof;
}
elseif ($path === 'types-proof') {
	echo S2S_Proof::types();
}
elseif ($path === 'control-proof') {
	echo S2S_Proof::control_flow();
}
elseif (string_byte_starts_with($path, 's2s-edit:'))
{
	$directory = string_byte_slice($path, 9, string_byte_len($path) - 9);
	echo S2S_Proof::edited_source(fs_read_text($directory . '/valid.txt'),
		fs_read_text($directory . '/invalid.txt'), fs_read_text($directory . '/changed.txt'));
}
elseif (string_byte_starts_with($path, 's2s:'))
{
	$paths /** vector<string> */ = [string_byte_slice($path, 4, string_byte_len($path) - 4)];
	$compiler = new Compiler();
	$compiler->init($paths);
	$compiler->select_entry('main', 'main.phs');
	try
	{
		$compiler->exec_cpp();
		$cpp_outputs /** Storage<cpp_artifact> */ = Model::$cpp_files;
		$first = CPP_Output::encode($cpp_outputs);
		$compiler->prepare();
		$compiler->cpp();
		$cpp_outputs = Model::$cpp_files;
		if (CPP_Output::encode($cpp_outputs) !== $first) {
			throw new \LogicException('Repeated S2S preparation changed artifacts');
		}
		echo $first;
	}
	catch (\Throwable $error)
	{
		$message = $error->getMessage();
		$cpp_failed_outputs /** Storage<cpp_artifact> */ = Model::$cpp_files;
		if (!$cpp_failed_outputs->is_empty()) {
			throw new \LogicException('Failed S2S compilation published output');
		}
		$recovery_paths /** vector<string> */ = [__RECOVERY_DIR__];
		$compiler->init($recovery_paths);
		$compiler->exec_cpp();
		$cpp_recovered /** Storage<cpp_artifact> */ = Model::$cpp_files;
		if (q_count($cpp_recovered) !== 1) {
			throw new \LogicException('S2S recovery did not produce one module');
		}
		echo "ERROR\n", $message;
	}
}
else { throw new \RuntimeException('Unsupported native C++ driver request'); }
}
