<?php
namespace scpp\compiler;

// Tokenization failure blocks parsing, including with a single worker slot.
$pipeline_compiler = new Compiler();
$pipeline_compiler->jobs = 1;
$pipeline_paths /** vector<string> */ = [__PIPELINE_DIR__];
$pipeline_compiler->init($pipeline_paths);
$pipeline_failed = false;
try {
	$pipeline_compiler->exec_llvm();
}
catch (\RuntimeException $expected) {
	$pipeline_failed = true;
}
if ((!$pipeline_failed) || (q_count(Model::syntax_files()) !== 0) || (q_count(Model::tokens()) !== 1)) {
	throw new \LogicException('Frontend crossed a failed tokenization barrier');
}
if (q_count(Model::$global_scope->functions_named('ready')) !== 0) {
	throw new \LogicException('Failed tokenization allowed collection to start');
}
// Explicit stage entrypoints remain available for inspection and tests.
$stage_paths /** vector<string> */ = [__RECOVERY_DIR__];
$pipeline_compiler->init($stage_paths);
$pipeline_compiler->jobs = \scpp\compiler\DEFAULT_COMPILER_JOBS;
$pipeline_compiler->tokenize();
$stage_syntax /** Storage<parsed_file> */ = Model::syntax_files();
if ((q_count(Model::tokens()) !== 1) || (!$stage_syntax->is_empty())) {
	throw new \LogicException('Standalone tokenization did not stop at its requested boundary');
}
$pipeline_compiler->parse();
if (q_count(Model::syntax_files()) !== 1) {
	throw new \LogicException('Standalone parsing lost its input snapshot');
}

// The native proof reuses the same session across updates, with in-memory source input.
Compiler_Lifecycle::reset();
$sync_module = new module('/sync-proof', '/sync-proof', '/sync-proof');
$definition = new file();
$definition->path = 'a.phs';
$definition->content = 'function answer(): int { return 7; }';
$use_file = new file();
$use_file->path = 'b.phs';
$use_file->content = 'return answer();';
Source_Registry::add($sync_module, $definition);
Source_Registry::add($sync_module, $use_file);
$modules /** Keyed_Storage<module> */ = Model::$modules;
$modules->add($sync_module->name, $sync_module);
$sync_compiler = new Compiler();
$sync_compiler->exec_llvm();
$syntax_before /** Storage<parsed_file> */ = Model::syntax_files();
$kept_caller = $syntax_before[1];
$first_candidates /** vector<collected_name> */ = Model::$global_scope->functions_named('answer');
$first_function = object_cast($first_candidates[0], collected_function::class);
if ($first_function->change_status !== change_state::added) {
	throw new \LogicException('Initial sync did not mark additions');
}
$current_inputs /** Keyed_Storage<source_record> */ = $sync_module->sources;
$current_inputs['a.phs']->file->content = 'function answer(): int { return 8; }';
$changed_paths /** vector<string> */ = ['/sync-proof/a.phs'];
$sync_compiler->update_llvm($changed_paths);
$syntax_after /** Storage<parsed_file> */ = Model::syntax_files();
$next_candidates /** vector<collected_name> */ = Model::$global_scope->functions_named('answer');
$next_function = object_cast($next_candidates[0], collected_function::class);
if ((!$next_function->syntax()->body->syntax_changed) || ($next_function->syntax() !== $first_function->syntax()) || ($syntax_after[1] !== $kept_caller)) {
	throw new \LogicException('Native sync lost body flags or reparsed the unchanged caller');
}
$current_inputs['a.phs']->file->content = 'function answer(): int { return 8; } function answer(): int { return 9; }';
$sync_compiler->sync($changed_paths);
$duplicates /** vector<collected_name> */ = Model::$global_scope->functions_named('answer');
if (q_count($duplicates) !== 2) {
	throw new \LogicException('Native sync merged duplicate declarations');
}
$current_inputs['a.phs']->file->content = 'function answer(): int { return 9; }';
$sync_compiler->update_llvm($changed_paths);
$survivors /** vector<collected_name> */ = Model::$global_scope->functions_named('answer');
if ((q_count($survivors) !== 1) || ($survivors[0]->change_status !== change_state::added)) {
	throw new \LogicException('Native sync failed exact duplicate matching or tombstone filtering');
}
$current_inputs['a.phs']->file->disk_source = true; // Absent path represents deletion of the published source.
$sync_compiler->sync($changed_paths);
$deleted_survivors /** vector<collected_name> */ = Model::$global_scope->functions_named('answer');
if (q_count($deleted_survivors) !== 0) {
	throw new \LogicException('Native sync resolved a deleted file');
}

// Scope owners survive a failed incremental parse after an earlier body was replaced.
$scope_source = new file();
$scope_source->path = 'scope-ownership.phs';
$scope_source->content = 'function first(): int { return 1; } function second(): int { return 2; }';
$scope_parsed = (new Parser((new Tokenizer($scope_source))->tokenize()))->parse();
$scope_source->content = 'function first(): int { return 3; } function second(): int { return 4 }';
$scope_parser = new Parser((new Tokenizer($scope_source))->tokenize(), null, $scope_parsed);
$scope_failed = false;
try {
	$scope_parser->parse();
}
catch (\RuntimeException $scope_error) {
	$scope_failed = true;
}
if ((!$scope_failed) || $scope_parsed->complete) {
	throw new \LogicException('Scope ownership proof did not retain an incomplete parse');
}
// Inspect membership as well as references: PHP ordinary references mask native expiration.
$scope_declarations /** Storage<declaration_node> */ = $scope_parsed->root->declarations;
$scope_first = object_cast($scope_declarations[0], function_node::class);
$scope_second = object_cast($scope_declarations[1], function_node::class);
$scope_owned /** Storage<scope> */ = $scope_parsed->scopes;
$scope_first_owned = false;
$scope_second_owned = false;
$scope_file_owned = false;
foreach ($scope_owned as $scope_item)
{
	if ($scope_item === $scope_first->body->local_scope()) {
		$scope_first_owned = true;
	}
	if ($scope_item === $scope_second->body->local_scope()) {
		$scope_second_owned = true;
	}
	if ($scope_item === $scope_parsed->root->body->local_scope()) {
		$scope_file_owned = true;
	}
}
if ((!$scope_first_owned) || (!$scope_second_owned) || (!$scope_file_owned)) {
	throw new \LogicException('Failed parse released scopes referenced by retained syntax');
}
$scope_source->content = 'function first(): int { return 3; } function second(): int { return 4; }';
$scope_recovered = (new Parser((new Tokenizer($scope_source))->tokenize(), null, $scope_parsed))->parse();
if ((!$scope_recovered->complete) || (q_count($scope_recovered->scopes) !== 4)) {
	throw new \LogicException('Successful retry did not replace the accumulated scope inventory');
}

// The same portable S2S proof runs in PHP and in this native executable.
$cpp_proof = S2S_Proof::run();

// Host harness supplies literal paths before conversion.
$path = fs_read_text(__REQUEST_FILE__);
if ($path === 's2s-proof') {
	echo $cpp_proof;
}
elseif (string_byte_starts_with($path, 's2s:'))
{
	$paths /** vector<string> */ = [string_byte_slice($path, 4, string_byte_len($path) - 4)];
	$compiler = new Compiler();
	$compiler->init($paths);
	try
	{
		$compiler->exec_cpp();
		$cpp_outputs /** Storage<cpp_module> */ = Model::$cpp_files;
		$first = $cpp_outputs[0];
		$compiler->prepare();
		$compiler->cpp();
		$cpp_outputs = Model::$cpp_files;
		if (($cpp_outputs[0] === $first) || ($cpp_outputs[0]->text !== $first->text)) {
			throw new \LogicException('Repeated S2S preparation changed output or reused artifacts');
		}
		echo $first->text;
	}
	catch (\Throwable $error)
	{
		$message = $error->getMessage();
		$cpp_failed_outputs /** Storage<cpp_module> */ = Model::$cpp_files;
		if (!$cpp_failed_outputs->is_empty()) {
			throw new \LogicException('Failed S2S compilation published output');
		}
		$recovery_paths /** vector<string> */ = [__RECOVERY_DIR__];
		$compiler->init($recovery_paths);
		$compiler->exec_cpp();
		$cpp_recovered /** Storage<cpp_module> */ = Model::$cpp_files;
		if (q_count($cpp_recovered) !== 1) {
			throw new \LogicException('S2S recovery did not produce one module');
		}
		echo "ERROR\n", $message;
	}
}
else
{
	$paths /** vector<string> */ = [$path];
	$compiler = new Compiler();
	$retained /** Storage<llvm_module> */ = new Storage();
	$previous = '';
	try
	{
		for ($attempt = 0; $attempt < 2; $attempt++)
		{
			$compiler->init($paths);
			$compiler->exec_llvm();
			// Exercise lazy typed inspection without parent or sibling links.
			$syntax_files /** Storage<parsed_file> */ = Model::syntax_files();
			foreach ($syntax_files as $syntax_file)
			{
				$queue /** Storage<ast_node> */ = new Storage();
				$queue->append($syntax_file->root);
				for ($node_index = 0; $node_index < q_count($queue); $node_index++)
				{
					$syntax_node = $queue[$node_index];
					$position = 0;
					foreach ($syntax_node->children() as $child_index => $child)
					{
						if ($child_index !== $position) {
							throw new \LogicException('Inspection cursor lost sequential child keys');
						}
						$position++;
						$queue->append($child);
					}
				}
			}

			$llvm_outputs /** Storage<llvm_module> */ = Model::$llvm_files;
			$trace = "OK\n";
			foreach ($llvm_outputs as $output) {
				$trace .= string_byte_len($output->file_name) . ':' . $output->file_name . string_byte_len($output->text) . ':' . $output->text;
			}
			if ($attempt === 1)
			{
				if ($trace !== $previous) {
					throw new \LogicException('Repeated compilation changed output');
				}
				foreach ($retained as $index => $old)
				{
					if ($old === $llvm_outputs[$index]) {
						throw new \LogicException('Rebuild reused an output record');
					}
					if ($old->text !== $llvm_outputs[$index]->text) {
						throw new \LogicException('Rebuild damaged retained output');
					}
				}
			}
			$previous = $trace;
			$retained = $llvm_outputs;
		}
		echo $previous;
	}
	catch (\Throwable $error)
	{
		$message = $error->getMessage();
		$llvm_failed_outputs /** Storage<llvm_module> */ = Model::$llvm_files;
		if (!$llvm_failed_outputs->is_empty()) {
			throw new \LogicException('Failed compilation published output');
		}
		$recovery_paths /** vector<string> */ = [__RECOVERY_DIR__];
		$compiler->init($recovery_paths);
		$compiler->exec_llvm();
		$llvm_recovered /** Storage<llvm_module> */ = Model::$llvm_files;
		if (q_count($llvm_recovered) !== 1) {
			throw new \LogicException('Recovery did not produce one module');
		}
		if ($llvm_recovered[0]->text !== "define i32 @main() {\n_Gb0:\n    ret i32 0\n}\n") {
			throw new \LogicException('Recovery changed the expected output');
		}
		echo "ERROR\n", $message;
	}
}
