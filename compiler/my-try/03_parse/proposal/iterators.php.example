<?php

/*
 * REVIEW SKETCH ONLY. Not loaded by boot.php or scanned as executable PHP.
 * Companion to structures.php.example, which defines the typed nodes.
 * Shared node abstractions live in abstractions.php.example. Load that
 * file, then this file, then structures.php.example in a review harness.
 * No proposal loads another; no conversion/native support is claimed.
 * Callers must not change child membership while iterating; no defensive copies.
 * Iterator keys have no AST meaning; callers use the values and traversal order.
 * children() returns child_iterator_i: a typed, forward-only PHP Iterator.
 * Each call creates an independent cursor. Composite iterators retain their source
 * node; collection iterators retain only the collection. Neither copies membership.
 * Constructors do not read children: fields are read as iteration advances.
 * Cursor state is explicit: a cached current child, traversal position and each
 * specialization's field/collection progress. No generator lowering is required.
 * Composite cursors retain a shared<T> source in native code. Passing $this must
 * preserve its existing owning handle, never create a new owner around raw this.
 * Collection cursors delegate to Storage iteration, including holes. Its PHP
 * implementation may use a generator internally; native Storage uses its own cursor.
 * Typed Iterator/Storage cursor bindings and shared-source construction still need
 * native implementation/proof. This sketch does not claim current convertibility.
 * Cursors are forward-only: rewind is allowed only before advancement. Obtain a
 * fresh children() cursor for another traversal; do not nest loops on one cursor.
 * Destroying a cursor releases its source and cached child; nodes never own cursors.
 * A retained cursor owns syntax only, not the parsed-file semantic context. It does
 * not keep weak scope/occurrence links or token snapshots alive. Semantic workers
 * must retain that context independently and never use inspection for maintenance.
 */
namespace scpp\compiler\proposal;

use scpp\compiler\Storage;

/** Typed inspection cursor; current() requires valid(), and keys are traversal positions. */
interface child_iterator_i extends \Iterator
{
	public function current(): ast_node;
	public function key(): int;
	public function next(): void;
	public function rewind(): void;
	public function valid(): bool;
}

/** Shared forward-only cursor protocol; concrete cursors supply only the next child. */
abstract class children_iterator implements child_iterator_i
{
	private bool $started = false;
	private int $position = 0;
	private ?ast_node $current_child = null;

	/** Null means exhausted; concrete cursors skip absent optional fields themselves. */
	abstract protected function read_next(): ?ast_node;

	public function current(): ast_node
	{
		if (!$this->valid()) {
			throw new \LogicException('Child iterator has no current node');
		}
		return $this->current_child;
	}

	public function key(): int
	{
		if (!$this->valid()) {
			throw new \LogicException('Child iterator has no current key');
		}
		return $this->position;
	}

	/** Advance once; repeated advances after exhaustion do nothing. */
	public function next(): void
	{
		if ($this->valid()) {
			$this->current_child = $this->read_next();
			$this->position++;
		}
	}

	/** Foreach initializes the cursor; restarting an advanced cursor is explicit misuse. */
	public function rewind(): void
	{
		if ($this->position !== 0) {
			throw new \LogicException('Create a fresh child iterator to restart traversal');
		}
		$this->valid();
	}

	/** Defer the first source read until iteration actually starts. */
	public function valid(): bool
	{
		if (!$this->started) {
			$this->current_child = $this->read_next();
			$this->started = true;
		}
		return $this->current_child !== null;
	}
}

/** Leaves need no source owner and have no cursor state. */
final class empty_children_iterator implements child_iterator_i
{
	public function current(): ast_node
	{
		throw new \LogicException('Empty child iterator has no current node');
	}

	public function key(): int
	{
		throw new \LogicException('Empty child iterator has no current key');
	}

	public function next(): void
	{
	}

	public function rewind(): void
	{
	}

	public function valid(): bool
	{
		return false;
	}
}

/**
 * Reuse for single-list nodes; retain the original typed collection, not its node.
 * @template T of ast_node
 * Generic intent is documentary; Storage<T> is not converted to Storage<ast_node>.
 * Native binding uses Storage<T>'s cursor directly, without copying membership.
 */
final class storage_children_iterator extends children_iterator
{
	/** @var Storage<T> Owning alias to the source collection. */
	private Storage $source;
	/** @var \Iterator<int, T>|null Host adapter; native Storage supplies its own cursor. */
	private ?\Iterator $cursor = null;

	/** @param Storage<T> $source */
	public function __construct(Storage $source)
	{
		$this->source = $source;
	}

	/** Start once, then advance the existing collection cursor, preserving holes. */
	protected function read_next(): ?ast_node
	{
		if ($this->cursor === null) {
			$this->cursor = $this->source->getIterator();
			$this->cursor->rewind();
		}
		else {
			$this->cursor->next();
		}
		if (!$this->cursor->valid()) {
			return null;
		}
		return $this->cursor->current();
	}
}

/** Retain the source and visit its named fields in grammar order. */
final class parameter_children_iterator extends children_iterator
{
	private parameter_node $source;
	private bool $consumed = false;

	public function __construct(parameter_node $source)
	{
		$this->source = $source;
	}

	/** Read the next named field only when requested. */
	protected function read_next(): ?ast_node
	{
		if ($this->consumed) {
			return null;
		}
		$this->consumed = true;
		return $this->source->type_syntax;
	}
}

/** Retain the source and visit its named fields in grammar order. */
final class binary_expression_children_iterator extends children_iterator
{
	private binary_expression_node $source;
	private int $next_field = 0;

	public function __construct(binary_expression_node $source)
	{
		$this->source = $source;
	}

	/** Read the next named field only when requested. */
	protected function read_next(): ?ast_node
	{
		switch ($this->next_field)
		{
			case 0:
				$this->next_field = 1;
				return $this->source->left;
			case 1:
				$this->next_field = 2;
				return $this->source->right;
		}
		return null;
	}
}

/** Retain the source and visit its named fields in grammar order. */
final class assignment_expression_children_iterator extends children_iterator
