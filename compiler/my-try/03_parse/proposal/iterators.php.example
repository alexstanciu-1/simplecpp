	protected function read_next(): ?ast_node
	{
		switch ($this->next_field)
		{
			case 0:
				$this->next_field = 1;
				return $this->source->element_type;
			case 1:
				$this->next_field = 2;
				return $this->source->count;
		}
		return null;
	}
}

