// One application, with the two file roles supported by Translation_Parser.
final class Frontend_Session {
	public hash<Translation_Scope,string> $definitions;
	public ?Translation_Scope $scope = null;
	public ?Call_Syntax $entry = null;
	public int $generation = 0;
	public string $tokenized = "";
	public string $parsed = "";

	private function parser(string $path, string $text): Translation_Parser {
		$this->tokenized .= $path . ",";
		$source = new Translation_Source($path, $text);
		$this->parsed .= $path . ",";
		return new Translation_Parser($source);
	}

	private function read_source(string $directory, string $path): string {
		$result = fs_get($directory . "/" . $path);
		if (!isset($result)) throw new Translation_Diagnostic($path, 0, "Cannot read source", "");
		return $result;
	}

	public function refresh(string $directory, bool $all_definitions = false): void {
		$this->tokenized = "";
		$this->parsed = "";
		$entry = $this->entry;
		$paths vector<string> = [];
		if ($all_definitions) {
			$names vector<string> = fs_scan($directory);
			foreach ($names as $name) {
				if ($name !== "main.phs" && str_ends_with($name, ".phs") && fs_is_file($directory . "/" . $name)) $paths[] = $name;
			}
		}
		if (count($paths) === 0) $paths[] = "definition.phs";
		$scopes hash<Translation_Scope,string> = [];
		foreach ($paths as $path) {
			$text = $this->read_source($directory, $path);
			$scope = hash_get_or_null($this->definitions, $path);
			if ($scope === null || $scope->source->text !== $text) {
				$scope = $this->parser($path, $text)->parse_scope();
			}
			$scopes[$path] = $scope;
		}
		$main string = $this->read_source($directory, "main.phs");
		if ($entry === null || $entry->source->text !== $main) {
			$parser = $this->parser("main.phs", $main);
			$entry = $parser->parse_entry();
		}
		// Publish only after every changed file has parsed successfully.
		$this->definitions = $scopes;
		$this->scope = $scopes[$paths[0]];
		$this->entry = $entry;
		$this->generation++;
	}
}
