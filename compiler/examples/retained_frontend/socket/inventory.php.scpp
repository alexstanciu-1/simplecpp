// Digest the paths selected by Module_Loader for one application.
function source_inventory(string $directory, bool $from_bytes): string {
    $text string = fs_get($directory . "/module.sources.json");
    $doc = document($text);
    $root json_node = json_document_root($doc);
    $modules json_node = json_node_member($root, "modules");
    if (json_node_kind($modules) !== "object" || json_node_size($modules) !== 1)
        throw Exception::make("Expected one application in the source inventory");
    $module string = json_node_key($modules, 0);
    $sources json_node = json_node_member($modules, $module);
    if (json_node_kind($sources) !== "object") throw Exception::make("Expected source paths");
    $count int = json_node_size($sources);
    $report = "{";
    for ($i = 0; $i < $count; $i++) {
        $path string = json_node_key($sources, $i);
        $disk = $directory . "/" . $path;
        $digest = "";
        if ($from_bytes) {
            $bytes string = fs_get($disk);
            $digest = host_sha256_bytes($bytes);
        } else {
            $digest = host_sha256_file($disk);
        }
        $key = $module . "/" . $path;
        $unit = "units/" . host_sha256_bytes($key) . ".cpp";
        if ($i > 0) $report .= ",";
        $report .= quoted($key) . ":{\"flavor\":" . quoted(member_text($sources, $path))
            . ",\"sha256\":" . quoted($digest) . ",\"unit\":" . quoted($unit) . "}";
    }
    return $report . "}";
}
