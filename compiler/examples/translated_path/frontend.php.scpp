// Token spans refer to one immutable source string.
struct Token_Span {
	public Token_Kind $kind = Token_Kind::End;
	public int $offset;
	public int $length;
}

// Retains the source identity and byte offset for frontend and preparation failures.
final class Translation_Diagnostic extends Exception {
	public readonly string $path;
	public readonly int $offset;
	public readonly string $detail;
	public readonly string $location;

	public function __construct(string $path, int $offset, string $detail, string $bytes) {
		$this->path = $path;
		$this->offset = $offset;
		$this->detail = $detail;
		$this->location = translation_location($bytes, $offset);
	}
}

function translation_location(string $bytes, int $offset): string {
	$line = 1;
	$start = 0;
	for ($i = 0; $i < $offset && $i < strlen($bytes); $i++) {
		if ($bytes[$i] == 10) { $line++; $start = $i + 1; }
	}
	return (string)$line . ":" . (string)($offset - $start + 1);
}

function decimal_byte(byte $value): bool {
	return $value >= 48 && $value <= 57;
}

function identifier_byte(byte $value): bool {
	return ($value >= 65 && $value <= 90) || ($value >= 97 && $value <= 122) || $value === (byte)95;
}

function tokenize_source(string $path, string $text, Scan_Flavor $mode): vector<Token_Span> {
	$invalid = source_utf8_error($text);
	if ($invalid >= 0) throw new Translation_Diagnostic($path, $invalid, "Invalid UTF-8 source", $text);
	$tokens vector<Token_Span> = [];
	$length = strlen($text);
	$offset = 0;
	while ($offset < $length) {
		$start = $offset;
		$value = $text[$offset];
		$offset++;
		if ($value == 32 || $value == 9 || $value == 10 || $value == 13) {
			continue;
		}

		// Comment openers take precedence over punctuation in the bootstrap lexer.
		$python = $mode === Scan_Flavor::python;
		$line_comment = ($value == 35 && ($python || ($mode === Scan_Flavor::php &&
			!string_byte_slice_equals($text, $start, 2, "#[")))) ||
			(!$python && $value == 47 && string_byte_slice_equals($text, $start, 2, "//"));
		if ($line_comment) {
			while ($offset < $length && $text[$offset] != 10 && $text[$offset] != 13) { $offset++; }
			continue;
		}
		if (!$python && $value == 47 && string_byte_slice_equals($text, $start, 2, "/*")) {
			$offset++;
			while ($offset < $length && !string_byte_slice_equals($text, $offset, 2, "*/")) { $offset++; }
			if ($offset === $length) throw new Translation_Diagnostic($path, $start, "Unterminated block comment", $text);
			$offset += 2;
			continue;
		}

		$kind = Token_Kind::End;
		if (identifier_byte($value)) {
			$kind = Token_Kind::T_identifier;
			while ($offset < $length) {
				$next = $text[$offset];
				if (!identifier_byte($next) && !decimal_byte($next)) {
					break;
				}
				$offset++;
			}
		} else if (decimal_byte($value) || ($value == 46 && $offset < $length && decimal_byte($text[$offset]))) {
			$kind = $value == 46 ? Token_Kind::T_floating : Token_Kind::T_integer;
			while ($offset < $length && decimal_byte($text[$offset])) {
				$offset++;
			}
			if ($value != 46 && $offset < $length && $text[$offset] == 46 && !string_byte_slice_equals($text, $offset, 2, "..")) {
				$kind = Token_Kind::T_floating;
				$offset++;
				while ($offset < $length && decimal_byte($text[$offset])) { $offset++; }
			}
			if ($offset < $length && ($text[$offset] == 69 || $text[$offset] == 101)) {
				$kind = Token_Kind::T_floating;
				$offset++;
				if ($offset < $length && ($text[$offset] == 43 || $text[$offset] == 45)) $offset++;
				if ($offset === $length || !decimal_byte($text[$offset])) throw new Translation_Diagnostic($path, $start, "Expected exponent digits", $text);
				while ($offset < $length && decimal_byte($text[$offset])) { $offset++; }
			}
			if ($offset < $length && (identifier_byte($text[$offset]) || ($text[$offset] == 46 && !string_byte_slice_equals($text, $offset, 3, "..<")))) {
				throw new Translation_Diagnostic($path, $start, "Unsupported numeric literal", $text);
			}
		} else {
			$width = 0;
			$kind = punctuation_at($text, $start, $value, $mode, $width);
			if ($kind === Token_Kind::Unrecognized) throw new Translation_Diagnostic($path, $start, "Unsupported token", $text);
			if ($kind === Token_Kind::Rejected) {
				throw new Translation_Diagnostic($path, $start, "Unsupported punctuation in Python flavor", $text);
			}
			$offset = $start + $width;
		}
		$token Token_Span;
		$token->kind = $kind;
		$token->offset = $start;
		$token->length = $offset - $start;
		$tokens[] = $token;
	}

	$end Token_Span;
	$end->kind = Token_Kind::End;
	$end->offset = $length;
	$end->length = 0;
	$tokens[] = $end;
	return $tokens;
}

// Owns the immutable bytes and token positions addressed by the retained syntax.
final class Translation_Source {
	public readonly string $path;
	public readonly string $text;
	public readonly vector<Token_Span> $tokens;

	public function __construct(string $path, string $text) {
		$this->path = $path;
		$this->text = $text;
		$this->tokens = tokenize_source($path, $text, Scan_Flavor::php);
	}
}

// The selected entry has one return of a nullary source call.
final class Call_Syntax {
	public readonly Translation_Source $source;
	public readonly string $name;
	public readonly int $offset;

	public function __construct(Translation_Source $source, string $name, int $offset) {
		$this->source = $source;
		$this->name = $name;
		$this->offset = $offset;
	}
}

// The collected definition owns the source generation and its completed function.
final class Translation_Scope {
	public readonly Translation_Source $source;
	public readonly Function_Declaration $declaration;

	public function __construct(Translation_Source $source, Function_Declaration $declaration) {
		$declaration->body();
		$this->source = $source;
		$this->declaration = $declaration;
	}

	public function resolve(string $key): ?Function_Declaration {
		if ($this->declaration->symbol_key() === $key) {
			return $this->declaration;
		}
		return null;
	}
}

// The parse cursor consumes tokens from only its own source.
final class Translation_Parser {
	private Translation_Source $source;
	private int $index = 0;

	public function __construct(Translation_Source $source) {
		$this->source = $source;
	}

	private function expect(Token_Kind $kind, string $message): Token_Span {
		$token = $this->source->tokens[$this->index];
		if ($token->kind !== $kind) {
			throw new Translation_Diagnostic($this->source->path, $token->offset, $message, $this->source->text);
		}
		if ($kind !== Token_Kind::End) {
			$this->index++;
		}
		return $token;
	}

	private function spelling(Token_Span $token): string {
		return substr($this->source->text, $token->offset, $token->length);
	}

	private function keyword(string $name): void {
		$message = "Expected " . $name;
		$token = $this->expect(Token_Kind::T_identifier, $message);
		if ($this->spelling($token) !== $name) {
			throw new Translation_Diagnostic($this->source->path, $token->offset, $message, $this->source->text);
		}
	}

	private function name_token(): Token_Span {
		$token = $this->expect(Token_Kind::T_identifier, "Expected function name");
		$name = $this->spelling($token);
		if ($name === "function" || $name === "int" || $name === "return") {
			throw new Translation_Diagnostic($this->source->path, $token->offset, "Expected function name", $this->source->text);
		}
		return $token;
	}

	private function nullary(): void {
		$this->expect(Token_Kind::T_lparen, "Expected (");
		$this->expect(Token_Kind::T_rparen, "Expected )");
	}

	private function function_header(): Function_Declaration {
		$start = $this->index;
		$this->keyword("function");
		$name = $this->spelling($this->name_token());
		$this->nullary();
		$this->expect(Token_Kind::T_colon, "Expected :");
		$type = $this->expect(Token_Kind::T_identifier, "Expected return type");
		$word = $this->spelling($type);
		$floating = $word === "float" || $word === "float64";
		if (!$floating && $word !== "int") throw new Translation_Diagnostic($this->source->path, $type->offset, "Expected int or float", $this->source->text);
		return new Function_Declaration($name, $start, $this->index, $floating);
	}

	private function read_body(bool $floating): Function_Body {
		$body_start = $this->index;
		$this->expect(Token_Kind::T_lbrace, "Expected {");
		$return_start = $this->index;
		$this->keyword("return");
		$literal = $this->index;
		$calls_function = $this->source->tokens[$literal]->kind === Token_Kind::T_identifier;
		if ($floating) {
			$kind = $this->source->tokens[$literal]->kind;
			if ($kind === Token_Kind::T_minus || $kind === Token_Kind::T_plus) $this->index++;
			$this->expect(Token_Kind::T_floating, "Expected decimal floating literal");
		} elseif ($calls_function) {
			$this->name_token();
			$this->nullary();
		} else {
			$this->expect(Token_Kind::T_integer, "Expected decimal integer");
		}
		$this->expect(Token_Kind::T_semicolon, "Expected ;");
		$statement = new Function_Return($return_start, $this->index, $literal, $calls_function);
		$this->expect(Token_Kind::T_rbrace, "Expected }");
		return new Function_Body($body_start, $this->index, $statement);
	}

	public function parse_scope(): Translation_Scope {
		return new Translation_Scope($this->source, $this->parse_declaration());
	}

	public function parse_declaration(): Function_Declaration {
		$function = $this->function_header();
		Function_Declaration::complete_body($function, $this->read_body($function->returns_float));
		$this->expect(Token_Kind::End, "Expected end of source");
		return $function;
	}

	public function parse_entry(): Call_Syntax {
		$this->keyword("return");
		$name = $this->name_token();
		$this->nullary();
		$this->expect(Token_Kind::T_semicolon, "Expected ;");
		$this->expect(Token_Kind::End, "Expected end of source");
		return new Call_Syntax($this->source, $this->spelling($name), $name->offset);
	}
}

// Merge bytewise-sorted halves to reproduce the project loader's ksort(SORT_STRING).
function order_paths(vector<string> &$paths, vector<string> &$scratch, int $begin, int $end): void {
    if ($end - $begin < 2) return;
    $mid = $begin + (($end - $begin) >> 1);
    order_paths($paths, $scratch, $begin, $mid);
    order_paths($paths, $scratch, $mid, $end);
    $a = $begin;
    $b = $mid;
    for ($i = $begin; $i < $end; $i++) {
        if ($b === $end || ($a < $mid && strcmp($paths[$a], $paths[$b]) <= 0)) {
            $scratch[$i] = $paths[$a];
            $a++;
        } else {
            $scratch[$i] = $paths[$b];
            $b++;
        }
    }
    for ($i = $begin; $i < $end; $i++) { $paths[$i] = $scratch[$i]; }
}
