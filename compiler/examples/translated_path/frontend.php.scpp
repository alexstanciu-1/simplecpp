// Token spans refer to one immutable source string.
struct Token_Span {
	public Token_Kind $kind = Token_Kind::End;
	public int $offset;
	public int $length;
}

// Retains the source identity and byte offset for frontend and preparation failures.
final class Translation_Diagnostic extends Exception {
	public readonly string $path;
	public readonly int $offset;
	public readonly string $detail;
	public readonly string $location;

	public function __construct(string $path, int $offset, string $detail, string $bytes) {
		$this->path = $path;
		$this->offset = $offset;
		$this->detail = $detail;
		$this->location = translation_location($bytes, $offset);
	}
}

function translation_location(string $bytes, int $offset): string {
	$line = 1;
	$start = 0;
	for ($i = 0; $i < $offset && $i < strlen($bytes); $i++) {
		if ($bytes[$i] == 10) { $line++; $start = $i + 1; }
	}
	return (string)$line . ":" . (string)($offset - $start + 1);
}

function decimal_byte(byte $value): bool {
	return $value >= 48 && $value <= 57;
}

// Returns decimal for an ordinary digit following the initial zero.
function integer_radix(byte $marker): int {
	if ($marker == 120 || $marker == 88) return 16;
	if ($marker == 111 || $marker == 79) return 8;
	return 10;
}

// A non-digit sorts beyond every supported radix.
function integer_digit(byte $value): int {
	if (decimal_byte($value)) return (int)$value - 48;
	if ($value >= 65 && $value <= 70) return (int)$value - 65 + 10;
	if ($value >= 97 && $value <= 102) return (int)$value - 97 + 10;
	return 16;
}

function identifier_byte(byte $value): bool {
	return ($value >= 65 && $value <= 90) || ($value >= 97 && $value <= 122) || $value === (byte)95;
}

// Return the exclusive end of the raw spelling; decoding belongs to the literal consumer.
function quoted_token_end(string $path, string &$text, int $start, int $opening, int $length, bool $python, bool $interpolated): int {
	$delimiter = $text[$opening];
	$offset = $opening + 1;
	$multiline = false;
	while ($offset < $length) {
		$byte = $text[$offset];
		$offset++;
		if ($byte === $delimiter) {
			if ($python && $multiline) throw new Translation_Diagnostic($path, $start, "Multiline Python strings are deferred", $text);
			return $offset;
		}
		if ($byte == 92 && $offset < $length) {
			$byte = $text[$offset];
			$offset++;
		}
		if ($byte == 10 || $byte == 13) $multiline = true;
	}
	throw new Translation_Diagnostic($path, $start, $interpolated ? "Unterminated interpolated string" : "Unterminated quoted string", $text);
}

function tokenize_source(string $path, string $text, Scan_Flavor $mode): vector<Token_Span> {
	$invalid = source_utf8_error($text);
	if ($invalid >= 0) throw new Translation_Diagnostic($path, $invalid, "Invalid UTF-8 source", $text);
	$tokens vector<Token_Span> = [];
	$length = strlen($text);
	$offset = 0;
	while ($offset < $length) {
		$start = $offset;
		$value = $text[$offset];
		$offset++;
		if ($value == 32 || $value == 9 || $value == 10 || $value == 13) {
			continue;
		}

		// Comment openers take precedence over punctuation in the bootstrap lexer.
		$python = $mode === Scan_Flavor::python;
		$line_comment = ($value == 35 && ($python || ($mode === Scan_Flavor::php &&
			!string_byte_slice_equals($text, $start, 2, "#[")))) ||
			(!$python && $value == 47 && string_byte_slice_equals($text, $start, 2, "//"));
		if ($line_comment) {
			while ($offset < $length && $text[$offset] != 10 && $text[$offset] != 13) { $offset++; }
			continue;
		}
		if (!$python && $value == 47 && string_byte_slice_equals($text, $start, 2, "/*")) {
			$offset++;
			while ($offset < $length && !string_byte_slice_equals($text, $offset, 2, "*/")) { $offset++; }
			if ($offset === $length) throw new Translation_Diagnostic($path, $start, "Unterminated block comment", $text);
			$offset += 2;
			continue;
		}

		$kind = Token_Kind::End;
		$variable = $mode === Scan_Flavor::php && $value == 36;
		if ($variable && ($offset === $length || !identifier_byte($text[$offset]))) {
			throw new Translation_Diagnostic($path, $start, "Expected variable name", $text);
		}
		if ($variable || identifier_byte($value)) {
			$kind = $variable ? Token_Kind::T_variable : Token_Kind::T_identifier;
			while ($offset < $length) {
				$next = $text[$offset];
				if (!identifier_byte($next) && !decimal_byte($next)) {
					break;
				}
				$offset++;
			}
			if ($value == 102 && $offset === $start + 1 && $offset < $length && $text[$offset] == 34 && $mode === Scan_Flavor::cpp) {
				$kind = Token_Kind::T_template_string;
				$offset = quoted_token_end($path, $text, $start, $offset, $length, false, true);
			}
		} else if (decimal_byte($value) || ($value == 46 && $offset < $length && decimal_byte($text[$offset]))) {
			$kind = $value == 46 ? Token_Kind::T_floating : Token_Kind::T_integer;
			$radix = ($value == 48 && $offset < $length) ? integer_radix($text[$offset]) : 10;
			if ($radix !== 10) {
				$offset++;
				$digits = $offset;
				while ($offset < $length && integer_digit($text[$offset]) < $radix) { $offset++; }
				if ($offset === $digits) throw new Translation_Diagnostic($path, $start, "Expected integer digits after radix prefix", $text);
			} else {
				while ($offset < $length && decimal_byte($text[$offset])) {
					$offset++;
				}
				if ($value != 46 && $offset < $length && $text[$offset] == 46 && !string_byte_slice_equals($text, $offset, 2, "..")) {
					$kind = Token_Kind::T_floating;
					$offset++;
					while ($offset < $length && decimal_byte($text[$offset])) { $offset++; }
				}
				if ($offset < $length && ($text[$offset] == 69 || $text[$offset] == 101)) {
					$kind = Token_Kind::T_floating;
					$offset++;
					if ($offset < $length && ($text[$offset] == 43 || $text[$offset] == 45)) $offset++;
					if ($offset === $length || !decimal_byte($text[$offset])) throw new Translation_Diagnostic($path, $start, "Expected exponent digits", $text);
					while ($offset < $length && decimal_byte($text[$offset])) { $offset++; }
				}
			}
			if ($offset < $length && (identifier_byte($text[$offset]) || ($radix !== 10 && decimal_byte($text[$offset])) || ($text[$offset] == 46 && !string_byte_slice_equals($text, $offset, 3, "..<")))) {
				throw new Translation_Diagnostic($path, $start, "Unsupported numeric literal", $text);
			}
		} else if ($value == 34 || $value == 39) {
			$kind = $value == 34 ? Token_Kind::T_double_string : Token_Kind::T_single_string;
			$offset = quoted_token_end($path, $text, $start, $start, $length, $python, false);
		} else if ($value == 96 && $mode === Scan_Flavor::js) {
			$kind = Token_Kind::T_template_string;
			$offset = quoted_token_end($path, $text, $start, $start, $length, false, true);
		} else {
			$width = 0;
			$kind = punctuation_at($text, $start, $value, $mode, $width);
			if ($kind === Token_Kind::Unrecognized) throw new Translation_Diagnostic($path, $start, "Unsupported token", $text);
			if ($kind === Token_Kind::Rejected) {
				throw new Translation_Diagnostic($path, $start, "Unsupported punctuation in Python flavor", $text);
			}
			$offset = $start + $width;
		}
		$token Token_Span;
		$token->kind = $kind;
		$token->offset = $start;
		$token->length = $offset - $start;
		$tokens[] = $token;
	}

	$end Token_Span;
	$end->kind = Token_Kind::End;
	$end->offset = $length;
	$end->length = 0;
	$tokens[] = $end;
	return $tokens;
}

// Owns the immutable bytes and token positions addressed by the retained syntax.
final class Translation_Source {
	public readonly string $path;
	public readonly string $text;
	public readonly vector<Token_Span> $tokens;

	public function __construct(string $path, string $text, Scan_Flavor $mode = Scan_Flavor::php) {
		$this->path = $path;
		$this->text = $text;
		$this->tokens = tokenize_source($path, $text, $mode);
	}
}

// A call owns its ordered argument tokens in the same retained source.
final class Call_Syntax {
	public readonly Translation_Source $source;
	public readonly string $name;
	public readonly int $offset;

	public readonly vector<int> $argument_tokens;

	public function __construct(Translation_Source $source, string $name, int $offset, vector<int> $argument_tokens) {
		$this->argument_tokens = $argument_tokens;
		$this->source = $source;
		$this->name = $name;
		$this->offset = $offset;
	}
}

// The collected definition owns the source generation and its completed function.
final class Translation_Scope {
	public readonly Translation_Source $source;
	public readonly Function_Declaration $declaration;

	public function __construct(Translation_Source $source, Function_Declaration $declaration) {
		$declaration->body();
		$this->source = $source;
		$this->declaration = $declaration;
	}

	public function resolve(string $key): ?Function_Declaration {
		if ($this->declaration->symbol_key() === $key) {
			return $this->declaration;
		}
		return null;
	}
}

// The parse cursor consumes tokens from only its own source.
final class Translation_Parser {
	private Translation_Source $source;
	private int $index = 0;

	public function __construct(Translation_Source $source) {
		$this->source = $source;
	}

	private function expect(Token_Kind $kind, string $message): Token_Span {
		$token = $this->source->tokens[$this->index];
		if ($token->kind !== $kind) {
			throw new Translation_Diagnostic($this->source->path, $token->offset, $message, $this->source->text);
		}
		if ($kind !== Token_Kind::End) {
			$this->index++;
		}
		return $token;
	}

	private function spelling(Token_Span $token): string {
		return substr($this->source->text, $token->offset, $token->length);
	}

	private function keyword(string $name): void {
		$message = "Expected " . $name;
		$token = $this->expect(Token_Kind::T_identifier, $message);
		if ($this->spelling($token) !== $name) {
			throw new Translation_Diagnostic($this->source->path, $token->offset, $message, $this->source->text);
		}
	}

	private function name_token(): Token_Span {
		$token = $this->expect(Token_Kind::T_identifier, "Expected function name");
		$name = $this->spelling($token);
		if ($name === "function" || $name === "int" || $name === "return") {
			throw new Translation_Diagnostic($this->source->path, $token->offset, "Expected function name", $this->source->text);
		}
		return $token;
	}

	private function next_list_item(string $role): bool {
		if ($this->source->tokens[$this->index]->kind !== Token_Kind::T_comma) return false;
		$this->index++;
		$next = $this->source->tokens[$this->index];
		if ($next->kind === Token_Kind::T_rparen) {
			throw new Translation_Diagnostic($this->source->path, $next->offset, "Trailing " . $role . " comma is deferred", $this->source->text);
		}
		return true;
	}

	private function call_arguments(): vector<int> {
		$this->expect(Token_Kind::T_lparen, "Expected (");
		$arguments vector<int> = [];
		while ($this->source->tokens[$this->index]->kind !== Token_Kind::T_rparen) {
			$arguments[] = $this->index;
			if ($this->source->tokens[$this->index]->kind === Token_Kind::T_identifier) {
				$this->index++;
				$this->expect(Token_Kind::T_colon, "Expected : after argument label");
			}
			$kind = $this->source->tokens[$this->index]->kind;
			if ($kind === Token_Kind::T_variable) {
				$this->index++;
			} else {
				if ($kind === Token_Kind::T_minus || $kind === Token_Kind::T_plus) $this->index++;
				$this->expect(Token_Kind::T_integer, "Expected integer literal or parameter argument");
			}
			if (!$this->next_list_item("argument")) break;
		}
		$this->expect(Token_Kind::T_rparen, "Expected )");
		return $arguments;
	}

	private function numeric_literal(): void {
		$kind = $this->source->tokens[$this->index]->kind;
		if ($kind === Token_Kind::T_minus || $kind === Token_Kind::T_plus) $this->index++;
		$kind = $this->source->tokens[$this->index]->kind;
		if ($kind !== Token_Kind::T_integer && $kind !== Token_Kind::T_floating) {
			throw new Translation_Diagnostic($this->source->path, $this->source->tokens[$this->index]->offset, "Expected numeric literal", $this->source->text);
		}
		$this->index++;
	}

	private function function_header(): Function_Declaration {
		$start = $this->index;
		$this->keyword("function");
		$name = $this->spelling($this->name_token());
		$this->expect(Token_Kind::T_lparen, "Expected (");
		$parameters vector<Numeric_Parameter> = [];
		$names hash<Numeric_Parameter,string> = [];
		$optional = false;
		while ($this->source->tokens[$this->index]->kind !== Token_Kind::T_rparen) {
			$param_token = $this->expect(Token_Kind::T_identifier, "Expected parameter type");
			$param_word = $this->spelling($param_token);
			$is_float = $param_word === "float" || $param_word === "float64";
			if (!$is_float && $param_word !== "int" && $param_word !== "int64") {
				throw new Translation_Diagnostic($this->source->path, $param_token->offset, "Expected numeric parameter type", $this->source->text);
			}
			$variable = $this->expect(Token_Kind::T_variable, "Expected parameter name");
			$param_name = $this->spelling($variable);
			if (isset($names[$param_name])) throw new Translation_Diagnostic($this->source->path, $variable->offset, "Duplicate parameter: " . $param_name, $this->source->text);
			$default_token = 0;
			if ($this->source->tokens[$this->index]->kind === Token_Kind::T_assign) {
				$this->index++;
				$default_token = $this->index;
				$this->numeric_literal();
				$optional = true;
			} elseif ($optional) {
				throw new Translation_Diagnostic($this->source->path, $variable->offset, "Required parameter after optional parameter", $this->source->text);
			}
			$parameter = new Numeric_Parameter($param_name, $is_float, count($parameters), $default_token);
			$parameters[] = $parameter;
			$names[$param_name] = $parameter;
			if (!$this->next_list_item("parameter")) break;
		}
		$this->expect(Token_Kind::T_rparen, "Expected )");
		$this->expect(Token_Kind::T_colon, "Expected :");
		$type = $this->expect(Token_Kind::T_identifier, "Expected return type");
		$word = $this->spelling($type);
		$floating = $word === "float" || $word === "float64";
		if (!$floating && $word !== "int") throw new Translation_Diagnostic($this->source->path, $type->offset, "Expected int or float", $this->source->text);
		return new Function_Declaration($name, $start, $this->index, new Function_Signature($floating, $parameters, $names));
	}

	private function read_body(): Function_Body {
		$body_start = $this->index;
		$this->expect(Token_Kind::T_lbrace, "Expected {");
		$return_start = $this->index;
		$this->keyword("return");
		$literal = $this->index;
		$calls_function = $this->source->tokens[$literal]->kind === Token_Kind::T_identifier;
		$arguments vector<int> = [];
		if ($calls_function) {
			$this->name_token();
			$arguments = $this->call_arguments();
		} elseif ($this->source->tokens[$literal]->kind === Token_Kind::T_variable) {
			$this->index++;
		} else {
			$this->numeric_literal();
		}
		$this->expect(Token_Kind::T_semicolon, "Expected ;");
		$statement = new Function_Return($return_start, $this->index, $literal, $calls_function, $arguments);
		$this->expect(Token_Kind::T_rbrace, "Expected }");
		return new Function_Body($body_start, $this->index, $statement);
	}

	public function parse_scope(): Translation_Scope {
		return new Translation_Scope($this->source, $this->parse_declaration());
	}

	public function parse_declaration(): Function_Declaration {
		$function = $this->function_header();
		Function_Declaration::complete_body($function, $this->read_body());
		$this->expect(Token_Kind::End, "Expected end of source");
		return $function;
	}

	public function parse_entry(): Call_Syntax {
		$this->keyword("return");
		$name = $this->name_token();
		$arguments = $this->call_arguments();
		$this->expect(Token_Kind::T_semicolon, "Expected ;");
		$this->expect(Token_Kind::End, "Expected end of source");
		return new Call_Syntax($this->source, $this->spelling($name), $name->offset, $arguments);
	}
}

// Merge bytewise-sorted halves to reproduce the project loader's ksort(SORT_STRING).
function order_paths(vector<string> &$paths, vector<string> &$scratch, int $begin, int $end): void {
    if ($end - $begin < 2) return;
    $mid = $begin + (($end - $begin) >> 1);
    order_paths($paths, $scratch, $begin, $mid);
    order_paths($paths, $scratch, $mid, $end);
    $a = $begin;
    $b = $mid;
    for ($i = $begin; $i < $end; $i++) {
        if ($b === $end || ($a < $mid && strcmp($paths[$a], $paths[$b]) <= 0)) {
            $scratch[$i] = $paths[$a];
            $a++;
        } else {
            $scratch[$i] = $paths[$b];
            $b++;
        }
    }
    for ($i = $begin; $i < $end; $i++) { $paths[$i] = $scratch[$i]; }
}
