function assert_translation(bool $condition, string $message): void {
	if (!$condition) {
		throw Exception::make($message);
	}
}

function read_source(string $path): string {
	$result = fs_get($path);
	assert_translation(isset($result), "Cannot read " . $path);
	return $result;
}

function save_generated(string $path, string $text): void {
	$written = fs_put($path, $text);
	assert_translation(isset($written), "Cannot write " . $path);
}

function check_failed_edit(Translation $compiler, string $definition, string $entry): void {
	$old_declaration = $compiler->declaration();
	$old_entry = $compiler->entry_binding();
	$old_output = $compiler->published_output();
	$failed = false;
	try {
		$compiler->compile($definition, $entry);
	} catch (Translation_Diagnostic $error) {
		$failed = true;
		echo $error->path, "\n", $error->offset, "\n", $error->detail, "\n";
	}
	assert_translation($failed, "Expected translated diagnostic");
	assert_translation($compiler->declaration() === $old_declaration, "Failure replaced the declaration");
	assert_translation($compiler->entry_binding() === $old_entry, "Failure replaced the entry binding");
	if ($old_entry !== null) {
		assert_translation($old_entry->symbol->declaration() === $old_declaration, "Failure retargeted the published symbol");
	}
	assert_translation($compiler->published_output() === $old_output, "Failure replaced the published C++");
}

function print_function_ast(Function_Declaration $function): void {
	$body = $function->body();
	$statement = $body->statement;
	assert_translation($body->function_declaration() === $function, "Function body has the wrong parent");
	echo $function->symbol_key(), "|", $function->start, "|", $function->header_end, "|", $function->end(), "|",
		$body->start, "|", $body->end, "|", $statement->start, "|", $statement->end, "|", $statement->literal_token, "\n";
}

function check_reused_body(Function_Declaration $function): void {
	$body = $function->body();
	$other = new Function_Declaration($function->short_name, $function->start, $function->header_end);
	try {
		Function_Declaration::complete_body($other, $body);
		throw Exception::make("Completed a declaration with an attached body");
	} catch (Exception $failure) {
		if ($failure->get_message() !== "Function body is already attached") {
			throw $failure;
		}
	}
	assert_translation($body->function_declaration() === $function, "Failed attachment replaced the parent");
	try {
		$other->body();
		throw Exception::make("Failed attachment completed the declaration");
	} catch (Exception $failure) {
		if ($failure->get_message() !== "Function body is not complete") {
			throw $failure;
		}
	}
}

$definition = read_source("definition.php");
$main = read_source("initial.source");
$bad = read_source("bad.source");
$incomplete = read_source("incomplete.source");
$fixed = read_source("fixed.source");
$updated = read_source("updated.source");
$overflow = read_source("overflow.source");
$unclosed = read_source("unclosed.source");

$compiler = new Translation();
$first = $compiler->compile($definition, $main);
$declaration = $compiler->declaration();
if ($declaration === null) { throw Exception::make("Missing prepared declaration"); }
$initial_entry = $compiler->entry_binding();
if ($initial_entry === null) { throw Exception::make("Missing prepared caller"); }
$table = new Translation_Symbols();
assert_translation($table->find("func:missing") === null, "Lookup allocated a missing name");
$empty = $table->entry("func:missing");
assert_translation($table->find("func:missing") === $empty && $empty->declaration() === null,
	"A known empty symbol was confused with an absent key");
save_generated("initial.cpp", $first);
print_function_ast($declaration->scope->declaration);
check_reused_body($declaration->scope->declaration);

check_failed_edit($compiler, $definition, read_source("invalid-entry.source"));
check_failed_edit($compiler, read_source("invalid-definition.source"), $main);
check_failed_edit($compiler, $definition, read_source("lexical-error.source"));
check_failed_edit($compiler, $definition, $incomplete);
check_failed_edit($compiler, $updated, $bad);
check_failed_edit($compiler, $overflow, $main);

$recovered = $compiler->compile($definition, $fixed);
assert_translation($compiler->declaration() === $declaration, "Recovery prepared an unchanged declaration again");
$fresh = new Translation();
assert_translation($recovered === $fresh->compile($definition, $fixed), "Recovery differs from a fresh compilation");
save_generated("recovered.cpp", $recovered);
$recovered_entry = $compiler->entry_binding();
if ($recovered_entry === null) { throw Exception::make("Recovery did not publish the entry"); }
$old_source = $initial_entry->syntax->source;
$old_name = $old_source->tokens[1];
assert_translation($old_source->text === $main &&
	substr($old_source->text, $old_name->offset, $old_name->length) === "answer_2",
	"Old token lost its spelling after repair");
$fresh_entry = $fresh->entry_binding();
if ($fresh_entry === null) { throw Exception::make("Fresh compiler did not publish the entry"); }
$repaired_source = $recovered_entry->syntax->source;
$fresh_source = $fresh_entry->syntax->source;
assert_translation($repaired_source !== $old_source && $repaired_source->text === $fresh_source->text &&
	count($repaired_source->tokens) === count($fresh_source->tokens), "Wrong source snapshot after repair");
foreach ($fresh_source->tokens as $i => $expected) {
	$actual = $repaired_source->tokens[$i];
	assert_translation($actual->kind === $expected->kind && $actual->offset === $expected->offset &&
		$actual->length === $expected->length, "Repaired token differs from a fresh scan");
}
$symbol = $recovered_entry->symbol;
assert_translation($symbol === $initial_entry->symbol, "Entry edit replaced the symbol for the same key");
assert_translation($recovered_entry->target() === $declaration, "Initial symbol target is wrong");

check_failed_edit($compiler, $unclosed, $fixed);
$next = $compiler->compile($updated, $fixed);
assert_translation($compiler->declaration() !== $declaration, "Changed declaration was reused");
assert_translation($next === (new Translation())->compile($updated, $fixed), "Edited declaration differs from a fresh compilation");
$edited_declaration = $compiler->declaration();
assert_translation($compiler->entry_binding() === $recovered_entry, "Definition edit replaced the unchanged caller binding");
assert_translation($recovered_entry->symbol === $symbol && $recovered_entry->target() === $edited_declaration,
	"Definition edit failed to retarget the retained symbol");
$old_source = $declaration->scope->source;
$old_function = $declaration->scope->declaration;
$old_body = $old_function->body();
$old_span = $old_source->tokens[$old_body->statement->literal_token];
assert_translation($old_body->function_declaration() === $old_function, "Old body parent was replaced");
assert_translation(substr($old_source->text, $old_span->offset, $old_span->length) === "8",
	"An old literal span lost its source snapshot");
assert_translation($recovered_entry->binding_revision() === 0, "Body edit notified the caller");
$symbol->watch($recovered_entry);
$peer = new Prepared_Call($recovered_entry->syntax, $symbol);
$symbol->watch($peer);
$symbol->watch($peer);
save_generated("updated.cpp", $next);

try {
	$compiler->compile(null, $fixed);
	throw Exception::make("Removed declaration still binds");
} catch (Translation_Diagnostic $error) {
	echo $error->path, "\n", $error->offset, "\n", $error->detail, "\n";
}
assert_translation($compiler->entry_binding() === $recovered_entry && $recovered_entry->symbol === $symbol,
	"Deletion replaced the retained entry");
assert_translation($compiler->declaration() === null && $symbol->declaration() === null,
	"Deletion failed to publish a tombstone");
assert_translation($compiler->published_output() === $next, "Deletion replaced the last good output");

assert_translation($recovered_entry->binding_revision() === 1 && $peer->binding_revision() === 1 && $initial_entry->binding_revision() === 0,
	"Withdrawal must notify the active caller once and skip the retired caller");
try {
	$compiler->compile(null, $fixed);
	throw Exception::make("Repeated deletion still binds");
} catch (Translation_Diagnostic $missing) {
	assert_translation($recovered_entry->binding_revision() === 1, "Repeated deletion notified twice");
}

$symbol->forget($peer);
$restored = $compiler->compile($definition, $fixed);
assert_translation($recovered_entry->binding_revision() === 2 && $peer->binding_revision() === 1 && $initial_entry->binding_revision() === 0,
	"Restoration must notify the active caller exactly once");
assert_translation($compiler->declaration() !== $declaration, "Restoration reused the retired declaration");
assert_translation($compiler->entry_binding() === $recovered_entry && $recovered_entry->symbol === $symbol,
	"Restoration replaced the retained entry");
assert_translation($recovered_entry->target() === $compiler->declaration(), "Restoration did not retarget the caller");
assert_translation($restored === (new Translation())->compile($definition, $fixed), "Restoration differs from a fresh build");
assert_translation(substr($old_source->text, $old_span->offset, $old_span->length) === "8",
	"Restoration changed a retained source span");
save_generated("restored.cpp", $restored);
return 0;
