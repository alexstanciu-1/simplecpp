/*
 * Bounded translation of Preparation::function_body, preparation_work and
 * Incremental_Preparation::prepare for one integer-return body per source unit.
 * The frontend supplies the authored return expression and its byte offset.
 */
final class Return_Syntax {
	public string $source;
	public string $function_name;
	public string $integer_spelling;
	public string $callee;
	public int $offset;
	public int $required_parameters = 0;

	public function __construct(string $source, string $function_name, string $integer, string $callee, int $offset) {
		$this->source = $source;
		$this->function_name = $function_name;
		$this->integer_spelling = $integer;
		$this->callee = $callee;
		$this->offset = $offset;
	}
}

final class Preparation_Diagnostic extends Exception {
	public string $source;
	public int $offset;
	public string $detail;

	public function __construct(string $source, int $offset, string $detail) {
		$this->source = $source;
		$this->offset = $offset;
		$this->detail = $detail;
	}
}

// Preparation validates the authored declaration. Lowering consumes the selected implementation.
interface Call_Operand {
	public function operand_name(): string;
}

interface Prepared_Call_Target {
	public function signature(): ?Return_Syntax;
}

interface Body_Call_Target extends Prepared_Call_Target {
	public function implementation(): ?Function_Body;
}

final class Function_Entry implements Body_Call_Target {
	public ?Function_Body $head = null;

	public override function signature(): ?Return_Syntax {
		$head = $this->head;
		if ($head === null) return null;
		return $head->syntax;
	}
	public override function implementation(): ?Function_Body { return $this->head; }
}

// One instance per demanded (authored method, called type) pair.
final class Called_Method_Instance implements Body_Call_Target {
	public Function_Entry $method;
	public ?Function_Body $private_body = null;

	public function __construct(Function_Entry $method, Function_Body $body) {
		$this->method = $method;
		$this->private_body = $body;
	}

	public override function signature(): ?Return_Syntax { return $this->method->signature(); }
	public override function implementation(): ?Function_Body { return $this->private_body; }
}

// Lexical calls validate the callable signature but invoke storage owned by the enclosing body.
final class Lexical_Callable implements Prepared_Call_Target, Call_Operand {
	private Return_Syntax $callable_signature;
	private string $storage;

	public function __construct(Return_Syntax $signature, string $name, int $slot) {
		$this->callable_signature = $signature;
		$this->storage = "var_" . $name . "_" . (string)$slot;
	}
	public override function signature(): ?Return_Syntax { return $this->callable_signature; }
	public override function operand_name(): string { return $this->storage; }
}

final class Function_Body implements Call_Operand {
	public Return_Syntax $syntax;
	public string $native_name;
	private weak<Prepared_Call_Target> $function_symbol;
	private bool $ready = false;
	private hash<Lexical_Callable,string> $callables;

	public override function operand_name(): string { return $this->native_name; }

	public function declare_callable(string $name, int $slot, Return_Syntax $signature): void {
		$this->callables[$name] = new Lexical_Callable($signature, $name, $slot);
	}

	public function prepare_lexical_call(Function_Body $call): void {
		$name = $call->syntax->callee;
		if (!hash_contains($this->callables, $name)) {
			throw new Preparation_Diagnostic($call->syntax->source, $call->syntax->offset, "Unknown local callable");
		}
		$call->settle_preparation($this->callables[$name]);
	}

	public function __construct(Return_Syntax $syntax, string $native_name = "") {
		$this->syntax = $syntax;
		$this->native_name = $native_name === "" ? $syntax->function_name . "_" : $native_name;
	}

	public function settle_preparation(?Prepared_Call_Target $target): void {
		if ($this->ready) {
			throw Exception::make("Function body is already prepared");
		}
		if ($target !== null) {
			$signature = $target->signature();
			if ($signature === null || $signature->required_parameters !== 0) {
				throw new Preparation_Diagnostic($this->syntax->source, $this->syntax->offset, "Argument count mismatch");
			}
			$this->function_symbol = weak($target);
		}
		$this->ready = true;
	}

	public function prepared(): bool {
		return $this->ready;
	}

	public function selected_operand(): ?Call_Operand {
		$entry = lock($this->function_symbol);
		if ($entry === null) return null;
		if ($entry instanceof Call_Operand) return object_cast($entry, Call_Operand::class);
		$target = object_cast($entry, Body_Call_Target::class);
		return $target->implementation();
	}

	public function lower_return(): string {
		if (!$this->ready) {
			throw Exception::make("Function preparation is not complete");
		}
		$expression = $this->syntax->integer_spelling . "LL";
		if ($this->syntax->callee !== "") {
			$callee = $this->selected_operand();
			if ($callee === null) throw Exception::make("Prepared call has no live declaration");
			$expression = $callee->operand_name() . "()";
		}
		return "\treturn " . $expression . ";\n";
	}

	public function lower(): string {
		return "::scpp::int64 " . $this->native_name . "()\n{\n" . $this->lower_return() . "}\n";
	}
}

final class Preparation_Work {
	public hash<Function_Body,string> $pending;
	public hash<Function_Body,string> $emission_sources;

	public function enqueue(Function_Body $body): void {
		$key = $body->syntax->function_name;
		$this->pending[$key] = $body;
		$this->emission_sources[$key] = $body;
	}

	public function complete(Function_Body $body): void {
		$this->pending->remove($body->syntax->function_name);
	}
}

final class Published_Symbols {
	public hash<Function_Entry,string> $functions;
}

final class Preparation {
	public ?Function_Body $owner = null;

	public function function_body(Function_Body $body, Published_Symbols $symbols): void {
		$previous = $this->owner;
		$this->owner = $body;
		try {
			$body->settle_preparation($this->prepare_return($symbols));
		} finally {
			$this->owner = $previous;
		}
	}

	private function prepare_return(Published_Symbols $symbols): ?Prepared_Call_Target {
		$body = $this->owner;
		if ($body === null) {
			throw Exception::make("Preparation requires an active body");
		}
		$syntax = $body->syntax;
		if ($syntax->callee === "") {
			return null;
		}
		if (!hash_contains($symbols->functions, $syntax->callee) || $symbols->functions[$syntax->callee]->head === null) {
			throw new Preparation_Diagnostic($syntax->source, $syntax->offset,
				"Unknown function: " . $syntax->callee);
		}
		return $symbols->functions[$syntax->callee];
	}
}

final class Incremental_Preparation {
	public Preparation_Work $work;
	public Preparation $preparation;
	public Published_Symbols $symbols;
	public hash<string,string> $output;
	public int $prepared = 0;
	public int $reused = 0;
	public int $prepared_before_failure = 0;

	public function __construct() {
		$this->work = new Preparation_Work();
		$this->preparation = new Preparation();
		$this->symbols = new Published_Symbols();
	}

	public function publish_declaration(Return_Syntax $syntax): Function_Body {
		$body = new Function_Body($syntax);
		if (!hash_contains($this->symbols->functions, $syntax->function_name)) {
			$this->symbols->functions[$syntax->function_name] = new Function_Entry();
		}
		$entry = $this->symbols->functions[$syntax->function_name];
		$entry->head = $body;
		$this->work->enqueue($body);
		return $body;
	}

	public function run(): void {
		$this->prepared = 0;
		$this->prepared_before_failure = 0;
		$pending = $this->work->pending;
		$first ?Preparation_Diagnostic = null;
		foreach ($pending as $body) {
			try {
				$this->preparation->function_body($body, $this->symbols);
				$this->work->complete($body);
				$this->prepared++;
			} catch (Preparation_Diagnostic $error) {
				if ($first === null) {
					$this->prepared_before_failure = $this->prepared;
					$first = $error;
				}
			}
		}
		$this->reused = count($this->symbols->functions) - $this->prepared;
		if ($first !== null) {
			throw $first;
		}
		foreach ($this->work->emission_sources as $key => $body) {
			$this->output[$key] = $body->lower();
		}
		$this->work->emission_sources->clear();
	}
}
