// The test supplies the current published strlen descriptor and one already-lowered string operand.
function require_state(bool $valid, string $message): void {
    if (!$valid) throw Exception::make($message);
}

function check_descriptor(Runtime_Descriptor $descriptor, string $argument_cpp, string $parameter_cpp, int $offset): void {
    $compiler = new Incremental_Preparation();
    $compiler->symbols->runtime["strlen"] = $descriptor;
    $syntax = new Return_Syntax("probe.php", "probe", "", "strlen", $offset);
    $syntax->argument_type = "string";
    $syntax->argument_cpp = $argument_cpp;
    $quiet = new Return_Syntax("quiet.php", "quiet", "5", "", 0);
    $caller = $compiler->publish_declaration($syntax);
    $other = $compiler->publish_declaration($quiet);
    $compiler->run();
    require_state($caller->selected_operand() === $descriptor, "builtin descriptor identity");
    $original = $compiler->output["probe"];
    echo $original;

    $source = new Return_Syntax("strlen.php", "strlen", "9", "", 0);
    $source->required_parameters = 1;
    $source->parameter_type = "string";
    $source->parameter_cpp = $parameter_cpp;
    $shadow = $compiler->publish_declaration($source);
    $compiler->run();
    require_state($caller->selected_operand() === $shadow && $compiler->prepared === 2 && $compiler->reused === 1,
        "source shadow did not selectively rebind caller");
    $published = $compiler->output;
    echo $published["strlen"], $published["probe"];

    $bad = new Return_Syntax("strlen.php", "strlen", "9", "", 0);
    $bad->required_parameters = 2;
    $compiler->publish_declaration($bad);
    $rejected = false;
    try {
        $compiler->run();
    } catch (Preparation_Diagnostic $error) {
        $rejected = $error->source === "probe.php" && $error->offset === $offset && $error->detail === "Argument count mismatch";
    }
    require_state($rejected && !$caller->prepared(), "invalid shadow accepted or wrong diagnostic");
    require_state(count($compiler->output) === count($published), "failed edit changed bundle membership");
    foreach ($published as $name => $body) {
        require_state($compiler->output[$name] === $body, "failed edit changed published body");
    }

    $compiler->delete_declaration("strlen");
    $compiler->run();
    require_state($caller->selected_operand() === $descriptor && $compiler->prepared === 1 && $compiler->reused === 1,
        "deletion did not restore the published descriptor");
    require_state($compiler->symbols->functions["quiet"]->head === $other && !hash_contains($compiler->output, "strlen"),
        "recovery replaced sibling or retained deleted output");
    $fresh = new Incremental_Preparation();
    $fresh->symbols->runtime["strlen"] = $descriptor;
    $fresh->publish_declaration($syntax);
    $fresh->publish_declaration($quiet);
    $fresh->run();
    require_state($compiler->output["probe"] === $original && count($fresh->output) === count($compiler->output), "fresh bundle differs");
    foreach ($fresh->output as $name => $body) {
        require_state($compiler->output[$name] === $body, "fresh output differs");
    }
    echo $compiler->output["probe"];
}
