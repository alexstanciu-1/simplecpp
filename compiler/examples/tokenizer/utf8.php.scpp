// Return -1 for valid source, otherwise the byte offset of the first invalid lead.
function source_utf8_error(string $text): int {
    if (string_utf8_is_valid($text)) return -1;
    $size = strlen($text);
    $offset = 0;
    while ($offset < $size) {
        $lead = (int)$text[$offset];
        if ($lead < 128) {
            $offset++;
            continue;
        }
        $length = 0;
        if ($lead >= 194 && $lead <= 223) { $length = 2; }
        else if ($lead >= 224 && $lead <= 239) { $length = 3; }
        else if ($lead >= 240 && $lead <= 244) { $length = 4; }
        else { return $offset; }
        if ($length > $size - $offset) return $offset;
        for ($i = 1; $i < $length; $i++) {
            $byte = $text[$offset + $i];
            if ($byte < 128 || $byte > 191) return $offset;
        }
        $second = $text[$offset + 1];
        if (($lead === 224 && $second < 160) || ($lead === 237 && $second > 159) ||
            ($lead === 240 && $second < 144) || ($lead === 244 && $second > 143)) return $offset;
        $offset += $length;
    }
    throw Exception::make("UTF-8 validation disagrees with byte scan");
}
