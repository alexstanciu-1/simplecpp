$err error;
$caps vector<string> = [];
if (!take($caps, regex_match("/(ab+)-(cd+)/i", "xxAbb-cDDyy"))) {
	echo "MATCH_ERROR\n";
} else {
	echo $caps[0], "\n";
	echo $caps[1], "\n";
	echo $caps[2], "\n";
}
$parts vector<string> = [];
if (!take($parts, regex_split("/,/", "a,b,c"))) {
	echo "SPLIT_ERROR\n";
} else {
	echo implode("|", $parts), "\n";
}
$replaced string = "";
if (!take($replaced, regex_replace("/ab+/i", "X", "ab xx ABB yy"))) {
	echo "REPLACE_ERROR\n";
} else {
	echo $replaced, "\n";
}
