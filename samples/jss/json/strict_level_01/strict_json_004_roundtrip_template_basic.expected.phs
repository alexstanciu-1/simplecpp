function normalize(string $text): void {
	$decoded mixed;
	$jsonError error;
	if (!take($decoded, $jsonError, json_decode($text))) {
		echo "json_error\n";
		return;
	}
	$encoded string = "";
	if (!take($encoded, $jsonError, json_encode($decoded))) {
		echo "encode_error\n";
		return;
	}
	echo "json " . $encoded, "\n";
}
