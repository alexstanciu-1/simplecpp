function assert_translation(bool $condition, string $message): void {
	if (!$condition) {
		throw Exception::make($message);
	}
}

function read_source(string $path): string {
	$result = fs_get($path);
	assert_translation(isset($result), "Cannot read " . $path);
	return $result;
}

function save_generated(string $path, string $text): void {
	$written = fs_put($path, $text);
	assert_translation(isset($written), "Cannot write " . $path);
}

function check_failed_edit(Translation $compiler, string $definition, string $entry): void {
	$old_declaration = $compiler->declaration();
	$old_entry = $compiler->entry_syntax();
	$old_output = $compiler->published_output();
	$failed = false;
	try {
		$compiler->compile($definition, $entry);
	} catch (Translation_Diagnostic $error) {
		$failed = true;
		echo $error->path, "\n", $error->offset, "\n", $error->detail, "\n";
	}
	assert_translation($failed, "Expected translated diagnostic");
	assert_translation($compiler->declaration() === $old_declaration, "Failure replaced the declaration");
	assert_translation($compiler->entry_syntax() === $old_entry, "Failure replaced the entry syntax");
	assert_translation($compiler->published_output() === $old_output, "Failure replaced the published C++");
}

function print_function_ast(Function_Declaration $function): void {
	$body = $function->body();
	$statement = $body->statement;
	assert_translation($body->function_declaration() === $function, "Function body has the wrong parent");
	echo $function->symbol_key(), "|", $function->start, "|", $function->header_end, "|", $function->end(), "|",
		$body->start, "|", $body->end, "|", $statement->start, "|", $statement->end, "|", $statement->literal_token, "\n";
}

function check_reused_body(Function_Declaration $function): void {
	$body = $function->body();
	$other = new Function_Declaration($function->short_name, $function->start, $function->header_end);
	try {
		Function_Declaration::complete_body($other, $body);
		throw Exception::make("Completed a declaration with an attached body");
	} catch (Exception $failure) {
		if ($failure->get_message() !== "Function body is already attached") {
			throw $failure;
		}
	}
	assert_translation($body->function_declaration() === $function, "Failed attachment replaced the parent");
	try {
		$other->body();
		throw Exception::make("Failed attachment completed the declaration");
	} catch (Exception $failure) {
		if ($failure->get_message() !== "Function body is not complete") {
			throw $failure;
		}
	}
}

$definition = read_source("definition.php");
$main = read_source("initial.source");
$bad = read_source("bad.source");
$incomplete = read_source("incomplete.source");
$fixed = read_source("fixed.source");
$updated = read_source("updated.source");
$overflow = read_source("overflow.source");
$unclosed = read_source("unclosed.source");

$compiler = new Translation();
$first = $compiler->compile($definition, $main);
$declaration = $compiler->declaration();
if ($declaration === null) { throw Exception::make("Missing prepared declaration"); }
save_generated("initial.cpp", $first);
print_function_ast($declaration->scope->declaration);
check_reused_body($declaration->scope->declaration);

check_failed_edit($compiler, $definition, $incomplete);
check_failed_edit($compiler, $updated, $bad);
check_failed_edit($compiler, $overflow, $main);

$recovered = $compiler->compile($definition, $fixed);
assert_translation($compiler->declaration() === $declaration, "Recovery prepared an unchanged declaration again");
$fresh = new Translation();
assert_translation($recovered === $fresh->compile($definition, $fixed), "Recovery differs from a fresh compilation");
save_generated("recovered.cpp", $recovered);
$recovered_entry = $compiler->entry_syntax();
assert_translation($recovered_entry !== null, "Recovery did not publish the entry");

check_failed_edit($compiler, $unclosed, $fixed);
$next = $compiler->compile($updated, $fixed);
assert_translation($compiler->declaration() !== $declaration, "Changed declaration was reused");
assert_translation($next === (new Translation())->compile($updated, $fixed), "Edited declaration differs from a fresh compilation");
assert_translation($compiler->entry_syntax() === $recovered_entry, "Definition edit reparsed the unchanged entry");
$old_source = $declaration->scope->source;
$old_function = $declaration->scope->declaration;
$old_body = $old_function->body();
$old_span = $old_source->tokens[$old_body->statement->literal_token];
assert_translation($old_body->function_declaration() === $old_function, "Old body parent was replaced");
assert_translation(substr($old_source->text, $old_span->offset, $old_span->length) === "8",
	"An old literal span lost its source snapshot");
save_generated("updated.cpp", $next);
return 0;
