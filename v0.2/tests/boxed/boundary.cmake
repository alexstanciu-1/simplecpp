file(MAKE_DIRECTORY "${WORK}")
separate_arguments(flags NATIVE_COMMAND "${CXX_FLAGS}")
file(WRITE "${WORK}/header.cpp" "#include \"scpp/boxed.hpp\"\nint main() {}\n")
execute_process(COMMAND ${CXX} ${flags} -std=c++23 -I${GENERATED}/public -E -P ${WORK}/header.cpp OUTPUT_VARIABLE expanded RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR expanded MATCHES "template[ \t\r\n]*<")
  message(FATAL_ERROR "Public boxed closure must be standalone and template-free")
endif()
function(reject name body)
  file(WRITE "${WORK}/${name}.cpp" "#include \"scpp/boxed.hpp\"\nint main() { ${body}; }\n")
  execute_process(COMMAND ${CXX} ${flags} -std=c++23 -I${GENERATED}/public -fsyntax-only ${WORK}/${name}.cpp RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
  if(result EQUAL 0)
    message(FATAL_ERROR "Boxed boundary unexpectedly accepted ${name}")
  endif()
endfunction()
reject(native_integer "auto m = scpp::mixed::from_integer(1)")
reject(native_string "auto m = scpp::mixed::from_string(\"x\")")
reject(native_key "scpp::mixed m; m.set(1, scpp::mixed{})")
reject(cross_construct "scpp::mixed m; scpp::dynamic d{m}")
reject(cross_set "scpp::dynamic d; d.set(scpp::int64{0LL}, scpp::mixed{})")
reject(cross_append "scpp::mixed m; m.append(scpp::dynamic{})")
reject(condition "scpp::mixed m; if(m) {}")
reject(traversal "scpp::mixed m; m.begin()")
reject(subscript "scpp::mixed m; m[scpp::int64{0LL}]")
reject(native_extract "scpp::mixed m; auto v = m.native_value()")
reject(private_storage "scpp::dynamic d; d.storage_[0] = 1")
