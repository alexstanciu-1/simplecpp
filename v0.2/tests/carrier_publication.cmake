file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
file(READ "${PUBLICATION}" publication)
string(JSON publication REMOVE "${publication}" vectors)
string(JSON publication REMOVE "${publication}" string)
string(JSON publication SET "${publication}" types "[\"int32\"]")
string(JSON publication SET "${publication}" values "[\"bool_t\",\"null_t\"]")
string(JSON publication SET "${publication}" operators "[]")
string(JSON publication SET "${publication}" carriers specializations
  "[{\"family\":\"nullable\",\"payload\":\"int32\"}]")
file(WRITE "${WORK}/publication.json" "${publication}")
file(READ "${METADATA}" metadata)
string(JSON metadata SET "${metadata}" carriers extraction "\"explicit_checked_one_layer_value_copy\"")
file(WRITE "${WORK}/metadata.json" "${metadata}")
execute_process(COMMAND "${GENERATOR}" "${WORK}/metadata.json" "${WORK}/publication.json" "${WORK}/generated"
  RESULT_VARIABLE status ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Minimal carrier publication failed: ${errors}")
endif()
file(READ "${WORK}/generated/public/scpp/carriers.hpp" header)
if(header MATCHES "error_t|template[ \t]*<")
  message(FATAL_ERROR "Minimal nullable publication imported unrelated error/template surface")
endif()
file(WRITE "${WORK}/consumer.cpp" "#include <scpp/carriers.hpp>\n#include <type_traits>\nusing namespace scpp;\nstatic_assert(!std::is_convertible_v<nullable_int32,int32>);\nstatic_assert(std::is_constructible_v<int32,nullable_int32>);\nint main(){nullable_int32 x{int32{42}};return static_cast<int32>(x).native_value()==42?0:1;}\n")
separate_arguments(flags NATIVE_COMMAND "${CXX_FLAGS}")
execute_process(COMMAND "${CXX}" ${flags} -std=c++23 "--ld-path=${MOLD_LINKER}"
  "-I${WORK}/generated/public" "-I${SOURCE}/runtime/src/numeric" "-I${SOURCE}/runtime/src/sequence"
  "${WORK}/generated/src/runtime.cpp" "${WORK}/consumer.cpp" -o "${WORK}/consumer"
  RESULT_VARIABLE status ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Minimal carrier compilation failed: ${errors}")
endif()
execute_process(COMMAND "${WORK}/consumer" RESULT_VARIABLE status ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Minimal carrier behavior failed: ${errors}")
endif()
