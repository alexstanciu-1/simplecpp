file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${GENERATOR}" "${METADATA}" "${PUBLICATION}" "${WORK}/a" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Fresh generation failed")
endif()
execute_process(COMMAND "${GENERATOR}" "${METADATA}" "${PUBLICATION}" "${WORK}/b" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Second fresh generation failed")
endif()
file(GLOB_RECURSE files RELATIVE "${WORK}/a" "${WORK}/a/*")
foreach(path IN LISTS files)
  file(SHA256 "${WORK}/a/${path}" a_hash)
  file(SHA256 "${WORK}/b/${path}" b_hash)
  if(NOT a_hash STREQUAL b_hash)
    message(FATAL_ERROR "Nondeterministic output: ${path}")
  endif()
endforeach()
file(APPEND "${WORK}/a/public/scpp/numeric.hpp" "// deliberately stale\n")
file(SHA256 "${WORK}/a/public/scpp/numeric.hpp" before)
execute_process(COMMAND "${GENERATOR}" "${METADATA}" "${PUBLICATION}" "${WORK}/a" --check
  RESULT_VARIABLE status ERROR_VARIABLE errors)
if(status EQUAL 0 OR NOT errors MATCHES "Stale generated file")
  message(FATAL_ERROR "Freshness check failed to reject stale output: ${errors}")
endif()
file(SHA256 "${WORK}/a/public/scpp/numeric.hpp" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Read-only freshness check changed output")
endif()
file(WRITE "${WORK}/bad.json" "{\"version\":1}")
execute_process(COMMAND "${GENERATOR}" "${WORK}/bad.json" "${PUBLICATION}" "${WORK}/invalid"
  RESULT_VARIABLE status)
if(status EQUAL 0 OR EXISTS "${WORK}/invalid")
  message(FATAL_ERROR "Invalid metadata must fail before writing artifacts")
endif()
file(WRITE "${WORK}/b/inventory.json" "[\"obsolete.cpp\"]")
file(WRITE "${WORK}/b/obsolete.cpp" "obsolete")
execute_process(COMMAND "${GENERATOR}" "${METADATA}" "${PUBLICATION}" "${WORK}/b"
  RESULT_VARIABLE status ERROR_VARIABLE errors)
if(NOT status EQUAL 0 OR EXISTS "${WORK}/b/obsolete.cpp")
  message(FATAL_ERROR "Obsolete output was not cleaned: ${errors}")
endif()

# The source default and public alias must move together, without a new wrapper.
file(READ "${METADATA}" alias_metadata)
string(JSON alias_metadata SET "${alias_metadata}" source_types int "\"int32\"")
file(WRITE "${WORK}/alias-metadata.json" "${alias_metadata}")
execute_process(COMMAND "${GENERATOR}" "${WORK}/alias-metadata.json" "${PUBLICATION}" "${WORK}/aliases"
  RESULT_VARIABLE status ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Configured alias generation failed: ${errors}")
endif()
file(WRITE "${WORK}/alias.cpp" "#include <scpp/short_names.hpp>\n#include <type_traits>\nstatic_assert(std::is_same_v<scpp::int_t, scpp::int32>);\nstatic_assert(std::is_same_v<int_t, int32>);\nstatic_assert(std::is_same_v<decltype(int_t{} + int32{}), int32>);\nstatic_assert(std::is_same_v<decltype(int_t{} == int32{}), bool_t>);\n")
separate_arguments(flags NATIVE_COMMAND "${CXX_FLAGS}")
execute_process(COMMAND "${CXX}" ${flags} -std=c++23 "-I${WORK}/aliases/public"
  -fsyntax-only "${WORK}/alias.cpp" RESULT_VARIABLE status ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Configured aliases failed to compose: ${errors}")
endif()
