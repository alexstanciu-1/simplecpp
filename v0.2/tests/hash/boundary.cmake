file(MAKE_DIRECTORY "${WORK}")
separate_arguments(flags NATIVE_COMMAND "${CXX_FLAGS}")
file(WRITE "${WORK}/header.cpp" "#include \"scpp/hashes.hpp\"\nint main() {}\n")
execute_process(COMMAND ${CXX} ${flags} -std=c++23 -I${GENERATED}/public -E -P ${WORK}/header.cpp OUTPUT_VARIABLE expanded RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR expanded MATCHES "template[ \t\r\n]*<")
  message(FATAL_ERROR "Public hash header must be standalone and template-free")
endif()
function(reject name body)
  file(WRITE "${WORK}/${name}.cpp" "#include \"scpp/hashes.hpp\"\nint main() { ${body}; }\n")
  execute_process(COMMAND ${CXX} ${flags} -std=c++23 -I${GENERATED}/public -fsyntax-only ${WORK}/${name}.cpp RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
  if(result EQUAL 0)
    message(FATAL_ERROR "Hash boundary unexpectedly accepted ${name}")
  endif()
endfunction()
reject(native_key "scpp::hash_int64_int64 h; h.set(1,scpp::int64{2})")
reject(native_string "scpp::hash_int64_string h; h.set(\"12\",scpp::int64{2})")
reject(string_append "scpp::hash_int64_string h; h.append(scpp::int64{2})")
reject(traversal "scpp::hash_int64_int64 h; h.begin()")
reject(subscript "scpp::hash_int64_int64 h; h[scpp::int64{1}]")
reject(condition "scpp::hash_int64_int64 h; if(h) {}")
