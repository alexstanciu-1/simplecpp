file(MAKE_DIRECTORY "${WORK}")
separate_arguments(flags NATIVE_COMMAND "${CXX_FLAGS}")
file(WRITE "${WORK}/header.cpp" "#include \"scpp/carriers.hpp\"\nint main() {}\n")
execute_process(COMMAND ${CXX} ${flags} -std=c++23 -I${GENERATED}/public -E -P ${WORK}/header.cpp OUTPUT_VARIABLE expanded RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR expanded MATCHES "template[ \t\r\n]*<")
  message(FATAL_ERROR "Boxed result include closure must be standalone and template-free")
endif()
function(reject name body)
  file(WRITE "${WORK}/${name}.cpp" "#include \"scpp/carriers.hpp\"\nint main() { ${body}; }\n")
  execute_process(COMMAND ${CXX} ${flags} -std=c++23 -I${GENERATED}/public -fsyntax-only ${WORK}/${name}.cpp RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
  if(result EQUAL 0)
    message(FATAL_ERROR "Boxed result boundary unexpectedly accepted ${name}")
  endif()
endfunction()
reject(native "scpp::result_mixed r{1}")
reject(cross_payload "scpp::result_mixed r{scpp::dynamic{}}")
reject(cross_carrier "scpp::result_dynamic d; scpp::result_mixed m{d}")
reject(condition "scpp::result_dynamic r; if(r) {}")
reject(delegation "scpp::result_dynamic r; r.set(scpp::int64{0LL}, scpp::dynamic{})")
reject(reference "scpp::result_mixed r; scpp::mixed& m = r.value()")
reject(unrequested "scpp::nullable_dynamic r")
