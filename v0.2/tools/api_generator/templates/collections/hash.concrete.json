{
  "hash_key": "k",
  "parameters": {
    "k": {"alias": "key_type", "requires": ["copy_constructible", "nothrow_move_constructible", "nothrow_move_assignable", "nothrow_destructible"]},
    "v": {"alias": "value_type", "requires": ["copy_constructible", "nothrow_move_constructible", "nothrow_move_assignable", "nothrow_destructible"]}
  },
  "fragments": {
    "storage": ["collections/hash_table"],
    "lifecycle": ["core/concrete_owner_lifecycle"],
    "declaration": ["core/lifecycle_declaration", "collections/hash_value_methods_declaration", {"template": "collections/hash_shared_lookup_declaration", "when": "enable_shared_lookup"}],
    "definition": ["collections/hash_methods_definition", {"template": "collections/hash_shared_lookup_definition", "when": "enable_shared_lookup"}],
    "output_declaration": ["collections/hash_iteration_output", "core/iteration_output", "collections/hash_output_declaration"],
    "output_definition": ["collections/hash_output_iteration"],
    "append_declaration": [{"template": "collections/hash_append_declaration", "when": "enable_append"}],
    "append_definition": [{"template": "collections/hash_append_definition", "when": "enable_append"}]
  },
  "application": "collections/hash_application",
  "support": ["hash/concrete_index.hpp"],
  "includes": ["new", "stdexcept", "cstring"]
}
