/build/
/runtime/generated/
/out/
/cmake-build-*/

# In-source CMake/Ninja/CTest output (use the build presets instead).
build.ninja
rules.ninja
.ninja_deps
.ninja_log
CTestTestfile.cmake
DartConfiguration.tcl
Testing/

# Machine-local configuration and disposable instrumentation output.
CMakeUserPresets.json
*.profraw
*.profdata
*.gcda
*.gcno
/coverage/

# Published dependency snapshots, if introduced by the compiler build.
/compiler/dependencies/
.scpp-token-cache/
.scpp-portability-index.json

# Cargo output at workspace or individual package roots, including rustdoc,
# incremental caches, build-script output, benchmarks and packaged crates.
target/

# Rust artifacts produced outside Cargo's normal target directory.
*.rlib
*.rmeta
*.crate
*.pdb
*.dylib
**/*.rs.bk

# Repository-local Cargo/rustup homes: caches, installed tools and credentials.
# Keep .cargo/config.toml, Cargo.lock and rust-toolchain.toml tracked.
**/.cargo/registry/
**/.cargo/git/
**/.cargo/bin/
**/.cargo/.package-cache*
**/.cargo/.global-cache*
**/.cargo/.crates.toml
**/.cargo/.crates2.json
**/.cargo/credentials
**/.cargo/credentials.toml
**/.cargo/env
.rustup/
