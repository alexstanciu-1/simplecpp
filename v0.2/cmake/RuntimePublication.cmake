# Build profiles select explicit API demand. PHP remains the policy/dependency owner.
set(runtime_publication ${CMAKE_CURRENT_SOURCE_DIR}/runtime/metadata/publication.json)
set(runtime_generated ${CMAKE_CURRENT_BINARY_DIR}/generated)
option(SCPP_ENABLE_NUMERIC "Enable additional fixed-width integer demand" OFF)
option(SCPP_ENABLE_DATETIME "Publish and build the bounded datetime module" OFF)
option(SCPP_ENABLE_JSON "Publish and build the bounded JSON module" OFF)
if(SCPP_ENABLE_NUMERIC OR SCPP_ENABLE_DATETIME OR SCPP_ENABLE_JSON)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${runtime_publication})
  file(READ ${runtime_publication} runtime_profile)
  set(profile_name "")
  if(SCPP_ENABLE_NUMERIC OR SCPP_ENABLE_DATETIME)
    string(JSON runtime_profile SET "${runtime_profile}" modules "[\"numeric\"]")
  endif()
  if(SCPP_ENABLE_NUMERIC)
    set(request ${CMAKE_CURRENT_SOURCE_DIR}/runtime/metadata/numeric_publication.json)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${request})
    file(READ ${request} numeric_request)
    foreach(section types operators)
      string(JSON count LENGTH "${runtime_profile}" ${section})
      string(JSON incoming LENGTH "${numeric_request}" ${section})
      if(incoming EQUAL 0)
        continue()
      endif()
      math(EXPR last "${incoming} - 1")
      foreach(index RANGE 0 ${last})
        string(JSON item GET "${numeric_request}" ${section} ${index})
        if(section STREQUAL "types")
          set(item "\"${item}\"")
        endif()
        string(JSON runtime_profile SET "${runtime_profile}" ${section} ${count} "${item}")
        math(EXPR count "${count} + 1")
      endforeach()
    endforeach()
    string(JSON count LENGTH "${runtime_profile}" string casts)
    string(JSON incoming LENGTH "${numeric_request}" string_casts)
    if(incoming GREATER 0)
      math(EXPR last "${incoming} - 1")
      foreach(index RANGE 0 ${last})
        string(JSON item GET "${numeric_request}" string_casts ${index})
        string(JSON runtime_profile SET "${runtime_profile}" string casts ${count} "\"${item}\"")
        math(EXPR count "${count} + 1")
      endforeach()
    endif()
    string(APPEND profile_name "-numeric")
  endif()
  if(SCPP_ENABLE_DATETIME)
    set(request ${CMAKE_CURRENT_SOURCE_DIR}/runtime/metadata/datetime_publication.json)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${request})
    file(READ ${request} module_request)
    string(JSON count LENGTH "${runtime_profile}" types)
    string(JSON runtime_profile SET "${runtime_profile}" types ${count} "\"uint64\"")
    string(JSON runtime_profile SET "${runtime_profile}" datetime "${module_request}")
    string(APPEND profile_name "-datetime")
  endif()
  if(SCPP_ENABLE_JSON)
    set(request ${CMAKE_CURRENT_SOURCE_DIR}/runtime/metadata/json_publication.json)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${request})
    file(READ ${request} module_request)
    foreach(section boxed json)
      string(JSON section_request GET "${module_request}" ${section})
      string(JSON runtime_profile SET "${runtime_profile}" ${section} "${section_request}")
    endforeach()
    # Core already publishes result_string; JSON additionally needs these payloads.
    string(JSON count LENGTH "${runtime_profile}" carriers specializations)
    foreach(family mixed dynamic)
      string(JSON runtime_profile SET "${runtime_profile}" carriers specializations ${count}
        "{\"family\":\"result\",\"payload\":\"${family}\"}")
      math(EXPR count "${count} + 1")
    endforeach()
    # The base profile already has the other three nullable scalar payloads.
    string(JSON runtime_profile SET "${runtime_profile}" carriers specializations ${count}
      "{\"family\":\"nullable\",\"payload\":\"float64\"}")
    string(APPEND profile_name "-json")
  endif()
  set(runtime_publication ${CMAKE_CURRENT_BINARY_DIR}/publication${profile_name}.json)
  file(CONFIGURE OUTPUT ${runtime_publication} CONTENT "${runtime_profile}\n" @ONLY)
  # The publisher fully regenerates this dedicated directory when demand changes.
endif()
