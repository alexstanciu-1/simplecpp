function check_credit_workflow(WorkloadChecks $checks): void {
    $desk CreditDesk = new CreditDesk();
    $customer CustomerProfile = sample_customer_profile();
    $customer->credit_limit = 20000;
    $customer->exposure = 0;
    $checks->accepted($desk->add_customer($customer), "credit registration");
    $customer->credit_limit = 1;
    $saved CustomerProfile = $desk->customer("CUS-001");
    $checks->equal($saved->credit_limit, 20000, "credit owns registration snapshot");
    $saved->credit_limit = 2;
    $checks->equal($desk->customer("CUS-001")->credit_limit, 20000, "credit protects query snapshot");
    $checks->accepted($desk->reserve("CUS-001", "ORDER-A", 7000), "credit first reservation");
    $checks->accepted($desk->reserve("CUS-001", "ORDER-B", 8000), "credit second reservation");
    $checks->equal($desk->customer("CUS-001")->available_credit(), 5000, "credit available after commitments");
    $checks->rejected($desk->reserve("CUS-001", "ORDER-A", 1), "credit.reference", "credit duplicate reference");
    $checks->rejected($desk->reserve("CUS-001", "ORDER-C", 5001), "credit.limit", "credit over limit");
    $checks->rejected($desk->reserve("MISSING", "ORDER-C", 1), "credit.customer", "credit missing customer");
    $checks->rejected($desk->reserve("CUS-001", "", 1), "credit.request", "credit missing reference");
    $checks->rejected($desk->reserve("CUS-001", "ORDER-C", 0), "credit.request", "credit zero reservation");
    $checks->accepted($desk->hold("CUS-001", true), "credit activate hold");
    $checks->rejected($desk->reserve("CUS-001", "ORDER-C", 1), "credit.hold", "credit hold blocks commitments");
    $checks->accepted($desk->release("ORDER-A"), "credit release permitted on hold");
    $checks->rejected($desk->release("ORDER-A"), "credit.released", "credit double release");
    $checks->equal($desk->customer("CUS-001")->exposure, 8000, "credit rejected operations preserve exposure");
    $checks->accepted($desk->hold("CUS-001", false), "credit release hold");
    $checks->accepted($desk->reserve("CUS-001", "ORDER-C", 12000), "credit exact limit");
    $checks->equal($desk->customer("CUS-001")->available_credit(), 0, "credit ceiling reached");
    $checks->accepted($desk->reconcile(), "credit commitment control");
}

function check_procurement_workflow(WorkloadChecks $checks): void {
    $ledger GeneralLedger = setup_accounting_ledger($checks);
    $desk ProcurementDesk = new ProcurementDesk();
    $order PurchaseOrderLine = sample_purchase_order_line();
    $order->received = 0;
    $order->returned = 0;
    $order->invoiced = 0;
    $checks->accepted($desk->order($order), "procurement approved order");
    $checks->rejected($desk->order($order), "procurement.duplicate", "procurement duplicate order");
    $order->unit_cost = 1;
    $checks->equal($desk->order_snapshot("PO-L1")->unit_cost, 500, "procurement owned order");
    $receipt GoodsReceiptLine = sample_goods_receipt_line();
    $receipt->matched = 0;
    $checks->accepted($desk->receive($ledger, $receipt), "procurement inspected receipt");
    $checks->equal($ledger->balance_of("inventory"), 5000, "procurement receipt inventory");
    $checks->equal($desk->order_snapshot("PO-L1")->received, 10, "procurement accepted quantity");
    $checks->rejected($desk->receive($ledger, $receipt), "procurement.receipt-duplicate", "procurement duplicate receipt");
    $receipt->unit_cost = 999;
    $checks->equal($desk->receipt_snapshot("GR-L1")->unit_cost, 500, "procurement receipt snapshot");
    $match SupplierInvoiceMatch = sample_supplier_invoice_match();
    $match->approved = true;
    $match->tolerance_amount = 59;
    $checks->rejected($desk->match_invoice($ledger, $match), "procurement.price", "procurement exact price tolerance rejection");
    $checks->equal($ledger->entry_count(), 1, "procurement rejected match writes no journal");
    $checks->equal($desk->receipt_snapshot("GR-L1")->matched, 0, "procurement rejected match preserves quantity");
    $match->tolerance_amount = 60;
    $checks->accepted($desk->match_invoice($ledger, $match), "procurement three-way match");
    $checks->equal($ledger->balance_of("payables"), -3660, "procurement invoice liability");
    $checks->equal($ledger->balance_of("input-tax"), 600, "procurement input tax component");
    $checks->equal($ledger->balance_of("operating-expense"), 60, "procurement price variance");
    $checks->equal($desk->unmatched_value(), 2000, "procurement unmatched receipt value");
    $checks->rejected($desk->match_invoice($ledger, $match), "procurement.match-duplicate", "procurement repeated invoice");
    $returned_goods SupplierReturn = sample_supplier_return();
    $returned_goods->receipt_id = "GR-L1";
    $returned_goods->authorized_quantity = 2;
    $returned_goods->dispatched_quantity = 2;
    $returned_goods->credited_quantity = 0;
    $checks->accepted($desk->return_unmatched($ledger, $returned_goods), "procurement unmatched return");
    $checks->equal($ledger->balance_of("inventory"), 4000, "procurement stock after return");
    $checks->equal($desk->unmatched_value(), 1000, "procurement receipt accrual after return");
    $checks->equal($ledger->balance_of("goods-received"), -1000, "procurement receipt control reconciles");
    $checks->equal($desk->order_snapshot("PO-L1")->returned, 2, "procurement returned quantity");
    $checks->rejected($desk->return_unmatched($ledger, $returned_goods), "procurement.return-duplicate", "procurement repeated return");
    $returned_goods->id = "RTV-002";
    $returned_goods->authorized_quantity = 3;
    $returned_goods->dispatched_quantity = 3;
    $checks->rejected($desk->return_unmatched($ledger, $returned_goods), "procurement.return-quantity", "procurement cannot return matched stock");
    $checks->expect($ledger->trial_balance()->is_balanced(), "procurement balanced postings");
}

function check_expense_workflow(WorkloadChecks $checks): void {
    $ledger GeneralLedger = setup_accounting_ledger($checks);
    $desk ExpenseDesk = new ExpenseDesk();
    $employee EmployeeProfile = sample_employee_profile();
    $employee->open_advance = 0;
    $checks->accepted($desk->add_employee($employee), "expense employee register");
    $advance EmployeeAdvance = sample_employee_advance();
    $advance->receipts_settled = 0;
    $advance->cash_returned = 0;
    $checks->accepted($desk->issue($ledger, $advance), "expense advance payment");
    $checks->equal($ledger->balance_of("prepayments"), 10000, "expense advance control");
    $checks->equal($ledger->balance_of("bank"), -10000, "expense advance bank outflow");
    $advance->paid = 1;
    $checks->equal($desk->advance("ADV-001")->paid, 10000, "expense owned advance snapshot");
    $claim ExpenseClaimLine = sample_expense_claim_line();
    $claim->gross_amount = 7000;
    $claim->personal_amount = 0;
    $claim->recoverable_tax = 1000;
    $claim->approved_amount = 6000;
    $claim->receipt_present = false;
    $checks->rejected($desk->settle($ledger, "ADV-001", $claim), "expense.claim-identity", "expense missing receipt");
    $checks->equal($ledger->entry_count(), 1, "expense rejected claim is atomic");
    $claim->receipt_present = true;
    $checks->accepted($desk->settle($ledger, "ADV-001", $claim), "expense approved partial claim");
    $checks->equal($ledger->balance_of("operating-expense"), 5000, "expense approved net");
    $checks->equal($ledger->balance_of("input-tax"), 1000, "expense tax component");
    $checks->equal($desk->employee("EMP-001")->open_advance, 4000, "expense employee outstanding");
    $checks->rejected($desk->close("ADV-001"), "expense.close", "expense uncleared advance cannot close");
    $checks->rejected($desk->refund($ledger, "ADV-001", "REFUND-1", 4001), "expense.refund", "expense excessive refund");
    $checks->accepted($desk->refund($ledger, "ADV-001", "REFUND-1", 4000), "expense exact cash return");
    $checks->accepted($desk->close("ADV-001"), "expense close cleared advance");
    $checks->rejected($desk->close("ADV-001"), "expense.close", "expense double close");
    $checks->equal($desk->employee("EMP-001")->open_advance, 0, "expense employee control cleared");
    $checks->equal($ledger->balance_of("prepayments"), 0, "expense ledger advance cleared");
    $checks->equal($ledger->balance_of("bank"), -6000, "expense final bank outflow");
    $checks->expect($ledger->trial_balance()->is_balanced(), "expense balanced postings");
}

function check_payroll_workflow(WorkloadChecks $checks): void {
    $ledger GeneralLedger = setup_accounting_ledger($checks);
    $desk PayrollDesk = new PayrollDesk();
    $employee EmployeeProfile = sample_employee_profile();
    $run PayrollInstruction = sample_payroll_instruction();
    $employee->payment_hold = true;
    $checks->rejected($desk->accrue($ledger, $employee, $run), "payroll.employee", "payroll employee hold");
    $employee->payment_hold = false;
    $checks->accepted($desk->accrue($ledger, $employee, $run), "payroll explicit gross and charges");
    $checks->equal($ledger->balance_of("operating-expense"), 135000, "payroll total employer cost");
    $checks->equal($ledger->balance_of("payables"), -100000, "payroll net liability");
    $checks->equal($ledger->balance_of("tax-payable"), -35000, "payroll explicit deductions and employer charge");
    $run->base_pay = 1;
    $checks->equal($desk->snapshot("PR-001")->base_pay, 100000, "payroll owns accepted terms");
    $checks->rejected($desk->pay($ledger, "PR-001", "payroll:PR-001"), "journal.duplicate", "payroll failed bank post");
    $checks->expect(!$desk->snapshot("PR-001")->paid, "payroll failure does not settle wages");
    $checks->accepted($desk->pay($ledger, "PR-001", "NET-1"), "payroll net payment");
    $checks->accepted($desk->remit($ledger, "PR-001", "TAX-1"), "payroll remittance");
    $checks->rejected($desk->pay($ledger, "PR-001", "NET-2"), "payroll.paid", "payroll no double wages");
    $checks->rejected($desk->remit($ledger, "PR-001", "TAX-2"), "payroll.remitted", "payroll no double remittance");
    $checks->equal($ledger->balance_of("payables"), 0, "payroll wage control cleared");
    $checks->equal($ledger->balance_of("tax-payable"), 0, "payroll deduction control cleared");
    $checks->equal($ledger->balance_of("bank"), -135000, "payroll cash matches employer cost");
    $checks->expect($ledger->trial_balance()->is_balanced(), "payroll balanced postings");
}

function check_treasury_workflow(WorkloadChecks $checks): void {
    $ledger GeneralLedger = setup_accounting_ledger($checks);
    $desk TreasuryDesk = new TreasuryDesk();
    $loan LoanAgreement = sample_loan_agreement();
    $loan->drawn_principal = 0;
    $loan->repaid_principal = 0;
    $checks->accepted($desk->add_loan($loan), "treasury fresh facility");
    $checks->accepted($desk->draw($ledger, "LOAN-001", "DRAW-1", 300000), "treasury draw");
    $checks->rejected($desk->draw($ledger, "LOAN-001", "DRAW-2", 200001), "treasury.facility", "treasury facility ceiling");
    $checks->accepted($desk->accrue_interest($ledger, "LOAN-001"), "treasury first period interest");
    $checks->rejected($desk->accrue_interest($ledger, "LOAN-001"), "treasury.interest-period", "treasury no double period accrual");
    $checks->equal($ledger->balance_of("accruals"), -303000, "treasury principal plus interest liability");
    $checks->accepted($desk->pay_interest($ledger, "LOAN-001", "INT-PAY"), "treasury interest payment");
    $checks->accepted($desk->repay($ledger, "LOAN-001", "PRINCIPAL-PAY", 50000), "treasury principal repayment");
    $checks->equal($desk->snapshot("LOAN-001")->principal_outstanding(), 250000, "treasury remaining principal");
    $checks->equal($ledger->balance_of("bank"), 247000, "treasury loan cash flow");
    $checks->accepted($ledger->close_period(1), "treasury next period");
    $checks->accepted($desk->accrue_interest($ledger, "LOAN-001"), "treasury reduced principal interest");
    $checks->equal($ledger->balance_of("operating-expense"), 5500, "treasury independent two-period interest");
    $quote ExchangeRateQuote = sample_exchange_rate_quote();
    $converted AmountResult = $desk->convert($quote, 10000);
    $checks->expect($converted->valid, "treasury rational quote accepted");
    $checks->equal($converted->amount, 12500, "treasury rational quote amount");
    $quote->numerator = 1;
    $quote->denominator = 2;
    $checks->equal($desk->convert($quote, -5)->amount, -3, "treasury negative half rounds away");
    $checks->expect(!$desk->convert($quote, 1000001)->valid, "treasury foreign amount ceiling");
    $checks->expect(!document_ratio(1000000000, 1000000, 1)->valid, "treasury conversion overflow");
    $checks->accepted(document_post($ledger, "FX-OPEN", "foreign-invoice", "inventory", "payables", 12000), "treasury opening foreign carrying value");
    $settlement ForeignSettlement = sample_foreign_settlement();
    $settlement->period = 2;
    $checks->accepted($desk->settle_foreign($ledger, $settlement), "treasury exchange loss settlement");
    $checks->equal($ledger->balance_of("payables"), -4800, "treasury remaining carrying liability");
    $checks->equal($ledger->balance_of("operating-expense"), 5800, "treasury realized loss separately posted");
    $checks->rejected($desk->settle_foreign($ledger, $settlement), "treasury.settled", "treasury repeated settlement");
    $checks->expect($ledger->trial_balance()->is_balanced(), "treasury balanced postings");
}

function check_project_workflow(WorkloadChecks $checks): void {
    $ledger GeneralLedger = setup_accounting_ledger($checks);
    $desk ProjectDesk = new ProjectDesk();
    $project ProjectBudget = sample_project_budget();
    $project->cost_actual = 0;
    $project->cost_committed = 0;
    $project->billed = 0;
    $checks->accepted($desk->add_project($project), "project fresh budget");
    $time TimeSheetLine = sample_time_sheet_line();
    $checks->accepted($desk->post_time($ledger, $time), "project approved time");
    $checks->equal($desk->snapshot("JOB-001")->cost_actual, 24000, "project eight hours at cost");
    $checks->equal($ledger->balance_of("accruals"), -24000, "project labor liability");
    $checks->rejected($desk->post_time($ledger, $time), "project.time-duplicate", "project repeated timesheet");
    $time->id = "TIME-L2";
    $time->cost_per_hour = 1000000;
    $checks->rejected($desk->post_time($ledger, $time), "project.budget", "project budget gate");
    $checks->equal($desk->snapshot("JOB-001")->cost_actual, 24000, "project rejection preserves cost");
    $milestone ProjectMilestone = sample_project_milestone();
    $milestone->invoiced_amount = 0;
    $milestone->recognized_amount = 0;
    $milestone->completion_basis_points = 0;
    $checks->accepted($desk->bill($ledger, $milestone), "project milestone invoice");
    $checks->equal($ledger->balance_of("receivables"), 100000, "project billed receivable");
    $checks->equal($ledger->balance_of("revenue"), 0, "project invoice does not prematurely earn revenue");
    $checks->accepted($desk->recognize($ledger, "MS-001", "REV-1", 4000), "project partial earned revenue");
    $checks->equal($ledger->balance_of("revenue"), -40000, "project recognized revenue");
    $checks->equal($desk->milestone("MS-001")->unrecognized_amount(), 60000, "project deferred portion");
    $checks->rejected($desk->recognize($ledger, "MS-001", "REV-BACK", 3000), "project.progress", "project no backwards progress");
    $checks->rejected($desk->recognize($ledger, "MS-001", "REV-1", 10000), "journal.duplicate", "project failed recognition reference");
    $checks->equal($desk->milestone("MS-001")->recognized_amount, 40000, "project failed recognition is atomic");
    $checks->accepted($desk->recognize($ledger, "MS-001", "REV-2", 10000), "project complete recognition");
    $checks->equal($ledger->balance_of("revenue"), -100000, "project full revenue");
    $checks->equal($ledger->balance_of("accruals"), -24000, "project only labor accrual remains");
    $checks->expect($ledger->trial_balance()->is_balanced(), "project balanced postings");
}

function check_warehouse_workflow(WorkloadChecks $checks): void {
    $ledger GeneralLedger = setup_accounting_ledger($checks);
    $desk WarehouseDesk = new WarehouseDesk();
    $first WarehouseLocation = sample_warehouse_location();
    $first->id = "MAIN-A";
    $first->occupied = 0;
    $first->reserved_capacity = 0;
    $second WarehouseLocation = $first->copy();
    $second->id = "MAIN-B";
    $checks->accepted($desk->add_location($first), "warehouse first location");
    $checks->accepted($desk->add_location($second), "warehouse second location");
    $checks->accepted($desk->receive($ledger, "MAIN-A", "PART-A", "WH-RECEIPT", 20, 500), "warehouse receive");
    $checks->rejected($desk->receive($ledger, "MAIN-A", "PART-A", "WH-WRONG-COST", 1, 501), "warehouse.cost", "warehouse fixed cost gate");
    $transfer WarehouseTransfer = sample_warehouse_transfer();
    $transfer->requested = 8;
    $transfer->dispatched = 8;
    $transfer->received = 8;
    $transfer->loss_quantity = 0;
    $checks->accepted($desk->transfer($transfer), "warehouse internal transfer");
    $checks->equal($desk->quantity("MAIN-A", "PART-A"), 12, "warehouse source decreases");
    $checks->equal($desk->quantity("MAIN-B", "PART-A"), 8, "warehouse target increases");
    $checks->equal($ledger->entry_count(), 1, "warehouse same-control transfer has no ledger movement");
    $checks->equal($desk->value(), 10000, "warehouse transfer conserves carrying value");
    $checks->rejected($desk->transfer($transfer), "warehouse.transfer-duplicate", "warehouse no duplicate movement");
    $transfer->id = "TR-002";
    $transfer->requested = 13;
    $transfer->dispatched = 13;
    $transfer->received = 13;
    $checks->rejected($desk->transfer($transfer), "warehouse.transfer-quantity", "warehouse overship rejection");
    $count StockCountLine = sample_stock_count_line();
    $count->location = "MAIN-B";
    $count->book_quantity = 8;
    $count->counted_quantity = 6;
    $count->recounted = false;
    $checks->rejected($desk->count_stock($ledger, $count), "warehouse.recount", "warehouse material count requires recount");
    $checks->equal($desk->quantity("MAIN-B", "PART-A"), 8, "warehouse rejected count leaves quantity");
    $count->recounted = true;
    $checks->accepted($desk->count_stock($ledger, $count), "warehouse verified count loss");
    $checks->equal($desk->quantity("MAIN-B", "PART-A"), 6, "warehouse adjusted count");
    $checks->equal($desk->value(), 9000, "warehouse subledger value after loss");
    $checks->equal($ledger->balance_of("inventory"), 9000, "warehouse ledger value reconciles");
    $checks->equal($ledger->balance_of("cost-of-sales"), 1000, "warehouse shrinkage expense");
    $checks->rejected($desk->count_stock($ledger, $count), "warehouse.count-duplicate", "warehouse duplicate count");
    $checks->expect($ledger->trial_balance()->is_balanced(), "warehouse balanced postings");
}

function check_allocation_workflow(WorkloadChecks $checks): void {
    $ledger GeneralLedger = setup_accounting_ledger($checks);
    $desk AllocationDesk = new AllocationDesk();
    $operations DepartmentBudget = sample_department_budget();
    $operations->actual_amount = 0;
    $operations->committed_amount = 0;
    $operations->transferred_in = 0;
    $operations->transferred_out = 0;
    $sales DepartmentBudget = $operations->copy();
    $sales->id = "BUD-SALES";
    $sales->department = "SALES";
    $checks->accepted($desk->add_budget($operations), "allocation operations budget");
    $checks->accepted($desk->add_budget($sales), "allocation sales budget");
    $first AllocationDriver = sample_allocation_driver();
    $first->assigned_amount = 0;
    $first->weight = 1;
    $first->total_weight = 3;
    $first->pool_amount = 10001;
    $second AllocationDriver = $first->copy();
    $second->id = "DRIVER-002";
    $second->department = "SALES";
    $second->weight = 2;
    $second->rank = 2;
    $drivers vector<AllocationDriver> = [$first, $second];
    $checks->accepted(document_post($ledger, "POOL-OPEN", "cost-pool", "operating-expense", "bank", 10001), "allocation source pool");
    $checks->accepted($desk->allocate($ledger, "ALLOC-RUN", $drivers), "allocation weighted cost distribution");
    $checks->equal($desk->driver("DRIVER-001")->assigned_amount, 3334, "allocation largest remainder first share");
    $checks->equal($desk->driver("DRIVER-002")->assigned_amount, 6667, "allocation second share");
    $checks->equal($desk->budget("OPS")->actual_amount, 3334, "allocation operations budget actual");
    $checks->equal($desk->budget("SALES")->actual_amount, 6667, "allocation sales budget actual");
    $checks->equal($ledger->balance_of("operating-expense"), 0, "allocation source cleared");
    $checks->equal($ledger->balance_of("cost-of-sales"), 10001, "allocation exact target total");
    $first->weight = 3;
    $checks->equal($desk->driver("DRIVER-001")->weight, 1, "allocation owns accepted driver");
    $checks->rejected($desk->allocate($ledger, "ALLOC-RUN", $drivers), "allocation.run-duplicate", "allocation duplicate run");
    $checks->expect($ledger->trial_balance()->is_balanced(), "allocation balanced postings");
}

function check_expanded_workflows(WorkloadChecks $checks): void {
    check_credit_workflow($checks);
    check_procurement_workflow($checks);
    check_expense_workflow($checks);
    check_payroll_workflow($checks);
    check_treasury_workflow($checks);
    check_project_workflow($checks);
    check_warehouse_workflow($checks);
    check_allocation_workflow($checks);
}
