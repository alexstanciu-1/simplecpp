function check_bank_flow(WorkloadChecks $checks): void {
    $ledger GeneralLedger = setup_accounting_ledger($checks);
    fund_company($ledger, $checks, 10000);
    $capital_line BankStatementLine = new BankStatementLine();
    $capital_line->reference = "STMT-CAPITAL";
    $capital_line->description = "Owner transfer";
    $capital_line->day = 1;
    $capital_line->amount = 10000;
    $fee_line BankStatementLine = new BankStatementLine();
    $fee_line->reference = "STMT-FEE";
    $fee_line->description = "Account maintenance fee";
    $fee_line->day = 10;
    $fee_line->amount = -150;
    $interest_line BankStatementLine = new BankStatementLine();
    $interest_line->reference = "STMT-INTEREST";
    $interest_line->description = "Deposit interest";
    $interest_line->day = 20;
    $interest_line->amount = 25;
    $lines vector<BankStatementLine> = [$capital_line, $fee_line, $interest_line];
    $reconciliation BankReconciliation = new BankReconciliation();
    $checks->rejected($reconciliation->import_statement(0, 9876, 0, 30, $lines), "statement.control", "statement control total checked");
    $checks->accepted($reconciliation->import_statement(0, 9875, 0, 30, $lines), "corrected statement imported after rejection");
    $fee_line->amount = -999;
    $initial BankReconciliationReport = $reconciliation->report($ledger);
    $checks->equal($initial->statement_movement, 9875, "statement owns copied input lines");
    $checks->equal($initial->unmatched_count, 3, "statement starts unmatched");
    $checks->equal($initial->difference, 125, "unposted bank adjustments visible");
    $checks->rejected($reconciliation->match_entry($ledger, "STMT-FEE", "opening-capital"), "statement.amount-mismatch", "matching checks signed amount");
    $checks->accepted($reconciliation->match_entry($ledger, "STMT-CAPITAL", "opening-capital"), "capital matched");
    $checks->rejected($reconciliation->match_entry($ledger, "STMT-CAPITAL", "opening-capital"), "statement.duplicate-match", "duplicate match rejected");
    $checks->rejected($reconciliation->finalize($ledger), "statement.incomplete", "unmatched statement cannot finalize");
    $checks->accepted($reconciliation->unmatch("STMT-CAPITAL"), "match can be corrected");
    $checks->accepted($reconciliation->match_entry($ledger, "STMT-CAPITAL", "opening-capital"), "unmatched journal becomes available");
    $checks->rejected($reconciliation->post_adjustment($ledger, "STMT-FEE", "interest-income"), "statement.adjustment-sign", "negative interest adjustment rejected");
    $checks->accepted($reconciliation->post_adjustment($ledger, "STMT-FEE", "bank-fees"), "bank fee posted and matched");
    $checks->accepted($reconciliation->post_adjustment($ledger, "STMT-INTEREST", "interest-income"), "bank interest posted and matched");
    $report BankReconciliationReport = $reconciliation->report($ledger);
    $checks->expect($report->complete, "all bank lines reconcile");
    $checks->equal($report->ledger_closing, 9875, "bank ending balance");
    $checks->equal($ledger->balance_of("bank-fees"), 150, "bank fee expense");
    $checks->equal($ledger->balance_of("interest-income"), -25, "bank interest revenue");
    $checks->accepted($reconciliation->finalize($ledger), "bank reconciliation finalized");
    $checks->rejected($reconciliation->unmatch("STMT-FEE"), "statement.state", "finalized statement cannot change");
}

function check_adjustment_flow(WorkloadChecks $checks): void {
    $ledger GeneralLedger = setup_accounting_ledger($checks);
    fund_company($ledger, $checks, 10000);
    $adjustments AdjustmentBook = new AdjustmentBook();
    $checks->accepted($adjustments->prepay($ledger, "INSURANCE", "operating-expense", 1000, 3), "insurance prepaid over three periods");
    $checks->equal($adjustments->prepayment_balance(), 1000, "prepaid original balance");
    $checks->rejected($adjustments->ready_to_close($ledger), "close.prepayment-pending", "close requires scheduled release");
    $checks->accepted($adjustments->release_prepayment($ledger, "INSURANCE"), "first prepayment release");
    $checks->equal($adjustments->prepayment_balance(), 666, "first release takes residual minor unit");
    $checks->rejected($adjustments->release_prepayment($ledger, "INSURANCE"), "prepayment.released", "duplicate release rejected");
    $checks->accepted($adjustments->accrue($ledger, "UTILITIES", "operating-expense", 450), "utilities accrued");
    $checks->equal($adjustments->accrual_balance(), 450, "accrual control balance");
    $checks->rejected($adjustments->reverse_accrual($ledger, "UTILITIES"), "accrual.period", "same-period automatic reversal rejected");
    $checks->accepted($adjustments->ready_to_close($ledger), "first period adjustments complete");
    $checks->accepted($ledger->close_period(1), "close first adjustment period");
    $checks->accepted($adjustments->release_prepayment($ledger, "INSURANCE"), "second prepayment release");
    $checks->rejected($adjustments->ready_to_close($ledger), "close.accrual-pending", "prior accrual must reverse");
    $checks->accepted($adjustments->reverse_accrual($ledger, "UTILITIES"), "accrual reversed next period");
    $checks->rejected($adjustments->reverse_accrual($ledger, "UTILITIES"), "accrual.reversed", "accrual reverses once");
    $checks->equal($adjustments->accrual_balance(), 0, "accrual control clears");
    $checks->equal($ledger->turnover("operating-expense", 2, 2), -117, "period two release less reversed accrual");
    $checks->accepted($adjustments->ready_to_close($ledger), "second period adjustments complete");
    $checks->accepted($ledger->close_period(2), "close second adjustment period");
    $checks->accepted($adjustments->release_prepayment($ledger, "INSURANCE"), "final prepayment release");
    $checks->equal($adjustments->prepayment_balance(), 0, "prepayment exhausts exactly");
    $checks->equal($ledger->balance_of("operating-expense"), 1000, "total expense equals original prepaid amount");
    $checks->accepted($adjustments->reconcile($ledger), "adjustment subledgers reconcile");
}

function check_integrated_company(WorkloadChecks $checks): void {
    $ledger GeneralLedger = setup_accounting_ledger($checks);
    fund_company($ledger, $checks, 200000);
    $inventory InventoryBook = new InventoryBook();
    $purchases PurchasingBook = new PurchasingBook();
    $sales SalesService = new SalesService();
    $assets AssetRegister = new AssetRegister();
    $adjustments AdjustmentBook = new AdjustmentBook();
    $checks->accepted($inventory->register_item("WIDGET", "Fictional traded widget"), "integrated SKU");
    $checks->accepted($purchases->register_supplier("TRADE", "Fictional trade supplier", 100000), "integrated supplier");
    $checks->accepted($inventory->receive($ledger, "WAREHOUSE-001", "WIDGET", 100, 200), "integrated warehouse receipt");
    $bill SupplierBill = new SupplierBill();
    $bill->supplier_code = "TRADE";
    $bill->number = "SUPPLIER-001";
    $bill->charge_kind = PurchaseChargeKind::ReceivedGoods;
    $bill->net_amount = 20000;
    $bill->tax_amount = 4000;
    $bill->due_day = 30;
    $checks->accepted($purchases->record_bill($ledger, $bill), "integrated received-goods invoice");
    $checks->equal($ledger->balance_of("goods-received"), 0, "invoice clears goods-received accrual");
    $shipment StockIssueResult = $inventory->issue($ledger, "DELIVERY-001", "WIDGET", 60);
    $checks->expect($shipment->accepted, "integrated customer delivery");
    $invoice SalesInvoice = new SalesInvoice();
    $invoice->number = "CUSTOMER-001";
    $invoice->net_amount = 30000;
    $invoice->tax_amount = 6000;
    $checks->accepted($sales->issue($ledger, $invoice), "integrated sales invoice");
    $checks->accepted($sales->receive($ledger, $invoice, "CUSTOMER-PAY-001", 18000), "integrated customer partial payment");
    $bill_key string = $purchases->bill_key("TRADE", "SUPPLIER-001");
    $checks->accepted($purchases->pay($ledger, $bill_key, "TRADE-PAY-001", 24000), "integrated supplier settlement");
    $policy StraightLineDepreciation = new StraightLineDepreciation();
    $checks->accepted($assets->acquire($ledger, "DESK", "Office equipment", 12000, 0, 12, $policy), "integrated fixed asset");
    $checks->accepted($assets->depreciate($ledger, "DESK"), "integrated depreciation");
    $checks->accepted($adjustments->prepay($ledger, "RENT", "operating-expense", 6000, 3), "integrated prepaid rent");
    $checks->accepted($adjustments->release_prepayment($ledger, "RENT"), "integrated rent release");
    $checks->accepted($adjustments->accrue($ledger, "POWER", "operating-expense", 500), "integrated utilities accrual");
    $checks->accepted($sales->reconcile($ledger), "integrated receivables control");
    $checks->accepted($purchases->reconcile($ledger), "integrated payables control");
    $checks->accepted($inventory->reconcile($ledger), "integrated inventory control");
    $checks->accepted($assets->reconcile($ledger), "integrated fixed assets control");
    $checks->accepted($adjustments->ready_to_close($ledger), "integrated adjustments ready to close");
    $reports FinancialReports = new FinancialReports();
    $income ProfitAndLoss = $reports->profit_and_loss($ledger);
    $checks->equal($income->revenue, 30000, "integrated revenue");
    $checks->equal($income->expenses, 15500, "integrated cost of sales and period expenses");
    $checks->equal($income->profit, 14500, "integrated profit");
    $position FinancialPosition = $reports->financial_position($ledger);
    $checks->equal($position->assets, 221000, "integrated assets");
    $checks->equal($position->liabilities, 6500, "integrated liabilities");
    $checks->equal($position->equity, 200000, "integrated contributed equity");
    $checks->expect($position->balances(), "integrated accounting equation");
    $trial TrialBalance = $ledger->trial_balance();
    $checks->expect($trial->is_balanced(), "integrated trial balance");
    $checks->accepted($ledger->close_period(1), "integrated first period closed");
    $checks->accepted($sales->receive($ledger, $invoice, "CUSTOMER-PAY-002", 18000), "integrated next-period collection");
    $checks->accepted($adjustments->release_prepayment($ledger, "RENT"), "integrated next-period rent");
    $checks->accepted($adjustments->reverse_accrual($ledger, "POWER"), "integrated next-period accrual reversal");
    $checks->accepted($assets->depreciate($ledger, "DESK"), "integrated next-period depreciation");
    $checks->equal($sales->total_outstanding(), 0, "integrated customer fully settled");
    $checks->equal($ledger->balance_of("bank"), 194000, "integrated ending cash");
    $checks->equal($ledger->turnover("operating-expense", 2, 2), 1500, "integrated second-period expense");
    $second FinancialPosition = $reports->financial_position($ledger);
    $checks->expect($second->balances(), "integrated second-period accounting equation");
}
