namespace Bench::Batch43 {
const int EXTRA = 1;
int line_0(int price, int quantity = 3) {
    int subtotal = price * 346 + quantity;
    int index = 0;
    while (index < quantity) {
        subtotal = subtotal + index;
        index = index + 1;
    }
    if (subtotal % 2 == 0) {
        subtotal = subtotal / 2;
    } else if (subtotal > 100) {
        subtotal = subtotal - 7;
    } else {
        subtotal = subtotal + 5;
    }
    do { subtotal = subtotal + 1; } while (false);
    int ticks = 0;
    for (int loop = 0; loop < quantity; loop++) {
        if (loop == 1) { continue; }
        if (loop > 2) { break; }
        ++ticks;
    }
    if (!(ticks == 2) || !(quantity > 0 && price > 0)) { return 0; }
    subtotal += (int) (byte) 2;
    subtotal -= 1;
    subtotal *= 2;
    subtotal /= 2;
    subtotal %= 1000000;
    --subtotal;
    for (index = 0; index < 1; index += 1) { subtotal += EXTRA; }
    return subtotal;
}
