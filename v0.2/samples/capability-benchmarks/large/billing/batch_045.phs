namespace Bench\Batch45;
function line_0(int $price, int $quantity = 3): int {
    $subtotal int = $price * 362 + $quantity;
    $index int = 0;
    while ($index < $quantity) {
        $subtotal = $subtotal + $index;
        $index = $index + 1;
    }
    if ($subtotal % 2 == 0) {
        $subtotal = $subtotal / 2;
    } else if ($subtotal > 100) {
        $subtotal = $subtotal - 7;
    } else {
        $subtotal = $subtotal + 5;
    }
    do { $subtotal = $subtotal + 1; } while (false);
    return $subtotal;
}
