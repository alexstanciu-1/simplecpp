namespace App;
use function Bench\{adjust, announce, feature_score};
use function Bench\label as heading;
use const Bench\{BONUS as extra, EMPTY};
$price int = \Bench\$seed;
adjust($price);
$total = feature_score();
$total += extra;
echo EMPTY;
announce(heading());
echo ": ";
$total = $total + \Bench\Batch0\line_0($price);
$total = $total + \Bench\Batch0\line_1($price, 4);
$total = $total + \Bench\Batch0\line_2($price);
$total = $total + \Bench\Batch0\line_3($price, 4);
$total = $total + \Bench\Batch1\line_0($price);
$total = $total + \Bench\Batch1\line_1($price, 4);
$total = $total + \Bench\Batch1\line_2($price);
$total = $total + \Bench\Batch1\line_3($price, 4);
$total = $total + \Bench\Batch2\line_0($price);
$total = $total + \Bench\Batch2\line_1($price, 4);
$total = $total + \Bench\Batch2\line_2($price);
$total = $total + \Bench\Batch2\line_3($price, 4);
$total = $total + \Bench\Batch3\line_0($price);
$total = $total + \Bench\Batch3\line_1($price, 4);
$total = $total + \Bench\Batch3\line_2($price);
$total = $total + \Bench\Batch3\line_3($price, 4);
$total = $total + \Bench\Batch4\line_0($price);
$total = $total + \Bench\Batch4\line_1($price, 4);
$total = $total + \Bench\Batch4\line_2($price);
$total = $total + \Bench\Batch4\line_3($price, 4);
$total = $total + \Bench\Batch5\line_0($price);
$total = $total + \Bench\Batch5\line_1($price, 4);
$total = $total + \Bench\Batch5\line_2($price);
$total = $total + \Bench\Batch5\line_3($price, 4);
$total = $total + \Bench\Batch6\line_0($price);
$total = $total + \Bench\Batch6\line_1($price, 4);
$total = $total + \Bench\Batch6\line_2($price);
$total = $total + \Bench\Batch6\line_3($price, 4);
$total = $total + \Bench\Batch7\line_0($price);
$total = $total + \Bench\Batch7\line_1($price, 4);
$total = $total + \Bench\Batch7\line_2($price);
$total = $total + \Bench\Batch7\line_3($price, 4);
$total = $total + \Bench\Batch8\line_0($price);
$total = $total + \Bench\Batch8\line_1($price, 4);
$total = $total + \Bench\Batch8\line_2($price);
$total = $total + \Bench\Batch8\line_3($price, 4);
$total = $total + \Bench\Batch9\line_0($price);
$total = $total + \Bench\Batch9\line_1($price, 4);
$total = $total + \Bench\Batch9\line_2($price);
$total = $total + \Bench\Batch9\line_3($price, 4);
$total = $total + \Bench\Batch10\line_0($price);
$total = $total + \Bench\Batch10\line_1($price, 4);
$total = $total + \Bench\Batch10\line_2($price);
$total = $total + \Bench\Batch10\line_3($price, 4);
$total = $total + \Bench\Batch11\line_0($price);
$total = $total + \Bench\Batch11\line_1($price, 4);
$total = $total + \Bench\Batch11\line_2($price);
$total = $total + \Bench\Batch11\line_3($price, 4);
echo $total;
\Bench\finish();
return 8;
