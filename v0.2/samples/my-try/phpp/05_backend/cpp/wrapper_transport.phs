namespace scpp\compiler;

/** Physical wrapper adaptation; registry identities and runtime state rules remain authoritative. */
final class CPP_Wrapper_Transport {
	public static function is_string_vector(canonical_type_use $type): bool {
		$canonical = Type_Queries::canonical($type);
		if (!($canonical instanceof applied_template_type)
			|| ($canonical->definition() !== Model::$type_catalog->definition('vector'))) { return false; }
		$application = object_cast($canonical, applied_template_type::class);
		$arguments vector<canonical_type_use> = $application->arguments();
		return $arguments[0]->matches(Language_Types::string_type(Model::$language_scope));
	}

	/** Provider vectors keep native strings/handles; application vectors store concrete elements. */
	public static function provider_vector(canonical_type_use $type, string $expression, bool $compose, CPP_Specializations $engine, cpp_generation_context $context): string {
		$canonical = Type_Queries::canonical($type);
		if (!($canonical instanceof applied_template_type)
			|| ($canonical->definition() !== Model::$type_catalog->definition('vector'))) { return $expression; }
		$application = object_cast($canonical, applied_template_type::class);
		$arguments vector<canonical_type_use> = $application->arguments();
		$element = $arguments[0];
		if (!$element->matches(Language_Types::string_type(Model::$language_scope)) && !Type_Queries::is_nominal_handle($element)
			&& (Type_Queries::nullable_handle_payload($element) === null)) {
			throw new \scpp_portability_runtime_exception('prelower_templates: provider vector transport requires string or shared-record elements');
		}
		$target = $compose ? CPP_Types::implementation_representation($type, $engine) : CPP_Types::representation($type);
		CPP_Types::record_dependencies($target, $context);
		$value = self::payload_value($element, 'vector_source.at(vector_index)', $compose, $engine, $context);
		return '([](const auto& vector_source) -> ' . $target->spelling . ' { ' . $target->spelling
			. ' vector_result; for (std::size_t vector_index = 0; vector_index < vector_source.size(); ++vector_index) { '
			. 'vector_result.append(' . $value . '); } return vector_result; }(' . $expression . '))';
	}
	/** Fully native providers cross the same representation boundary recursively. */
	public static function provider_value(canonical_type_use $type, string $expression, bool $compose, CPP_Specializations $engine, cpp_generation_context $context): string {
		$canonical = Type_Queries::canonical($type);
		if (!($canonical instanceof applied_template_type)) { return $expression; }
		$application = object_cast($canonical, applied_template_type::class);
		$definition = $canonical->definition();
		$target = $compose ? CPP_Types::implementation_representation($type, $engine) : CPP_Types::representation($type);
		CPP_Types::record_dependencies($target, $context);
		$arguments vector<canonical_type_use> = $application->arguments();
		$body = '';
		if ($definition === Model::$type_catalog->definition('vector')) {
			$value = self::provider_payload($arguments[0], 'provider_source.at(provider_index)', $compose, $engine, $context);
			$body = $target->spelling . ' provider_result; for (std::size_t provider_index = 0; provider_index < provider_source.size(); ++provider_index) { provider_result.append(' . $value . '); } return provider_result;';
		}
		elseif ($definition === Model::$type_catalog->definition('hash')) {
			$value = self::provider_payload($arguments[0], 'provider_entry.value_copy()', $compose, $engine, $context);
			$key = self::provider_payload($arguments[1], 'provider_entry.key()', $compose, $engine, $context);
			$body = $target->spelling . ' provider_result; for (auto provider_it = provider_source.begin_entries(); provider_it != provider_source.end_entries(); ++provider_it) { const auto provider_entry = *provider_it; provider_result.set(' . $key . ', ' . $value . '); } return provider_result;';
		}
		else {
			$payload = self::payload($type);
			if ($payload === null) { return $expression; }
			$value = self::provider_payload($payload, 'provider_source.require_value("provider transport")', $compose, $engine, $context);
			$body = 'if (provider_source.has_value().native_value()) { return ' . $target->spelling . '(' . $value . '); } ';
			if ($definition instanceof nullable_type_definition) { $body .= 'return ' . $target->spelling . '(scpp::null);'; }
			else {
				$family = object_cast($definition, result_type_definition::class)->result_family();
				if ($family === result_kind::structured_error) { $body .= 'return ' . $target->spelling . '(provider_source.require_error("provider transport"));'; }
				else {
					if ($family === result_kind::boolean_sentinels) { $body .= 'if (provider_source.is_true().native_value()) { return ' . $target->spelling . '(scpp::true_sentinel); } '; }
					$body .= 'return ' . $target->spelling . '(scpp::false_sentinel);';
				}
			}
		}
		return '([](const auto& provider_source) -> ' . $target->spelling . ' { ' . $body . ' }(' . $expression . '))';
	}

	/** Bridge one stored application value, including nested container/wrapper payloads. */
	public static function provider_payload(canonical_type_use $type, string $expression, bool $compose, CPP_Specializations $engine, cpp_generation_context $context): string {
		$mapping = CPP_Types::representation($type, new cpp_generation_context($engine));
		$implementation = CPP_Types::implementation_representation($type, $engine);
		CPP_Types::record_dependencies($mapping, $context);
		CPP_Types::record_dependencies($implementation, $context);
		if (!$mapping->opaque) { return self::provider_value($type, $expression, $compose, $engine, $context); }
		$context->headers['memory'] = true;
		$context->headers['new'] = true;
		if (!$compose) {
			$value = '*std::launder(static_cast<const ' . $implementation->spelling . '*>((' . $expression . ').address()))';
			return self::provider_value($type, $value, false, $engine, $context);
		}
		$value = self::provider_value($type, $expression, true, $engine, $context);
		return '([](const auto& provider_value) -> ' . $mapping->spelling . ' { return '
			. $mapping->spelling . '(' . $mapping->spelling . '::operation_result{}, +[](void* destination, const void* input) { '
			. '::new(destination) ' . $implementation->spelling . '(*static_cast<const ' . $implementation->spelling
			. '*>(input)); }, &provider_value); }(' . $value . '))';
	}

	public static function payload(canonical_type_use $type): nullable<canonical_type_use> {
		// Semantic optionality need not introduce a physical payload wrapper.
		if (Type_Queries::nullable_handle_payload($type) !== null) { return null; }
		$canonical = Type_Queries::canonical($type);
		if (!($canonical instanceof applied_template_type)) { return null; }
		$application = object_cast($canonical, applied_template_type::class);
		$definition = $canonical->definition();
		if ($definition instanceof nullable_type_definition) {
			return object_cast($definition, nullable_type_definition::class)->payload_type($application);
		}
		if ($definition instanceof result_type_definition) {
			return object_cast($definition, result_type_definition::class)->payload_type($application);
		}
		return null;
	}

	/** Convert a provider's native outer wrapper to/from its composed stored payloads. */
	public static function adapt(canonical_type_use $type, string $expression, bool $compose, CPP_Specializations $engine, cpp_generation_context $context): string {
		$payload = self::payload($type);
		if ($payload === null) { return self::payload_value($type, $expression, $compose, $engine, $context); }
		$target = $compose ? CPP_Types::implementation_representation($type, $engine) : CPP_Types::representation($type);
		CPP_Types::record_dependencies($target, $context);
		$value = self::payload_value($payload, 'wrapper_source.require_value("wrapper transport")', $compose, $engine, $context);
		$body = 'if (wrapper_source.has_value().native_value()) { return ' . $target->spelling . '(' . $value . '); } ';
		$definition = Type_Queries::canonical($type)->definition();
		if ($definition instanceof nullable_type_definition) {
			$body .= 'return ' . $target->spelling . '(scpp::null);';
		}
		else {
			$family = object_cast($definition, result_type_definition::class)->result_family();
			if ($family === result_kind::structured_error) {
				$body .= 'return ' . $target->spelling . '(wrapper_source.require_error("wrapper transport"));';
			}
			else {
				if ($family === result_kind::boolean_sentinels) {
					$body .= 'if (wrapper_source.is_true().native_value()) { return ' . $target->spelling . '(scpp::true_sentinel); } ';
				}
				$body .= 'return ' . $target->spelling . '(scpp::false_sentinel);';
			}
		}
		return '([](const auto& wrapper_source) -> ' . $target->spelling . ' { ' . $body . ' }(' . $expression . '))';
	}

	/** A composed payload is an application object; its bytes hold the native implementation. */
	public static function payload_value(canonical_type_use $type, string $expression, bool $compose, CPP_Specializations $engine, cpp_generation_context $context): string {
		$mapping = CPP_Types::representation($type, new cpp_generation_context($engine));
		CPP_Types::record_dependencies($mapping, $context);
		if (!$mapping->opaque) { return $expression; }
		$native = CPP_Types::implementation_representation($type, $engine);
		CPP_Types::record_dependencies($native, $context);
		$context->headers['memory'] = true;
		$context->headers['new'] = true;
		if (!$compose) {
			$value = '*std::launder(static_cast<const ' . $native->spelling . '*>((' . $expression . ').address()))';
			return self::payload($type) === null ? $value : self::adapt($type, $value, false, $engine, $context);
		}
		$value = self::payload($type) === null ? $expression : self::adapt($type, $expression, true, $engine, $context);
		return '([](const auto& transport_value) -> ' . $mapping->spelling . ' { return '
			. $mapping->spelling . '(' . $mapping->spelling . '::operation_result{}, +[](void* destination, const void* input) { '
			. '::new(destination) ' . $native->spelling . '(*static_cast<const ' . $native->spelling
			. '*>(input)); }, &transport_value); }(' . $value . '))';
	}
}
