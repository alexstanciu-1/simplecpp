
/* Checked access and type tests share one operand and a literal target type. */
namespace scpp\compiler;

enum object_type_operation {
	case checked_cast;
	case type_test;
}

final class object_type_node extends expression_node {
	
	/** Common access preserves the property-free base while spans remain concrete data. */
	public function set_span(int $first, int $end): void {
		if (($first < 0) || ($end < $first) || ($end > 4294967295)) {
			throw new \scpp_portability_logic_exception('AST token span exceeds uint32 bounds');
		}
		$this->first_token_index = $first;
		$this->end_token_index = $end;
	}

	public function start_token(): int {
		return (int)$this->first_token_index;
	}

	public function end_token(): int {
		return (int)$this->end_token_index;
	}

	/** Inclusive start in the owning token snapshot. */
	public $first_token_index uint32;
	/** Exclusive end: token count is end - first, including zero for an empty span. */
	public $end_token_index uint32;

	
	public function preparation(): nullable<prepared_object_type> {
		return $this->prepared_facts;
	}

	public function set_preparation(prepared_object_type $facts): void {
		$this->prepared_facts = $facts;
	}

	public function clear_preparation(): void {
		$this->prepared_facts = null;
	}


	public object_type_operation $operation = object_type_operation::checked_cast;
	public expression_node $operand;
	public type_node $target_type;
	private $prepared_facts nullable<prepared_object_type> = null;

	public function kind(): node_kind { return node_kind::object_type; }
	public function require_preparation(): prepared_expression { return $this->prepared_facts; }
	public function require_object_type_preparation(): prepared_object_type { return $this->prepared_facts; }

	public function maintain(node_maintenance_worker_i $worker): void {
		$worker->enter($this);
		$worker->edge($this, $this->operand);
		$worker->edge($this, $this->target_type);
	}

	public function children(): child_iterator_i { return new object_type_children_iterator($this); }
}

final class object_type_children_iterator extends children_iterator {
	private int $position = 0;
	private object_type_node $source;public function __construct(set:$source) {}
	protected function read_next(): nullable<ast_node> {
		$this->position++;
		if ($this->position === 1) { return $this->source->operand; }
		if ($this->position === 2) { return $this->source->target_type; }
		return null;
	}
}
