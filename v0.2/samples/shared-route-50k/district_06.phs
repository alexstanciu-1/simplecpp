function leg_050(shared<Route> $route, int $load): int {
    $position = $route->position;
    $east = ($load + 5) % 9;
    $north = ($load + 18) % 5;
    $position->east = $position->east + $east;
    $position->north = $position->north + $north;
    $route->position = $position;
    $length = $east + $north;
    $route->distance = $route->distance + $length;
    if ($length > 6) {
        $route->toll = $route->toll + 3;
    }
    $route->stops = $route->stops + 1;
    return ($load + $length + 5) % 97;
}

